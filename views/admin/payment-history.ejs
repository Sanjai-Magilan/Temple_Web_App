<%- include('../partials/header') %>
<%- include('../partials/navbar', { user: typeof user !== 'undefined' ? user : null }) %>

<div class="container py-4">

    <!-- PAGE TITLE -->
    <div class="mb-4">
        <h2 class="fw-bold">Payment History</h2>
    </div>

    <!-- SEARCH BAR -->
    <div class="card shadow-sm border-0 mb-4" style="border-radius:15px;">
        <div class="card-body p-4 bg-white">

            <form method="GET" action="/admin/payments" class="row g-3 align-items-center">

                <div class="col-md-10">

                    <div class="input-group input-group-lg">

                        <!-- Search Icon -->
                        <span class="input-group-text bg-transparent border-end-0">
                            <i class="bi bi-search text-muted"></i>
                        </span>

                        <!-- Search Input -->
                        <input type="text"
                            name="search"
                            class="form-control border-start-0 border-end-0 shadow-none"
                            placeholder="Search by Payment ID, User Name, Email..."
                            value="<%= search || '' %>">

                        <a href="?"
                        class="input-group-text bg-transparent border-start-0 text-decoration-none <%= search || filter || method || payment_type? '' : 'd-none' %>">

                            <i class="bi bi-x-circle-fill text-danger"></i>

                        </a>

                        <!-- Filter Icon Dropdown -->
                        <div class="input-group-text bg-transparent border-start-0 p-0">

                            <div class="dropdown">

                                <button class="btn btn-link text-decoration-none text-muted p-2"
                                        type="button"
                                        data-bs-toggle="dropdown">

                                    <i class="bi bi-funnel<%= filter ? '-fill text-primary' : '' %>"></i>

                                </button>

                                <ul class="dropdown-menu dropdown-menu-end">

                                    <li>
                                        <a class="dropdown-item <%= filter==='recent'?'active':'' %>"
                                        href="?search=<%= search || '' %>&filter=recent">
                                        Recent Payments
                                        </a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item <%= filter==='high'?'active':'' %>"
                                        href="?search=<%= search || '' %>&filter=high">
                                        Higher Amounts
                                        </a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item <%= filter==='low'?'active':'' %>"
                                        href="?search=<%= search || '' %>&filter=low">
                                        Lower Amounts
                                        </a>
                                    </li>

                                </ul>

                            </div>

                        </div>

                    </div>

                </div>

                <!-- Search Button -->
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100 btn-lg">
                        Search
                    </button>
                </div>

            </form>

        </div>
    </div>




    <% if (payments && payments.length > 0) { %>

        <!-- TABLE CARD -->
        <div class="card shadow-sm">
            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">
                        <tr>

                            <th class="text-decoration-none text-dark fw-semibold" >
                                 Payment ID
                            </th>
                            <th class="text-decoration-none text-dark fw-semibold">
                                 User
                            </th>
                            <th class="text-decoration-none text-dark fw-semibold">
                                 Amount
                            </th>
                            <th class="fw-semibold">

                                <div class="dropdown">

                                    <button class="btn btn-link text-dark text-decoration-none p-0 fw-semibold"
                                            type="button"
                                            data-bs-toggle="dropdown">

                                        Payment Type
                                        <i class="bi bi-chevron-down small"></i>

                                    </button>

                                    <ul class="dropdown-menu">

                                        <!-- ALL -->
                                        <li>
                                            <a class="dropdown-item <%= !method ? 'active' : '' %>"
                                            href="?search=<%= search || '' %>&filter=<%= filter || '' %>&method=<%= method || '' %>">
                                                All
                                            </a>
                                        </li>

                                        <!-- Donations -->
                                        <li>
                                            <a class="dropdown-item <%= method==='upi' ? 'active' : '' %>"
                                            href="?search=<%= search || '' %>&filter=<%= filter || '' %>&method=<%= method || '' %>&payment_type=donation">
                                                Donations
                                            </a>
                                        </li>

                                        <!-- Hall Booking -->
                                        <li>
                                            <a class="dropdown-item <%= method==='card' ? 'active' : '' %>"
                                            href="?search=<%= search || '' %>&filter=<%= filter || '' %>&method=<%= method || '' %>&payment_type=hall_booking">
                                                Hall Booking
                                            </a>
                                        </li>

                                        <!-- Pooja Booking -->
                                        <li>
                                            <a class="dropdown-item <%= method==='netbanking' ? 'active' : '' %>"
                                            href="?search=<%= search || '' %>&filter=<%= filter || '' %>&method=<%= method || '' %>&payment_type=pooja_booking">
                                                Pooja Booking
                                            </a>
                                        </li>

                                    </ul>

                                </div>

                            </th>
                            <th class="text-decoration-none text-dark fw-semibold">
                                Booking Date
                            </th>
                            <th class="text-decoration-none text-dark fw-semibold">Status</th>
                            <th class="fw-semibold">

                                <div class="dropdown">

                                    <button class="btn btn-link text-dark text-decoration-none p-0 fw-semibold"
                                            type="button"
                                            data-bs-toggle="dropdown">

                                        Method
                                        <i class="bi bi-chevron-down small"></i>

                                    </button>

                                    <ul class="dropdown-menu">

                                        <!-- ALL -->
                                        <li>
                                            <a class="dropdown-item <%= !method ? 'active' : '' %>"
                                            href="?search=<%= search || '' %>&filter=<%= filter || '' %>">
                                                All Methods
                                            </a>
                                        </li>

                                        <!-- UPI -->
                                        <li>
                                            <a class="dropdown-item <%= method==='upi' ? 'active' : '' %>"
                                            href="?search=<%= search || '' %>&filter=<%= filter || '' %>&payment_type=<%= payment_type || '' %>&method=upi">
                                                UPI
                                            </a>
                                        </li>

                                        <!-- CARD -->
                                        <li>
                                            <a class="dropdown-item <%= method==='card' ? 'active' : '' %>"
                                            href="?search=<%= search || '' %>&filter=<%= filter || '' %>&payment_type=<%= payment_type || '' %>&method=card">
                                                Card
                                            </a>
                                        </li>

                                        <!-- NETBANKING -->
                                        <li>
                                            <a class="dropdown-item <%= method==='netbanking' ? 'active' : '' %>"
                                            href="?search=<%= search || '' %>&filter=<%= filter || '' %>&payment_type=<%= payment_type || '' %>&method=netbanking">
                                                Netbanking
                                            </a>
                                        </li>

                                    </ul>

                                </div>

                            </th>

                            <th class="text-decoration-none text-dark fw-semibold">                   
                                 Date & Time
                            </th>
                            <th></th>

                        </tr>
                    </thead>

                    <tbody>

                        <% payments.forEach(payment => { %>
                            <tr>
                                <td><%= payment.payment_id %></td>
                                <td>

                                    <!-- USER NAME -->
                                    <div class="fw-bold">
                                        <%= payment.first_name + " " + payment.last_name %>
                                    </div>

                                    <!-- USER ID -->
                                    <div class="text-muted small">
                                        User ID: <%= payment.user_id %>
                                    </div>

                                    <!-- EMAIL -->
                                    <div class="text-muted small">
                                        <%= payment.user_email || '-' %>
                                    </div>

                                </td>

                                <td>₹ <%= payment.amount %></td>
                                <td><%= payment.payment_type %></td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <i class="bi bi-calendar3"></i>
                                        <span><%= payment.formatted_booking_date %></span>
                                    </div>

                                    <div class="d-flex align-items-center gap-2 text-muted small">
                                        <i class="bi bi-clock"></i>
                                        <span><%= payment.formatted_booking_time %></span>
                                    </div>
                                </td>

                                <!-- STATUS BADGE -->
                                <td>
                                    <% if(payment.status === 'completed'){ %>
                                        <span class="badge bg-success">Completed</span>
                                    <% } else if(payment.status === 'pending'){ %>
                                        <span class="badge bg-warning text-dark">Pending</span>
                                    <% } else { %>
                                        <span class="badge bg-danger"> - </span>
                                    <% } %>
                                </td>

                                <td><%= payment.payment_method %></td>
                                <td>
                                    <% if(payment.formatted_date || payment.formatted_time) {}
                                    <div class="d-flex align-items-center gap-2">
                                        <i class="bi bi-calendar3"></i>
                                        <span><%= payment.formatted_date %></span>
                                    </div>

                                    <div class="d-flex align-items-center gap-2 text-muted small">
                                        <i class="bi bi-clock"></i>
                                        <span><%= payment.formatted_time %></span>
                                    </div>
                                </td>
                                <% if(payment.status !== 'pending'){ %>
                                    <td class="text-center">

                                        <a href="/admin/payments/<%= payment.payment_id %>/receipt"
                                        class="btn btn-sm btn-outline-primary"
                                        title="Download Receipt">

                                            <i class="bi bi-download"></i>

                                        </a>
                                        
                                    </td>
                                <% } %>
                            </tr>
                        <% }) %>

                    </tbody>

                </table>

            </div>
        </div>

        <% if(totalPages > 1){ %>

        <nav class="mt-4">
            <ul class="pagination justify-content-center">

                <!-- Previous -->
                <li class="page-item <%= currentPage === 1 ? 'disabled' : '' %>">
                    <a class="page-link"
                    href="?search=<%= search || '' %>&filter=<%= filter || '' %>&method=<%= method || '' %>&payment_type=<%= payment_type || '' %>&page=<%= currentPage-1 %>">
                    Previous
                    </a>
                </li>

                <% for(let i = 1; i <= totalPages; i++){ %>

                    <li class="page-item <%= i === currentPage ? 'active' : '' %>">
                        <a class="page-link"
                        href="?search=<%= search || '' %>&filter=<%= filter || '' %>&method=<%= method || '' %>&payment_type=<%= payment_type || '' %>&page=<%= i %>">
                        <%= i %>
                        </a>
                    </li>

                <% } %>

                <!-- Next -->
                <li class="page-item <%= currentPage === totalPages ? 'disabled' : '' %>">
                    <a class="page-link"
                    href="?search=<%= search || '' %>&filter=<%= filter || '' %>&method=<%= method || '' %>&payment_type=<%= payment_type || '' %>&page=<%= currentPage+1 %>">
                    Next
                    </a>
                </li>

            </ul>
        </nav>

        <% } %>


    <% } else { %>

        <div class="alert alert-warning">
            No payment records found.
        </div>

    <% } %>

</div>

<%- include('../partials/footer') %>
