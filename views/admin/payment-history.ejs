<%- include('../partials/header') %>
<%- include('../partials/navbar', { user: typeof user !== 'undefined' ? user : null }) %>

<div class="container py-4">

    <!-- PAGE TITLE -->
    <div class="mb-4">
        <h2 class="fw-bold">Payment History</h2>
    </div>

    <!-- SEARCH BAR -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">

            <form method="GET" action="/admin/payments" class="row g-2 align-items-center">

                <!-- SEARCH INPUT -->
                <div class="col-md-8">
                    <input 
                        type="text" 
                        name="search"
                        value="<%= search || '' %>"
                        placeholder="Search by Payment ID, User ID, Status..."
                        class="form-control"
                    >
                </div>

                <!-- SEARCH BUTTON -->
                <div class="col-md-2 d-grid">
                    <button type="submit" class="btn btn-primary">
                        Search
                    </button>
                </div>

                <!-- FILTER DROPDOWN -->
                <div class="col-md-2 d-grid">

                    <div class="dropdown">

                        <button class="btn btn-outline-secondary dropdown-toggle w-100"
                                type="button"
                                data-bs-toggle="dropdown">

                            Filter
                        </button>

                        <ul class="dropdown-menu">

                            <li>
                                <a class="dropdown-item"
                                href="?search=<%= search || '' %>&filter=recent">
                                Recent Payments
                                </a>
                            </li>

                            <li>
                                <a class="dropdown-item"
                                href="?search=<%= search || '' %>&filter=completed">
                                Payment Completed
                                </a>
                            </li>

                            <li>
                                <a class="dropdown-item"
                                href="?search=<%= search || '' %>&filter=high">
                                Higher Amounts
                                </a>
                            </li>

                            <li>
                                <a class="dropdown-item"
                                href="?search=<%= search || '' %>&filter=low">
                                Lower Amounts
                                </a>
                            </li>

                        </ul>

                    </div>

                </div>

            </form>

        </div>
    </div>



    <% if (payments && payments.length > 0) { %>

        <!-- TABLE CARD -->
        <div class="card shadow-sm">
            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">
                        <tr>

                            <th>
                              <a class="text-decoration-none text-dark fw-semibold"
                                 href="?search=<%= search || '' %>&sort=payment_id&order=<%= sort==='payment_id' && order==='ASC' ? 'DESC' : 'ASC' %>">
                                 
                                 Payment ID

                    
                              </a>
                            </th>

                            <th>
                              <a class="text-decoration-none text-dark fw-semibold"
                                 href="?search=<%= search || '' %>&sort=user_id&order=<%= sort==='user_id' && order==='ASC' ? 'DESC' : 'ASC' %>">
                                 
                                 User ID

                                 
                              </a>
                            </th>

                            <th>
                              <a class="text-decoration-none text-dark fw-semibold"
                                 href="?search=<%= search || '' %>&sort=amount&order=<%= sort==='amount' && order==='ASC' ? 'DESC' : 'ASC' %>">
                                 
                                 Amount

                                 
                              </a>
                            </th>

                            <th>Status</th>
                            <th>Method</th>

                            <th>
                              <a class="text-decoration-none text-dark fw-semibold"
                                 href="?search=<%= search || '' %>&sort=created_at&order=<%= sort==='created_at' && order==='ASC' ? 'DESC' : 'ASC' %>">
                                 
                                 Date

                                 
                              </a>
                            </th>

                        </tr>
                    </thead>

                    <tbody>

                        <% payments.forEach(payment => { %>
                            <tr>
                                <td><%= payment.payment_id %></td>
                                <td><%= payment.user_id %></td>
                                <td>₹ <%= payment.amount %></td>

                                <!-- STATUS BADGE -->
                                <td>
                                    <% if(payment.status === 'completed'){ %>
                                        <span class="badge bg-success">Completed</span>
                                    <% } else if(payment.status === 'pending'){ %>
                                        <span class="badge bg-warning text-dark">Pending</span>
                                    <% } else { %>
                                        <span class="badge bg-danger">Failed</span>
                                    <% } %>
                                </td>

                                <td><%= payment.payment_method %></td>
                                <td><%= payment.formatted_date %></td>
                            </tr>
                        <% }) %>

                    </tbody>

                </table>

            </div>
        </div>

    <% } else { %>

        <div class="alert alert-warning">
            No payment records found.
        </div>

    <% } %>

</div>

<%- include('../partials/footer') %>
