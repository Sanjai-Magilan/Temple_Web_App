<nav class="mt-4">
    <ul class="pagination justify-content-center">

        <!-- Previous -->
        <li class="page-item <%= currentPage === 1 ? 'disabled' : '' %>">
            <a class="page-link"
            href="?search=<%= search || '' %>&filter=<%= filter || '' %>&method=<%= method || '' %>&payment_type=<%= payment_type || '' %>&page=<%= currentPage-1 %>">
            Previous
            </a>
        </li>

        <%
        const startPage = Math.max(1, currentPage - 3);
        const endPage = Math.min(totalPages, currentPage + 3);
        %>

        <!-- First Page -->
        <li class="page-item <%= currentPage === 1 ? 'active' : '' %>">
            <a class="page-link"
            href="?search=<%= search || '' %>&filter=<%= filter || '' %>&method=<%= method || '' %>&payment_type=<%= payment_type || '' %>&page=1">
            1
            </a>
        </li>

        <% if(startPage > 2){ %>
            <li class="page-item disabled"><span class="page-link">...</span></li>
        <% } %>

        <% for(let i = startPage; i <= endPage; i++){ %>
            <% if(i !== 1 && i !== totalPages){ %>
                <li class="page-item <%= i === currentPage ? 'active' : '' %>">
                    <a class="page-link"
                    href="?search=<%= search || '' %>&filter=<%= filter || '' %>&method=<%= method || '' %>&payment_type=<%= payment_type || '' %>&page=<%= i %>">
                    <%= i %>
                    </a>
                </li>
            <% } %>
        <% } %>

        <% if(endPage < totalPages - 1){ %>
            <li class="page-item disabled"><span class="page-link">...</span></li>
        <% } %>

        <!-- Last Page -->
        <% if(totalPages > 1){ %>
        <li class="page-item <%= currentPage === totalPages ? 'active' : '' %>">
            <a class="page-link"
            href="?search=<%= search || '' %>&filter=<%= filter || '' %>&method=<%= method || '' %>&payment_type=<%= payment_type || '' %>&page=<%= totalPages %>">
            <%= totalPages %>
            </a>
        </li>
        <% } %>

        <!-- UI
        Previous  1 ... 520 521 522 [523] 524 525 526 ... 1200  Next -->

        <!-- Next -->
        <li class="page-item <%= currentPage === totalPages ? 'disabled' : '' %>">
            <a class="page-link"
            href="?search=<%= search || '' %>&filter=<%= filter || '' %>&method=<%= method || '' %>&payment_type=<%= payment_type || '' %>&page=<%= currentPage+1 %>">
            Next
            </a>
        </li>

    </ul>
</nav>