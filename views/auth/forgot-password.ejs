<%- include('../partials/header') %>
<%- include('../partials/navbar', { user: null }) %>

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow">
                <div class="card-body p-4">
                    <div class="text-center mb-4">
                        <i class="bi bi-lock-fill text-primary" style="font-size: 3rem;"></i>
                        <h2 class="card-title mt-3"><%= title %></h2>
                        <p class="text-muted">Enter your email address and we'll generate a password reset link for you.</p>
                    </div>

                    <% if (error) { %>
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>
                            <%= error %>
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    <% } %>

                    <% if (success) { %>
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            <i class="bi bi-check-circle-fill me-2"></i>
                            <%= success %>
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                        
                        <% if (typeof resetLink !== 'undefined' && resetLink) { %>
                            <div class="alert alert-info mt-3">
                                <h6 class="alert-heading">
                                    <i class="bi bi-info-circle-fill me-2"></i>
                                    Reset Link Generated
                                </h6>
                                <p class="mb-2"><%= typeof message !== 'undefined' ? message : '' %></p>
                                <div class="d-grid gap-2 mt-3">
                                    <a href="<%= resetLink %>" class="btn btn-primary">
                                        <i class="bi bi-arrow-right-circle me-2"></i>
                                        Reset Password Now
                                    </a>
                                    <small class="text-muted text-center mt-2">
                                        Or copy this link: <br>
                                        <input type="text" class="form-control form-control-sm mt-1" value="<%= resetLink %>" readonly onclick="this.select()">
                                    </small>
                                </div>
                            </div>
                        <% } %>
                    <% } %>

                    <form method="POST" action="/forgot-password">
                        <div class="mb-3">
                            <label for="email" class="form-label">
                                <i class="bi bi-envelope me-1"></i>
                                Email Address
                            </label>
                            <input 
                                type="email" 
                                class="form-control form-control-lg" 
                                id="email" 
                                name="email" 
                                placeholder="your.email@example.com"
                                value="<%= typeof formData !== 'undefined' && formData.email ? formData.email : '' %>"
                                required
                                autofocus
                            >
                        </div>

                        <div class="d-grid mb-3">
                            <button type="submit" class="btn btn-primary btn-lg">
                                <i class="bi bi-send me-2"></i>
                                Generate Reset Link
                            </button>
                        </div>
                    </form>

                    <div class="text-center mt-4">
                        <hr>
                        <p class="mb-0 text-muted">
                            Remember your password? 
                            <a href="/login" class="text-decoration-none">
                                <i class="bi bi-box-arrow-in-right me-1"></i>
                                Back to Login
                            </a>
                        </p>
                        <p class="mt-2 mb-0 text-muted">
                            Don't have an account? 
                            <a href="/register" class="text-decoration-none">
                                <i class="bi bi-person-plus me-1"></i>
                                Register Now
                            </a>
                        </p>
                    </div>
                </div>
            </div>

            <div class="card mt-3 bg-light">
                <div class="card-body text-center py-2">
                    <small class="text-muted">
                        <i class="bi bi-shield-check me-1"></i>
                        Your security is important to us. Reset links expire in 1 hour.
                    </small>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>
