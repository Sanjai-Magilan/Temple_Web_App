<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Forgot Password - Temple Management</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;700&family=Playfair+Display:wght@400;700&display=swap"
    rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body class="auth-body">
  <div class="auth-wrapper">
    <div class="auth-card">
      <div style="margin-bottom: 2rem;">
        <h1 class="auth-title">Forgot Password</h1>
        <p class="auth-subtitle">Enter your email address and we'll send you an OTP to reset your password.</p>
      </div>

      <% if (error) { %>
        <div class="alert-error" role="alert">
          <%= error %>
        </div>
        <% } %>

          <% if (success) { %>
            <div class="alert alert-success"
              style="background-color: #d1e7dd; color: #0f5132; padding: 0.75rem; border-radius: 0.5rem; margin-bottom: 1.5rem; font-size: 0.875rem;"
              role="alert">
              <%= success %>
            </div>
            <% } %>

              <form action="/forgot-password" method="POST" class="auth-form">
                <div>
                  <label for="email" class="auth-label">Email Address</label>
                  <input type="email" id="email" name="email" value="<%= formData.email || '' %>" required
                    autocomplete="email" autofocus class="auth-input">
                </div>

                <button type="submit" class="btn-auth">Send OTP</button>
              </form>

              <div style="margin-top: 2rem;">
                <p style="color: #4b5563; font-size: 0.95rem;">
                  Remember your password? <a href="/login" class="auth-link">Login here</a>
                </p>
              </div>
    </div>
  </div>

<%- include('../partials/auth-footer') %>
