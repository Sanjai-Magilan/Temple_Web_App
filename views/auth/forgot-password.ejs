<%- include('../partials/header') %>
<%- include('../partials/navbar', { user: null }) %>

<div class="container mt-4 mb-5">
  <div class="row justify-content-center">
    <div class="col-md-5 col-lg-4">
      <div class="card shadow">
        <div class="card-body p-4">
          <h2 class="card-title text-center mb-4">Forgot Password</h2>
          <p class="text-muted text-center mb-4">
            Enter your email address and we'll send you an OTP to reset your password.
          </p>
          
          <% if (error) { %>
          <div class="alert alert-danger" role="alert">
            <%= error %>
          </div>
          <% } %>

          <% if (success) { %>
          <div class="alert alert-success" role="alert">
            <%= success %>
          </div>
          <% } %>

          <form action="/forgot-password" method="POST">
            <div class="mb-3">
              <label for="email" class="form-label">Email Address</label>
              <input type="email" class="form-control" id="email" name="email" 
                     value="<%= formData.email || '' %>" required autocomplete="email" autofocus>
            </div>

            <button type="submit" class="btn btn-primary w-100 mb-3">Send OTP</button>
          </form>

          <div class="text-center">
            <p class="mb-0">Remember your password? <a href="/login">Login here</a></p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
