<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Verify Email - Temple Management</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;700&family=Playfair+Display:wght@400;700&display=swap"
    rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body class="auth-body">
  

  <div class="auth-wrapper">
    <div class="auth-card">
      <div style="margin-bottom: 2rem;">
        <h1 class="auth-title" style="color: #4a4036 !important;">Verify Your Email</h1>
        <p class="auth-subtitle">Enter the 6-digit OTP sent to your email</p>
      </div>

      <% if (typeof error !=='undefined' && error) { %>
        <div class="alert-error">
          <%= error %>
        </div>
        <% } %>

          <form action="/verify-otp" method="POST" class="auth-form">
            <input type="hidden" name="email" value="<%= email %>">

            <div>
              <label for="otp" class="auth-label">Verification Code (OTP)</label>
              <input type="text" id="otp" name="otp" required placeholder="XXXXXX" maxlength="6"
                class="auth-input otp-input" autofocus
                style="text-align: center; letter-spacing: 0.5em; font-size: 1.5rem;">
            </div>

            <button type="submit" class="btn-auth">Verify Email</button>
          </form>

          <form action="/resend-otp" method="POST" style="margin-top: 1.5rem; text-align: center;">
            <input type="hidden" name="email" value="<%= email %>">
            <button type="submit" class="btn-link"
              style="background: none; border: none; font-size: 0.9rem; cursor: pointer; padding: 0;">
              Resend OTP
            </button>
          </form>

    </div>
  </div>

<%- include('../partials/auth-footer') %>
