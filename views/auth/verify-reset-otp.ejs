<%- include('../partials/header') %>
<%- include('../partials/navbar', { user: null }) %>

<div class="container mt-5 mb-5">
  <div class="row justify-content-center">
    <div class="col-md-5 col-lg-4">
      <div class="card shadow">
        <div class="card-body p-4">

          <h4 class="text-center mb-3">Verify OTP</h4>
          <p class="text-muted text-center mb-4">
            Enter the 6-digit OTP sent to your email
          </p>

          <% if (error) { %>
            <div class="alert alert-danger text-center">
              <%= error %>
            </div>
          <% } %>

          <% if (success) { %>
            <div class="alert alert-success text-center">
              <%= success %>
            </div>
          <% } %>

          <form action="/verify-reset-otp" method="POST">
            <input type="hidden" name="email" value="<%= email %>">

            <div class="mb-3">
              <label class="form-label">OTP</label>
              <input
                type="text"
                name="otp"
                class="form-control text-center"
                placeholder="Enter OTP"
                maxlength="6"
                required
              >
            </div>

            <button type="submit" class="btn btn-primary w-100">
              Verify OTP
            </button>
          </form>

          <form action="/resend-reset-otp" method="POST" class="mt-3 text-center">
            <input type="hidden" name="email" value="<%= email %>">
            <button type="submit" class="btn btn-link">
              Resend OTP
            </button>
          </form>

          <div class="text-center mt-3">
            <p class="mb-0"><a href="/forgot-password">Back to Forgot Password</a></p>
          </div>

        </div>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
