<%- include('../../partials/header') %>

    <style>
        @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=Inter:wght@300;400;500;600&display=swap');

        /* Page Background Overrides */
        body {
            background: linear-gradient(rgba(0, 0, 0, 0.6), rgba(0, 0, 0, 0.6)), url('https://images.unsplash.com/photo-1596627706352-78d91c12d4d8?q=80&w=2070&auto=format&fit=crop') no-repeat center center fixed;
            background-size: cover !important;
            font-family: 'Inter', sans-serif !important;
            min-height: 100vh;
        }

        /* Page Title styling for visibility */
        .page-title {
            color: #f8f9fa;
            font-family: 'Playfair Display', serif;
            font-weight: 700;
            text-shadow: 0 2px 4px rgba(0, 0, 0, 0.5);
        }

        .btn-gold {
            background-color: #bfa15f;
            border-color: #bfa15f;
            color: white;
        }

        .btn-gold:hover {
            background-color: #a88b4d;
            border-color: #a88b4d;
            color: white;
        }

        /* Modal Styling */
        .modal-content {
            background: #FFFBF5;
            border-radius: 20px;
            border: 1px solid rgba(212, 175, 55, 0.2);
        }

        .modal-header {
            border-bottom: none;
            padding: 2rem 2rem 0;
            text-align: center;
            display: block;
        }

        .modal-body {
            padding: 1rem 2.5rem 2.5rem;
        }

        .booking-title {
            font-family: 'Playfair Display', serif;
            font-size: 1.8rem;
            color: #2c241b;
            font-weight: 700;
            margin-bottom: 0.2rem;
        }

        .booking-subtitle {
            color: #8c7b65;
            font-size: 0.9rem;
        }

        /* Form Styles copied from new.ejs */
        .form-group-custom {
            margin-bottom: 1.5rem;
        }

        .form-label-custom {
            display: block;
            font-weight: 500;
            color: #5d5145;
            font-size: 0.85rem;
            margin-bottom: 0.5rem;
            letter-spacing: 0.5px;
            text-transform: uppercase;
        }

        .form-control-custom,
        .form-select-custom {
            width: 100%;
            padding: 0.8rem 1rem;
            font-size: 1rem;
            color: #2c241b;
            background-color: #fff;
            border: 1px solid #e0d8cc;
            border-radius: 10px;
            transition: all 0.2s ease-in-out;
        }

        .form-control-custom:focus,
        .form-select-custom:focus {
            border-color: #bfa15f;
            outline: 0;
            box-shadow: 0 0 0 4px rgba(191, 161, 95, 0.1);
        }

        .form-row {
            display: flex;
            gap: 1.25rem;
            margin-bottom: 1.5rem;
        }

        .form-col {
            flex: 1;
        }

        .amount-wrapper {
            position: relative;
        }

        .amount-symbol {
            position: absolute;
            left: 1rem;
            top: 50%;
            transform: translateY(-50%);
            color: #5d5145;
            font-weight: 600;
        }

        .amount-input {
            padding-left: 2rem;
            font-family: 'Playfair Display', serif;
            font-weight: 700;
            color: #bfa15f;
            font-size: 1.2rem;
        }

        .btn-submit-custom {
            display: block;
            width: 100%;
            padding: 1rem;
            font-size: 1rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: #fff;
            background-color: #bfa15f;
            border: none;
            border-radius: 10px;
            cursor: pointer;
            transition: all 0.3s ease;
            margin-top: 1rem;
            font-family: 'Inter', sans-serif;
        }

        .btn-submit-custom:hover {
            background-color: #a88b4d;
            transform: translateY(-2px);
            box-shadow: 0 10px 20px rgba(168, 139, 77, 0.2);
        }

        /* Card Hover Effects */
        .card {
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

        .card:hover {
            transform: translateY(-10px);
            box-shadow: 0 15px 30px rgba(0, 0, 0, 0.3) !important;
            z-index: 10;
        }

        @media (max-width: 768px) {
            .form-row {
                flex-direction: column;
                gap: 1rem;
            }
        }
    </style>

    <%- include('../../partials/navbar', { user: typeof user !=='undefined' ? user : null }) %>

        <div class="container mt-4 mb-5">
            <div class="row mb-4">
                <div class="col-12">
                    <div class="d-flex justify-content-between align-items-center flex-wrap">
                        <h2 class="page-title"><i class="bi bi-calendar-event me-2"></i> Hall Bookings</h2>
                        <!-- Button triggers modal -->
                        <button type="button" class="btn btn-gold shadow-sm" data-bs-toggle="modal"
                            data-bs-target="#newBookingModal">
                            <i class="bi bi-plus-circle me-2"></i> New Booking
                        </button>
                    </div>
                </div>
            </div>

            <!-- Booking List -->
            <% if (typeof bookings !=='undefined' && bookings.length> 0) { %>
                <div class="row">
                    <% bookings.sort((a, b)=> new Date(b.created_at) - new Date(a.created_at)).forEach(booking => { %>
                        <div class="col-12 col-md-6 col-lg-4 mb-3">
                            <div class="card h-100 shadow-sm border-0"
                                style="border-radius: 15px; overflow: hidden; background: #FFFBF5;">
                                <div class="card-header text-white"
                                    style="background:linear-gradient(90deg, #bfa15f, #a88b4d);">
                                    <h6 class="mb-0">
                                        <%= booking.booking_number %>
                                    </h6>
                                </div>
                                <div class="card-body">
                                    <h5 class="card-title" style="font-family: 'Playfair Display', serif; color: #333;">
                                        <%= booking.hall_name %>
                                    </h5>
                                    <p class="card-text">
                                        <small class="text-muted">
                                            <i class="bi bi-calendar me-1"></i>
                                            <%= new Date(booking.booking_date).toLocaleDateString() %><br>
                                                <i class="bi bi-clock me-1"></i>
                                                <%= booking.start_time %> - <%= booking.end_time %><br>
                                                        <% if (booking.event_type) { %>
                                                            <i class="bi bi-tag me-1"></i>
                                                            <%= booking.event_type %><br>
                                                                <% } %>
                                                                    <% if (booking.expected_guests) { %>
                                                                        <i class="bi bi-people me-1"></i>
                                                                        <%= booking.expected_guests %> guests
                                                                            <% } %>
                                        </small>
                                    </p>
                                    <% if (booking.event_description) { %>
                                        <p class="card-text small text-secondary">
                                            <%= booking.event_description %>
                                        </p>
                                        <% } %>
                                            <div class="mt-3">
                                                <span
                                                    class="badge bg-<%= booking.status === 'confirmed' ? 'success' : booking.status === 'pending' ? 'warning' : booking.status === 'cancelled' ? 'danger' : 'secondary' %>">
                                                    <%= booking.status %>
                                                </span>
                                                <span class="badge bg-light text-dark border ms-2">₹<%=
                                                        booking.amount.toLocaleString() %></span>
                                            </div>
                                </div>
                                <div class="card-footer bg-transparent border-top-0">
                                    <small class="text-muted" style="font-size: 0.75rem;">
                                        Booked on: <%= new Date(booking.created_at).toLocaleDateString() %>
                                    </small>
                                </div>
                            </div>
                        </div>
                        <% }); %>
                </div>
                <% } else { %>
                    <div class="row">
                        <div class="col-12 col-md-6 offset-md-3">
                            <div class="card text-center py-4 shadow-lg border-0"
                                style="background: rgba(255, 255, 255, 0.95); border-radius: 20px;">
                                <div class="card-body">
                                    <i class="bi bi-calendar-x text-muted" style="font-size: 3rem;"></i>
                                    <h4 class="mt-3" style="font-family: 'Playfair Display', serif;">No Hall Bookings
                                        Yet</h4>
                                    <p class="text-muted">Book a hall for your event</p>
                                    <button type="button" class="btn btn-gold btn-lg mt-3" data-bs-toggle="modal"
                                        data-bs-target="#newBookingModal">
                                        <i class="bi bi-plus-circle me-2"></i> Book a Hall
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                    <% } %>
        </div>

        <!-- Modal for New Booking -->
        <div class="modal fade" id="newBookingModal" tabindex="-1" aria-labelledby="newBookingModalLabel"
            aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered modal-lg">
                <div class="modal-content">
                    <div class="modal-header">
                        <div class="header-icon-wrapper"
                            style="width: 50px; height: 50px; background: rgba(212, 175, 55, 0.1); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 1rem;">
                            <i class="bi bi-building" style="font-size: 1.5rem; color: #bfa15f;"></i>
                        </div>
                        <h5 class="booking-title" id="newBookingModalLabel">Book a Hall</h5>
                        <p class="booking-subtitle">Plan your perfect event in our divine premises</p>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"
                            style="position: absolute; right: 1.5rem; top: 1.5rem;"></button>
                    </div>
                    <div class="modal-body">
                        <form id="hallBookingForm">
                            <!-- Hall Selection -->
                            <div class="form-group-custom">
                                <label for="hall_name" class="form-label-custom">Select Venue</label>
                                <select class="form-select-custom" id="hall_name" name="hall_name" required>
                                    <option value="">Choose a hall...</option>
                                    <option value="Main Hall">Main Hall</option>
                                    <option value="Community Hall">Community Hall</option>
                                    <option value="Small Hall">Small Hall</option>
                                    <option value="Outdoor Area">Outdoor Area</option>
                                </select>
                            </div>

                            <!-- Date & Type -->
                            <div class="form-row">
                                <div class="form-col">
                                    <div class="form-group-custom">
                                        <label for="booking_date" class="form-label-custom">Event Date</label>
                                        <input type="date" class="form-control-custom" id="booking_date"
                                            name="booking_date" min="<%= new Date().toISOString().split('T')[0] %>"
                                            required>
                                    </div>
                                </div>
                                <div class="form-col">
                                    <div class="form-group-custom">
                                        <label for="event_type" class="form-label-custom">Event Type</label>
                                        <select class="form-select-custom" id="event_type" name="event_type">
                                            <option value="">Select type</option>
                                            <option value="wedding">Wedding</option>
                                            <option value="function">Function</option>
                                            <option value="ceremony">Ceremony</option>
                                            <option value="meeting">Meeting</option>
                                            <option value="other">Other</option>
                                        </select>
                                    </div>
                                </div>
                            </div>

                            <!-- Time Selection -->
                            <div class="form-row">
                                <div class="form-col">
                                    <div class="form-group-custom">
                                        <label for="start_time" class="form-label-custom">Start Time</label>
                                        <input type="time" class="form-control-custom" id="start_time" name="start_time"
                                            required>
                                    </div>
                                </div>
                                <div class="form-col">
                                    <div class="form-group-custom">
                                        <label for="end_time" class="form-label-custom">End Time</label>
                                        <input type="time" class="form-control-custom" id="end_time" name="end_time"
                                            required>
                                    </div>
                                </div>
                            </div>

                            <!-- Guests -->
                            <div class="form-group-custom">
                                <label for="expected_guests" class="form-label-custom">Expected Guests</label>
                                <input type="number" class="form-control-custom" id="expected_guests"
                                    name="expected_guests" min="1" placeholder="Number of attendees">
                            </div>

                            <!-- Food Arrangements -->
                            <div class="form-group-custom">
                                <label class="form-label-custom mb-3">Do you require food arrangements?</label>

                                <div class="d-flex gap-3 mb-3">
                                    <input type="radio" class="btn-check" name="food_required" id="food_yes" value="yes"
                                        autocomplete="off">
                                    <label class="btn btn-outline-warning w-50 py-2" for="food_yes"
                                        style="color: #2c241b; border-color: #bfa15f;">
                                        <i class="bi bi-check-circle me-2"></i>Yes, Required
                                    </label>

                                    <input type="radio" class="btn-check" name="food_required" id="food_no" value="no"
                                        autocomplete="off" checked>
                                    <label class="btn btn-outline-warning w-50 py-2" for="food_no"
                                        style="color: #2c241b; border-color: #bfa15f;">
                                        <i class="bi bi-x-circle me-2"></i>No, Thanks
                                    </label>
                                </div>

                                <!-- Meal Options (Inline) -->
                                <div id="meal_options_container"
                                    style="display: none; margin-bottom: 0.5rem; padding-left: 0.5rem; transition: all 0.3s ease;">
                                    <div class="d-flex flex-wrap gap-4 mt-2">
                                        <div class="form-check p-2">
                                            <input class="form-check-input" type="checkbox" id="meal_breakfast"
                                                value="Breakfast" style="margin-top: 0.3em;">
                                            <label class="form-check-label fw-bold" for="meal_breakfast"
                                                style="color: #5d5145;">Breakfast</label>
                                        </div>
                                        <div class="form-check p-2">
                                            <input class="form-check-input" type="checkbox" id="meal_lunch"
                                                value="Lunch" style="margin-top: 0.3em;">
                                            <label class="form-check-label fw-bold" for="meal_lunch"
                                                style="color: #5d5145;">Lunch</label>
                                        </div>
                                        <div class="form-check p-2">
                                            <input class="form-check-input" type="checkbox" id="meal_dinner"
                                                value="Dinner" style="margin-top: 0.3em;">
                                            <label class="form-check-label fw-bold" for="meal_dinner"
                                                style="color: #5d5145;">Dinner</label>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Description -->
                            <div class="form-group-custom">
                                <label for="event_description" class="form-label-custom">Event Description</label>
                                <textarea class="form-control-custom" id="event_description" name="event_description"
                                    rows="3" placeholder="Additional details or requirements..."></textarea>
                            </div>

                            <!-- Amount -->
                            <div class="form-group-custom">
                                <label for="amount" class="form-label-custom">Booking Amount</label>
                                <div class="amount-wrapper">
                                    <span class="amount-symbol">₹</span>
                                    <input type="number" class="form-control-custom amount-input" id="amount"
                                        name="amount" min="1" step="0.01" required placeholder="0.00">
                                </div>
                                <small class="text-muted"
                                    style="display: block; margin-top: 0.5rem; font-size: 0.8rem; font-style: italic;">
                                    * Please confirm amount with administration
                                </small>
                            </div>

                            <!-- Buttons -->
                            <button type="submit" class="btn-submit-custom" id="submitBtn">
                                Proceed to Payment <span style="margin-left: 5px;">→</span>
                            </button>

                            <button type="button" class="btn btn-link text-muted w-100 mt-2" data-bs-dismiss="modal"
                                style="text-decoration: none;">Cancel</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        <script>
            // Toggle Meal Options
            const foodRadios = document.getElementsByName('food_required');
            const mealContainer = document.getElementById('meal_options_container');

            foodRadios.forEach(radio => {
                radio.addEventListener('change', function () {
                    if (this.value === 'yes' && this.checked) {
                        mealContainer.style.display = 'block';
                        // Simple fade-in effect via opacity
                        mealContainer.style.opacity = '0';
                        setTimeout(() => {
                            mealContainer.style.opacity = '1';
                        }, 10);
                    } else {
                        mealContainer.style.display = 'none';
                        // Uncheck all meals if toggled off
                        ['meal_breakfast', 'meal_lunch', 'meal_dinner'].forEach(id => {
                            document.getElementById(id).checked = false;
                        });
                    }
                });
            });

            // Submission
            document.getElementById('hallBookingForm').addEventListener('submit', async function (e) {
                e.preventDefault();

                // Validate Food Selection
                const foodYes = document.getElementById('food_yes').checked;
                if (foodYes) {
                    const hasMeal = ['meal_breakfast', 'meal_lunch', 'meal_dinner'].some(id => document.getElementById(id).checked);
                    if (!hasMeal) {
                        alert('Please select at least one meal option if food is required.');
                        return;
                    }
                }

                const submitBtn = document.getElementById('submitBtn');
                const originalText = submitBtn.innerHTML;
                submitBtn.disabled = true;
                submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Processing...';

                // Prepare Description with Food Details
                let baseDescription = document.getElementById('event_description').value;

                if (foodYes) {
                    const meals = [];
                    if (document.getElementById('meal_breakfast').checked) meals.push('Breakfast');
                    if (document.getElementById('meal_lunch').checked) meals.push('Lunch');
                    if (document.getElementById('meal_dinner').checked) meals.push('Dinner');

                    baseDescription += `\n\n--- Food Arrangements ---\nRequired: Yes\nMeals: ${meals.join(', ')}`;
                } else {
                    baseDescription += `\n\n--- Food Arrangements ---\nRequired: No`;
                }

                const formData = {
                    hall_name: document.getElementById('hall_name').value,
                    booking_date: document.getElementById('booking_date').value,
                    start_time: document.getElementById('start_time').value,
                    end_time: document.getElementById('end_time').value,
                    event_type: document.getElementById('event_type').value,
                    event_description: baseDescription,
                    expected_guests: document.getElementById('expected_guests').value,
                    amount: document.getElementById('amount').value
                };

                try {
                    // Note: initiatePayment must be available in the global scope (e.g. from footer scripts)
                    if (typeof initiatePayment !== 'function') {
                        throw new Error('Payment function not loaded. Please contact support.');
                    }

                    await initiatePayment('hall-booking', formData, {
                        onSuccess: (result) => {
                            // Redirect to the booking history list as requested
                            window.location.href = '/bookings/hall';
                        },
                        onFailure: (error) => {
                            alert('Payment failed: ' + error.message);
                            submitBtn.disabled = false;
                            submitBtn.innerHTML = originalText;
                        }
                    });
                } catch (error) {
                    alert('Error: ' + error.message);
                    submitBtn.disabled = false;
                    submitBtn.innerHTML = originalText;
                }
            });
        </script>

        <%- include('../../partials/footer') %>