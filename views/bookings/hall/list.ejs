<%- include('../../partials/header') %>
<%- include('../../partials/navbar', { user: typeof user !== 'undefined' ? user : null }) %>

<div class="container mt-4 mb-5">
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center flex-wrap">
                <h2><i class="bi bi-calendar-event"></i> Hall Bookings</h2>
                <a href="/bookings/hall/new" class="btn btn-success">
                    <i class="bi bi-plus-circle"></i> New Booking
                </a>
            </div>
        </div>
    </div>

    <% if (typeof bookings !== 'undefined' && bookings.length > 0) { %>
        <div class="row">
            <% bookings.forEach(booking => { %>
                <div class="col-12 col-md-6 col-lg-4 mb-3">
                    <div class="card h-100 shadow-sm">
                        <div class="card-header bg-success text-white">
                            <h6 class="mb-0"><%= booking.booking_number %></h6>
                        </div>
                        <div class="card-body">
                            <h5 class="card-title"><%= booking.hall_name %></h5>
                            <p class="card-text">
                                <small class="text-muted">
                                    <i class="bi bi-calendar"></i> <%= new Date(booking.booking_date).toLocaleDateString() %><br>
                                    <i class="bi bi-clock"></i> <%= booking.start_time %> - <%= booking.end_time %><br>
                                    <% if (booking.event_type) { %>
                                        <i class="bi bi-tag"></i> <%= booking.event_type %><br>
                                    <% } %>
                                    <% if (booking.expected_guests) { %>
                                        <i class="bi bi-people"></i> <%= booking.expected_guests %> guests
                                    <% } %>
                                </small>
                            </p>
                            <% if (booking.event_description) { %>
                                <p class="card-text small"><%= booking.event_description %></p>
                            <% } %>
                            <div class="mt-3">
                                <span class="badge bg-<%= booking.status === 'confirmed' ? 'success' : booking.status === 'pending' ? 'warning' : booking.status === 'cancelled' ? 'danger' : 'secondary' %>">
                                    <%= booking.status %>
                                </span>
                                <span class="badge bg-info ms-2">₹<%= booking.amount.toLocaleString() %></span>
                            </div>
                        </div>
                        <div class="card-footer bg-light">
                            <small class="text-muted">
                                Booked on: <%= new Date(booking.created_at).toLocaleDateString() %>
                            </small>
                        </div>
                    </div>
                </div>
            <% }); %>
        </div>
    <% } else { %>
        <div class="row">
            <div class="col-12">
                <div class="card text-center py-5">
                    <div class="card-body">
                        <i class="bi bi-calendar-x text-muted" style="font-size: 4rem;"></i>
                        <h4 class="mt-3">No Hall Bookings Yet</h4>
                        <p class="text-muted">Book a hall for your event</p>
                        <a href="/bookings/hall/new" class="btn btn-success">
                            <i class="bi bi-plus-circle"></i> Book a Hall
                        </a>
                    </div>
                </div>
            </div>
        </div>
    <% } %>
</div>

<%- include('../../partials/footer') %>



