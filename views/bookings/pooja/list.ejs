<% if (!Array.isArray(bookings)) { bookings=bookings ? [bookings] : []; } %>
  <%- include('../../partials/header') %>

    <style>
      /* ===== NAVBAR COLOR SAME AS HALL BOOKING ===== */
      .navbar {
        background: linear-gradient(90deg, #2c241b, #8c7b65) !important;
        border-bottom: 1px solid rgba(191, 161, 95, 0.3);
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
      }

      .navbar-brand,
      .navbar .nav-link {
        color: #f5f5f5 !important;
        font-weight: 500;
      }

      .navbar .nav-link:hover {
        color: #bfa15f !important;
      }

      .navbar .dropdown-toggle {
        color: #ffffff !important;
      }

      .navbar-toggler {
        border-color: rgba(191, 161, 95, 0.6);
      }

      .navbar-toggler-icon {
        filter: invert(1) sepia(1) saturate(4) hue-rotate(10deg);
      }

      /* ===== PAGE BACKGROUND ===== */

      body {
        background: linear-gradient(180deg, #7a7a7a, #5f5f5f);
      }

      /* ===== PAGE TITLE ===== */

      .page-title {
        font-family: 'Playfair Display', serif;
        color: #ffffff;
        font-weight: 700;
        text-shadow: 0 2px 4px rgba(0, 0, 0, .4);
      }

      /* ===== CARD ===== */

      .pooja-card {
        background: #fffaf2;
        border-radius: 15px;
        overflow: hidden;
        border: none;
        box-shadow: 0 12px 22px rgba(0, 0, 0, .30);
        transition: .3s ease;
      }

      .pooja-card:hover {
        transform: translateY(-6px);
        box-shadow: 0 18px 35px rgba(0, 0, 0, .45);
      }

      /* ===== CARD HEADER ===== */

      .pooja-header {
        background: linear-gradient(90deg, #c6a75d, #b1934e);
        padding: 10px 16px;
        font-size: 13px;
        font-weight: 600;
        color: #2c241b;
      }

      /* ===== CARD BODY ===== */

      .card-body {
        padding: 16px 18px;
      }

      .card-title {
        font-family: 'Playfair Display', serif;
        font-size: 18px;
        font-weight: 600;
        margin-bottom: 12px;
        color: #2c241b;
      }

      /* ===== INFO LINES ===== */

      .info-line {
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 13px;
        margin-bottom: 7px;
        color: #444;
      }

      /* ===== STATUS BADGES ===== */

      .badge-pending {
        background: #ffc107;
        color: #000;
        border-radius: 6px;
        padding: 4px 10px;
        font-size: 12px;
        font-weight: 600;
      }

      .badge-confirmed {
        background: #28a745;
        color: #fff;
        border-radius: 6px;
        padding: 4px 10px;
        font-size: 12px;
        font-weight: 600;
      }

      .badge-cancelled {
        background: #dc3545;
        color: #fff;
        border-radius: 6px;
        padding: 4px 10px;
        font-size: 12px;
        font-weight: 600;
      }

      /* ===== AMOUNT ===== */

      .amount-badge {
        background: #f1f1f1;
        border: 1px solid #ddd;
        border-radius: 6px;
        padding: 4px 10px;
        font-size: 12px;
        font-weight: 600;
      }

      /* ===== FOOTER ===== */

      .card-footer {
        padding: 10px 16px 14px;
        font-size: 12px;
        color: #666;
      }

      /* ===== BUTTON ===== */

      .btn-gold {
        background: linear-gradient(90deg, #c6a75d, #b1934e);
        color: white;
        border-radius: 20px;
        padding: 8px 18px;
        border: none;
      }

      .btn-gold:hover {
        background: linear-gradient(90deg, #b1934e, #9f823e);
      }
    </style>

    <%- include('../../partials/navbar', { user: typeof user !=='undefined' ? user : null }) %>

      <div class="container mt-4 mb-5">

        <!-- ===== HEADER ===== -->

        <div class="row mb-3">
          <div class="col-12 d-flex justify-content-between align-items-center">

            <h2 class="page-title">
              <i class="bi bi-stars me-2"></i> Pooja Bookings
            </h2>

            <a href="/bookings/pooja/new" class="btn btn-gold">
              <i class="bi bi-plus-circle"></i> New Booking
            </a>

          </div>
        </div>

        <% if (bookings.length> 0) { %>

          <!-- ===== CARD GRID ===== -->

          <div class="row">

            <% bookings.forEach(booking=> { %>

              <div class="col-12 col-md-6 col-lg-4 mb-4">

                <div class="pooja-card h-100">

                  <!-- HEADER -->

                  <div class="pooja-header">
                    <%= booking.booking_number %>
                  </div>

                  <!-- BODY -->

                  <div class="card-body">

                    <h5 class="card-title">
                      <%= booking.pooja_name %>
                    </h5>

                    <div class="info-line">
                      <i class="bi bi-calendar"></i>
                      <%= new Date(booking.booking_date).toLocaleDateString() %>
                    </div>

                    <div class="info-line">
                      <i class="bi bi-clock"></i>
                      <%= booking.booking_time %>
                    </div>

                    <div class="info-line">
                      <i class="bi bi-person"></i>
                      <%= booking.devotee_name %>
                    </div>

                    <% if (booking.gotra) { %>
                      <div class="info-line">
                        <strong>Gotra:</strong>
                        <%= booking.gotra %>
                      </div>
                      <% } %>

                        <% if (booking.nakshatra) { %>
                          <div class="info-line">
                            <strong>Nakshatra:</strong>
                            <%= booking.nakshatra %>
                          </div>
                          <% } %>

                            <% if (booking.special_instructions) { %>
                              <div class="info-line text-muted">
                                <i class="bi bi-info-circle"></i>
                                <%= booking.special_instructions %>
                              </div>
                              <% } %>

                                <!-- STATUS + AMOUNT -->

                                <div class="mt-3">
                                  <!-- Row 1: Status & Amount -->
                                  <div class="d-flex justify-content-between gap-2 mb-3">
                                    <span
                                      class="badge bg-<%= booking.status === 'confirmed' ? 'success' : booking.status === 'pending' ? 'warning' : booking.status === 'cancelled' ? 'danger' : 'secondary' %> flex-grow-1"
                                      style="font-size: 0.9rem; padding: 0.5rem 1rem; min-width: 110px; display: inline-flex; justify-content: center; align-items: center;">
                                      <%= booking.status.charAt(0).toUpperCase() + booking.status.slice(1) %>
                                    </span>

                                    <span class="badge bg-light text-dark border flex-grow-1"
                                      style="font-size: 0.9rem; padding: 0.5rem 1rem; min-width: 110px; display: inline-flex; justify-content: center; align-items: center;">₹
                                      <%= booking.amount.toLocaleString() %>
                                    </span>
                                  </div>

                                  <!-- Row 2: Buttons -->
                                  <% if (booking.status==='pending' ) { %>
                                    <div class="d-flex justify-content-between gap-2">
                                      <a href="/bookings/pooja/continue-form/<%= booking.id %>"
                                        class="btn btn-success flex-grow-1"
                                        style="font-size: 0.9rem; padding: 0.5rem 1rem; min-width: 110px; text-decoration: none; display: inline-flex; justify-content: center; align-items: center;">
                                        Continue
                                      </a>
                                      <button class="btn btn-danger flex-grow-1"
                                        style="font-size: 0.9rem; padding: 0.5rem 1rem; min-width: 110px;"
                                        onclick="cancelPoojaBooking('<%= booking.id %>', this)">
                                        Cancel
                                      </button>
                                    </div>
                                    <% } %>
                                </div>

                  </div>

                  <!-- FOOTER -->

                  <div class="card-footer">
                    Booked on: <%= new Date(booking.created_at).toLocaleDateString() %>
                      <% if (booking.payment_status==="completed" ) { %>
                        <div class="mt-2">
                          <a href="/bookings/pooja/<%= booking.id %>/receipt"
                            class="btn btn-sm btn-outline-warning w-100"
                            style="color: #bfa15f; border-color: #bfa15f; font-weight: 500;">
                            <i class="bi bi-download me-1"></i> Download Receipt
                          </a>
                        </div>
                        <% } %>
                  </div>

                </div>

              </div>

              <% }) %>

          </div>

          <% } else { %>

            <!-- EMPTY STATE -->

            <div class="row justify-content-center">

              <div class="col-md-7">

                <div class="card text-center p-4 shadow-lg border-0" style="border-radius:15px;background:#fff;">

                  <i class="bi bi-stars text-warning" style="font-size:50px"></i>

                  <h4 class="mt-3">No Pooja Bookings Yet</h4>

                  <p class="text-muted">
                    Book a pooja and receive divine blessings 🙏
                  </p>

                  <a href="/bookings/pooja/new" class="btn btn-gold mt-2">
                    Book Pooja
                  </a>

                </div>

              </div>

            </div>

            <% } %>

                  <div>
                    <a href="/bookings/pooja/new" class="btn btn-gold btn-lg mt-3">
                      <i class="bi bi-plus-circle me-2"></i> Book Pooja 
                    </a>
                  </div>

      <!-- Cancel Confirmation Modal -->
      <div class="modal fade" id="cancelPoojaModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
          <div class="modal-content">
            <div class="modal-body text-center p-4">
              <h5 class="mb-3" style="color: #2c241b; font-family: 'Playfair Display', serif;">Cancel Booking?</h5>
              <p class="text-muted mb-4">Are you sure you want to cancel this booking?</p>
              <div class="d-flex gap-2 justify-content-center">
                <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger px-4" id="confirmCancelPoojaBtn">OK</button>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Cancel Confirmation Modal -->
      <div class="modal fade" id="cancelPoojaModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
          <div class="modal-content">
            <div class="modal-body text-center p-4">
              <h5 class="mb-3" style="color: #2c241b; font-family: 'Playfair Display', serif;">Cancel Booking?</h5>
              <p class="text-muted mb-4">Are you sure you want to cancel this booking?</p>
              <div class="d-flex gap-2 justify-content-center">
                <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger px-4" id="confirmCancelPoojaBtn">OK</button>
              </div>
            </div>
          </div>
        </div>
      </div>

      <%- include('../../partials/footer') %>

        <script>

          let bookingIdToCancel = null;
          let bookingElementToRemove = null;

          function cancelPoojaBooking(id, btn) {
            bookingIdToCancel = id;
            bookingElementToRemove = btn.closest(".pooja-card").parentElement; // Get the col wrapper to remove entire grid item
            const modal = bootstrap.Modal.getOrCreateInstance(document.getElementById('cancelPoojaModal'));
            modal.show();
          }

          document.getElementById('confirmCancelPoojaBtn').addEventListener('click', function () {
            if (!bookingIdToCancel) return;

            const btn = document.getElementById('confirmCancelPoojaBtn');
            const originalText = btn.innerHTML;
            btn.innerHTML = 'Cancelling...';
            btn.disabled = true;

            fetch(`/bookings/pooja/cancel/${bookingIdToCancel}`, {
              method: "DELETE",
              headers: { "Content-Type": "application/json" }
            })
              .then(res => res.json())
              .then(data => {
                const modalEl = document.getElementById('cancelPoojaModal');
                const modal = bootstrap.Modal.getInstance(modalEl);

                if (data.success) {
                  if (bookingElementToRemove) bookingElementToRemove.remove();
                  modal.hide();

                  // Optional: Show success toast/alert if needed, or just let the removal be the feedback
                } else {
                  alert(data.message || "Failed to cancel booking");
                }
              })
              .catch(err => {
                console.error(err);
                alert("Server error");
              })
              .finally(() => {
                btn.innerHTML = originalText;
                btn.disabled = false;
                bookingIdToCancel = null;
                bookingElementToRemove = null;
              });
          });


        </script>
