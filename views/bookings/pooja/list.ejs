<%
if (!Array.isArray(bookings)) {
  bookings = bookings ? [bookings] : [];
}
%>

<%- include('../../partials/header') %>

<style>

/* ===== Page Background (Hall Booking Style) ===== */

body {
  background: #6c6c6c;
}

/* ===== Page Title ===== */

.page-title {
  font-family: 'Playfair Display', serif;
  color: #ffffff;
  font-weight: 700;
}

/* ===== Card Layout ===== */

.pooja-card {
  background: #fffaf2;
  border-radius: 14px;
  overflow: hidden;
  box-shadow: 0 10px 20px rgba(0,0,0,.25);
  border: none;
}

/* ===== Card Header ===== */

.pooja-header {
  background: #c6a75d;
  padding: 8px 15px;
  color: #2c241b;
  font-weight: 600;
  font-size: 13px;
}

/* ===== Card Body ===== */

.card-body p {
  margin-bottom: 6px;
  font-size: 13px;
}

/* ===== Status Badge ===== */

.badge-confirmed {
  background: #1f9d55;
  color: white;
  border-radius: 6px;
  padding: 4px 8px;
  font-size: 12px;
}

.badge-pending {
  background: #ffc107;
  color: #000;
  border-radius: 6px;
  padding: 4px 8px;
  font-size: 12px;
}

.badge-cancelled {
  background: #dc3545;
  color: white;
  border-radius: 6px;
  padding: 4px 8px;
  font-size: 12px;
}

/* ===== Amount Badge ===== */

.amount-box {
  background: #f1f1f1;
  border-radius: 6px;
  padding: 4px 8px;
  font-size: 12px;
  font-weight: 600;
}

/* ===== Empty Card ===== */

.empty-box {
  background: #fff;
  border-radius: 15px;
  padding: 40px;
  box-shadow: 0 10px 30px rgba(0,0,0,.3);
}

/* ===== Button ===== */

.btn-gold {
  background: #c6a75d;
  color: white;
  border-radius: 20px;
  padding: 8px 16px;
  border: none;
}

.btn-gold:hover {
  background: #b1934e;
}

</style>

<%- include('../../partials/navbar', { user: typeof user !== 'undefined' ? user : null }) %>

<div class="container mt-4 mb-5">

<!-- ===== HEADER ===== -->

<div class="row mb-3">
  <div class="col-12 d-flex justify-content-between align-items-center">

    <h2 class="page-title">
      <i class="bi bi-stars"></i> Pooja Bookings
    </h2>

    <a href="/bookings/pooja/new" class="btn btn-gold">
      <i class="bi bi-plus-circle"></i> New Booking
    </a>

  </div>
</div>

<% if (bookings.length > 0) { %>

<!-- ===== CARD GRID ===== -->

<div class="row">

<% bookings.forEach(booking => { %>

<div class="col-md-6 col-lg-4 mb-4">

<div class="pooja-card h-100">

<!-- ===== HEADER ===== -->

<div class="pooja-header">
  <%= booking.booking_number %>
</div>

<!-- ===== BODY ===== -->

<div class="card-body">

<h6 class="fw-bold mb-2">
  <%= booking.pooja_name %>
</h6>

<p>
<i class="bi bi-calendar"></i>
<%= new Date(booking.booking_date).toLocaleDateString() %>
</p>

<p>
<i class="bi bi-clock"></i>
<%= booking.booking_time %>
</p>

<p>
<i class="bi bi-person"></i>
<%= booking.devotee_name %>
</p>

<% if (booking.pooja_type) { %>
<p>
<i class="bi bi-tag"></i>
<%= booking.pooja_type %>
</p>
<% } %>

<% if (booking.gotra) { %>
<p><strong>Gotra:</strong> <%= booking.gotra %></p>
<% } %>

<% if (booking.nakshatra) { %>
<p><strong>Nakshatra:</strong> <%= booking.nakshatra %></p>
<% } %>

<% if (booking.special_instructions) { %>
<p class="text-muted">
<i class="bi bi-info-circle"></i>
<%= booking.special_instructions %>
</p>
<% } %>

<!-- ===== STATUS + AMOUNT ===== -->

<div class="d-flex gap-2 mt-2">

<span class="
<%= booking.status === 'confirmed' ? 'badge-confirmed' :
    booking.status === 'pending' ? 'badge-pending' :
    'badge-cancelled' %>">

<%= booking.status %>

</span>

<span class="amount-box">
₹ <%= booking.amount.toLocaleString() %>
</span>

</div>

</div>

<!-- ===== FOOTER ===== -->

<div class="card-footer bg-transparent border-0">

<small class="text-muted">
Booked on:
<%= new Date(booking.created_at).toLocaleDateString() %>
</small>

</div>

</div>

</div>

<% }) %>

</div>

<% } else { %>

<!-- ===== EMPTY STATE ===== -->

<div class="row justify-content-center">

<div class="col-md-7">

<div class="empty-box text-center">

<i class="bi bi-stars text-warning" style="font-size:50px"></i>

<h4 class="mt-3">No Pooja Bookings Yet</h4>

<p class="text-muted">
Book a pooja and receive divine blessings 🙏
</p>

<a href="/bookings/pooja/new" class="btn btn-gold mt-2">
Book Pooja
</a>

</div>

</div>

</div>

<% } %>

</div>

<%- include('../../partials/footer') %>
