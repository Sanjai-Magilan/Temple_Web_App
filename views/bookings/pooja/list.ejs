<% if (!Array.isArray(bookings)) { bookings=bookings ? [bookings] : []; } %>
  <%- include('../../partials/header') %>

    <style>
      /* ===== NAVBAR COLOR SAME AS HALL BOOKING ===== */
      .navbar {
        background: linear-gradient(90deg, #2c241b, #8c7b65) !important;
        border-bottom: 1px solid rgba(191, 161, 95, 0.3);
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
      }

      .navbar-brand,
      .navbar .nav-link {
        color: #f5f5f5 !important;
        font-weight: 500;
      }

      .navbar .nav-link:hover {
        color: #bfa15f !important;
      }

      .navbar .dropdown-toggle {
        color: #ffffff !important;
      }

      .navbar-toggler {
        border-color: rgba(191, 161, 95, 0.6);
      }

      .navbar-toggler-icon {
        filter: invert(1) sepia(1) saturate(4) hue-rotate(10deg);
      }

      /* ===== PAGE BACKGROUND ===== */

      body {
        background: linear-gradient(180deg, #7a7a7a, #5f5f5f);
      }

      /* ===== PAGE TITLE ===== */

      .page-title {
        font-family: 'Playfair Display', serif;
        color: #ffffff;
        font-weight: 700;
        text-shadow: 0 2px 4px rgba(0, 0, 0, .4);
      }

      /* ===== CARD ===== */

      .pooja-card {
        background: #fffaf2;
        border-radius: 15px;
        overflow: hidden;
        border: none;
        box-shadow: 0 12px 22px rgba(0, 0, 0, .30);
        transition: .3s ease;
      }

      .pooja-card:hover {
        transform: translateY(-6px);
        box-shadow: 0 18px 35px rgba(0, 0, 0, .45);
      }

      /* ===== CARD HEADER ===== */

      .pooja-header {
        background: linear-gradient(90deg, #c6a75d, #b1934e);
        padding: 10px 16px;
        font-size: 13px;
        font-weight: 600;
        color: #2c241b;
      }

      /* ===== CARD BODY ===== */

      .card-body {
        padding: 16px 18px;
      }

      .card-title {
        font-family: 'Playfair Display', serif;
        font-size: 18px;
        font-weight: 600;
        margin-bottom: 12px;
        color: #2c241b;
      }

      /* ===== INFO LINES ===== */

      .info-line {
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 13px;
        margin-bottom: 7px;
        color: #444;
      }

      /* ===== STATUS BADGES ===== */

      .badge-pending {
        background: #ffc107;
        color: #000;
        border-radius: 6px;
        padding: 4px 10px;
        font-size: 12px;
        font-weight: 600;
      }

      .badge-confirmed {
        background: #28a745;
        color: #fff;
        border-radius: 6px;
        padding: 4px 10px;
        font-size: 12px;
        font-weight: 600;
      }

      .badge-cancelled {
        background: #dc3545;
        color: #fff;
        border-radius: 6px;
        padding: 4px 10px;
        font-size: 12px;
        font-weight: 600;
      }

      /* ===== AMOUNT ===== */

      .amount-badge {
        background: #f1f1f1;
        border: 1px solid #ddd;
        border-radius: 6px;
        padding: 4px 10px;
        font-size: 12px;
        font-weight: 600;
      }

      /* ===== FOOTER ===== */

      .card-footer {
        padding: 10px 16px 14px;
        font-size: 12px;
        color: #666;
      }

      /* ===== BUTTON ===== */

      .btn-gold {
        background-color: #bfa15f;
        border-color: #bfa15f;
        color: white;
      }

      .btn-gold:hover {
        background-color: #a88b4d;
        border-color: #a88b4d;
        color: white;
      }

      /* Modal Styling copied from hall booking */
      .modal-content {
          background: #FFFBF5;
          border-radius: 20px;
          border: 1px solid rgba(212, 175, 55, 0.2);
      }

      .modal-header {
          border-bottom: none;
          padding: 2rem 2rem 0;
          text-align: center;
          display: block;
      }

      .modal-body {
          padding: 1rem 2.5rem 2.5rem;
      }

      .booking-title {
          font-family: 'Playfair Display', serif;
          font-size: 1.8rem;
          color: #2c241b;
          font-weight: 700;
          margin-bottom: 0.2rem;
      }

      .booking-subtitle {
          color: #8c7b65;
          font-size: 0.9rem;
      }

      .form-group-custom {
          margin-bottom: 1.5rem;
      }

      .form-label-custom {
          display: block;
          font-weight: 500;
          color: #5d5145;
          font-size: 0.85rem;
          margin-bottom: 0.5rem;
          letter-spacing: 0.5px;
          text-transform: uppercase;
      }

      .form-control-custom,
      .form-select-custom {
          width: 100%;
          padding: 0.8rem 1rem;
          font-size: 1rem;
          color: #2c241b;
          background-color: #fff;
          border: 1px solid #e0d8cc;
          border-radius: 10px;
          transition: all 0.2s ease-in-out;
      }

      .form-control-custom:focus,
      .form-select-custom:focus {
          border-color: #bfa15f;
          outline: 0;
          box-shadow: 0 0 0 4px rgba(191, 161, 95, 0.1);
      }

      .form-row {
          display: flex;
          gap: 1.25rem;
          margin-bottom: 1.5rem;
      }

      .form-col {
          flex: 1;
      }

      .amount-wrapper {
          position: relative;
      }

      .amount-symbol {
          position: absolute;
          left: 1rem;
          top: 50%;
          transform: translateY(-50%);
          color: #5d5145;
          font-weight: 600;
      }

      .amount-input {
          padding-left: 2rem;
          font-family: 'Playfair Display', serif;
          font-weight: 700;
          color: #bfa15f;
          font-size: 1.2rem;
          -moz-appearance: textfield;
          appearance: textfield;
      }

      .amount-input::-webkit-inner-spin-button,
      .amount-input::-webkit-outer-spin-button {
          -webkit-appearance: none;
          margin: 0;
      }

      .btn-submit-custom {
          display: block;
          width: 100%;
          padding: 1rem;
          font-size: 1rem;
          font-weight: 600;
          text-transform: uppercase;
          letter-spacing: 1px;
          color: #fff;
          background-color: #bfa15f;
          border: none;
          border-radius: 10px;
          cursor: pointer;
          transition: all 0.3s ease;
          margin-top: 1rem;
          font-family: 'Inter', sans-serif;
      }

      .btn-submit-custom:hover {
          background-color: #a88b4d;
          transform: translateY(-2px);
          box-shadow: 0 10px 20px rgba(168, 139, 77, 0.2);
      }

      @media (max-width: 768px) {
          .form-row {
              flex-direction: column;
              gap: 1rem;
          }
      }
    </style>

    <style>
      :root {
        --card-fill: #FFFFFF;
        --text-main: #1E1E24;
        --text-muted: #71717A;
        --accent: #f72f42;
        --accent-dark: #d92234;
        --border-soft: rgba(30, 30, 36, 0.12);
        --shadow-soft: 0 24px 70px rgba(19, 17, 23, 0.14);
        --reference-gradient: linear-gradient(to right, rgb(245, 158, 11), rgb(249, 115, 22), rgb(217, 119, 6));
        --reference-title: rgb(120, 53, 15);
        --reference-divider: rgb(229, 231, 235);
      }

      body {
        background:
          linear-gradient(180deg, rgba(255, 250, 243, 0.30), rgba(255, 247, 238, 0.38)),
          url('/Image/Background_Theme_1.jpg') center center / cover no-repeat fixed;
      }

      .page-title {
        color: var(--reference-title);
        text-shadow: none;
      }

      .btn-gold,
      .btn-submit-custom {
        background-image: var(--reference-gradient);
        background-color: transparent;
        border-color: transparent;
        border-width: 2px;
        color: #fff;
        border-radius: 14px;
        font-weight: 700;
        box-shadow: 0 14px 28px rgba(217, 119, 6, 0.18);
      }

      .btn-gold:hover,
      .btn-submit-custom:hover {
        color: var(--reference-title);
        background-image: none;
        background-color: #fff;
        border-color: var(--reference-divider);
        box-shadow: none;
      }

      .btn-gold:focus-visible,
      .btn-submit-custom:focus-visible,
      .btn-gold:active,
      .btn-submit-custom:active {
        outline: none;
        color: var(--reference-title);
        background-image: none;
        background-color: #fff;
        border-color: var(--reference-divider);
        box-shadow: 0 0 0 4px rgba(217, 119, 6, 0.14);
      }

      .pooja-card {
        background: rgba(255, 255, 255, 0.95);
        border: 1px solid rgba(255, 255, 255, 0.7);
        border-radius: 24px;
        overflow: hidden;
        box-shadow: var(--shadow-soft);
      }

      .pooja-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 28px 56px rgba(19, 17, 23, 0.16);
      }

      .pooja-header {
        background: var(--reference-gradient);
        color: #fff;
        border-bottom: 1px solid var(--reference-divider);
      }

      .card-title,
      .booking-title,
      .modal-content .booking-title {
        color: var(--reference-title);
      }

      .info-line,
      .card-footer {
        color: var(--text-muted);
      }

      .modal-content {
        background: rgba(255, 255, 255, 0.96);
        border-radius: 28px;
        border: 1px solid rgba(255, 255, 255, 0.75);
        box-shadow: var(--shadow-soft);
      }

      .modal-header {
        padding-top: 2.25rem;
      }

      .form-label-custom {
        color: var(--text-main);
      }

      .form-control-custom,
      .form-select-custom {
        border-radius: 14px;
        border: 1px solid var(--border-soft);
        color: var(--text-main);
      }

      .form-control-custom:focus,
      .form-select-custom:focus {
        border-color: rgba(217, 119, 6, 0.52);
        box-shadow: 0 0 0 4px rgba(217, 119, 6, 0.12);
      }

      .amount-symbol {
        color: var(--reference-title);
      }

      .amount-input {
        color: var(--reference-title);
      }

      .badge-pending {
        background: rgba(247, 47, 66, 0.12);
        color: var(--reference-title);
      }

      .badge-confirmed {
        background: rgba(22, 163, 74, 0.12);
        color: #15803d;
      }

      .badge-cancelled {
        background: rgba(220, 53, 69, 0.12);
        color: #b91c1c;
      }

      .amount-badge {
        background: rgba(30, 30, 36, 0.04);
        border-color: var(--reference-divider);
        color: var(--reference-title);
      }

      .empty-state-card {
        background: rgba(255, 255, 255, 0.96);
        border-radius: 28px;
        box-shadow: var(--shadow-soft);
      }

      .btn-accent {
        background-image: var(--reference-gradient);
        background-color: transparent;
        border-color: transparent;
        border-width: 2px;
        color: #fff;
      }

      .btn-accent:hover {
        color: var(--reference-title);
        background-image: none;
        background-color: #fff;
        border-color: var(--reference-divider);
      }

      .btn-accent:focus-visible,
      .btn-accent:active {
        outline: none;
        color: var(--reference-title);
        background-image: none;
        background-color: #fff;
        border-color: var(--reference-divider);
        box-shadow: 0 0 0 4px rgba(217, 119, 6, 0.14);
      }

      @media (max-width: 768px) {
        .modal-content {
          border-radius: 22px;
        }
      }
    </style>

    <%- include('../../partials/navbar', { user: typeof user !=='undefined' ? user : null }) %>

      <div class="container mt-4 mb-5">

        <!-- ===== HEADER ===== -->

        <div class="row mb-4">
          <div class="col-12">
            <div class="d-flex justify-content-between align-items-center flex-wrap">
              <h2 class="page-title">
                <i class="bi bi-stars me-2"></i> Pooja Bookings
              </h2>

              <button type="button" class="btn btn-gold shadow-sm" data-bs-toggle="modal" data-bs-target="#newPoojaBookingModal">
                <i class="bi bi-plus-circle me-2"></i> New Booking
              </button>
            </div>
          </div>
        </div>

        <% if (bookings.length> 0) { %>

          <!-- ===== CARD GRID ===== -->

          <div class="row">

            <% bookings.forEach(booking=> { %>

              <div class="col-12 col-md-6 col-lg-4 mb-4">

                <div class="pooja-card h-100">

                  <!-- HEADER -->

                  <div class="pooja-header">
                    <%= booking.booking_number %>
                  </div>

                  <!-- BODY -->

                  <div class="card-body">

                    <h5 class="card-title">
                      <%= booking.pooja_name %>
                    </h5>

                    <div class="info-line">
                      <i class="bi bi-calendar"></i>
                      <%= new Date(booking.booking_date).toLocaleDateString() %>
                    </div>

                    <div class="info-line">
                      <i class="bi bi-clock"></i>
                      <%= booking.booking_time %>
                    </div>

                    <div class="info-line">
                      <i class="bi bi-person"></i>
                      <%= booking.devotee_name %>
                    </div>

                    <% if (booking.gotra) { %>
                      <div class="info-line">
                        <strong>Gotra:</strong>
                        <%= booking.gotra %>
                      </div>
                      <% } %>

                        <% if (booking.nakshatra) { %>
                          <div class="info-line">
                            <strong>Nakshatra:</strong>
                            <%= booking.nakshatra %>
                          </div>
                          <% } %>

                            <% if (booking.special_instructions) { %>
                              <div class="info-line text-muted">
                                <i class="bi bi-info-circle"></i>
                                <%= booking.special_instructions %>
                              </div>
                              <% } %>

                                <!-- STATUS + AMOUNT -->

                                <div class="mt-3">
                                  <!-- Row 1: Status & Amount -->
                                  <div class="d-flex justify-content-between gap-2 mb-3">
                                    <span
                                      class="badge bg-<%= booking.status === 'confirmed' ? 'success' : booking.status === 'pending' ? 'warning' : booking.status === 'cancelled' ? 'danger' : 'secondary' %> flex-grow-1"
                                      style="font-size: 0.9rem; padding: 0.5rem 1rem; min-width: 110px; display: inline-flex; justify-content: center; align-items: center;">
                                      <%= booking.status.charAt(0).toUpperCase() + booking.status.slice(1) %>
                                    </span>

                                    <span class="badge bg-light text-dark border flex-grow-1"
                                      style="font-size: 0.9rem; padding: 0.5rem 1rem; min-width: 110px; display: inline-flex; justify-content: center; align-items: center;">₹
                                      <%= booking.amount.toLocaleString() %>
                                    </span>
                                  </div>

                                  <!-- Row 2: Buttons -->
                                  <% if (booking.status==='pending' ) { %>
                                    <div class="d-flex justify-content-between gap-2">
                                      <a href="/bookings/pooja/continue-form/<%= booking.id %>"
                                        class="btn btn-success flex-grow-1"
                                        style="font-size: 0.9rem; padding: 0.5rem 1rem; min-width: 110px; text-decoration: none; display: inline-flex; justify-content: center; align-items: center;">
                                        Continue
                                      </a>
                                      <button class="btn btn-danger flex-grow-1"
                                        style="font-size: 0.9rem; padding: 0.5rem 1rem; min-width: 110px;"
                                        onclick="cancelPoojaBooking('<%= booking.id %>', this)">
                                        Cancel
                                      </button>
                                    </div>
                                    <% } %>
                                </div>

                  </div>

                  <!-- FOOTER -->

                  <div class="card-footer">
                    Booked on: <%= new Date(booking.created_at).toLocaleDateString() %>
                      <% if (booking.payment_status==="completed" ) { %>
                        <div class="mt-2">
                          <a href="/bookings/pooja/<%= booking.id %>/receipt"
                            class="btn btn-sm btn-outline-warning w-100"
                            style="color: #bfa15f; border-color: #bfa15f; font-weight: 500;">
                            <i class="bi bi-download me-1"></i> Download Receipt
                          </a>
                        </div>
                        <% } %>
                  </div>

                </div>

              </div>

              <% }) %>

          </div>

          <% } else { %>

            <!-- EMPTY STATE -->

            <div class="row">
              <div class="col-12 col-md-6 offset-md-3">
                <div class="card text-center py-4 shadow-lg border-0" style="background: rgba(255, 255, 255, 0.95); border-radius: 20px;">
                  <div class="card-body">
                    <i class="bi bi-stars text-warning" style="font-size: 3rem;"></i>
                    <h4 class="mt-3" style="font-family: 'Playfair Display', serif;">No Pooja Bookings Yet</h4>
                    <p class="text-muted">Book a pooja and receive divine blessings 🙏</p>
                    <button type="button" class="btn btn-gold btn-lg mt-3 shadow-sm" data-bs-toggle="modal" data-bs-target="#newPoojaBookingModal">
                      <i class="bi bi-plus-circle me-2"></i> Book Pooja
                    </button>
                  </div>
                </div>
              </div>
            </div>

            <% } %>

      </div>

      <!-- Cancel Confirmation Modal -->
      <div class="modal fade" id="cancelPoojaModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
          <div class="modal-content">
            <div class="modal-body text-center p-4">
              <h5 class="mb-3" style="color: #2c241b; font-family: 'Playfair Display', serif;">Cancel Booking?</h5>
              <p class="text-muted mb-4">Are you sure you want to cancel this booking?</p>
              <div class="d-flex gap-2 justify-content-center">
                <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger px-4" id="confirmCancelPoojaBtn">OK</button>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Modal for New Pooja Booking -->
      <div class="modal fade" id="newPoojaBookingModal" tabindex="-1" aria-labelledby="newPoojaBookingModalLabel" aria-hidden="true">
          <div class="modal-dialog modal-dialog-centered modal-lg">
              <div class="modal-content">
                  <div class="modal-header">
                      <div class="header-icon-wrapper"
                          style="width: 50px; height: 50px; background: rgba(212, 175, 55, 0.1); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 1rem;">
                          <i class="bi bi-stars" style="font-size: 1.5rem; color: #bfa15f;"></i>
                      </div>
                      <h5 class="booking-title" id="newPoojaBookingModalLabel">Book a Pooja</h5>
                      <p class="booking-subtitle">A Guide to Daily Rituals and Divine Connection</p>
                      <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"
                          style="position: absolute; right: 1.5rem; top: 1.5rem;"></button>
                  </div>
                  <div class="modal-body">
                      <form id="poojaBookingForm">
                          <!-- Select Pooja -->
                          <div class="form-group-custom">
                              <label for="pooja_name" class="form-label-custom">Select Pooja</label>
                              <select class="form-select-custom" id="pooja_name" name="pooja_name" onchange="setAmount()" required>
                                  <option value="">Choose Pooja</option>
                                  <option value="Ganapathi Homam" data-price="500">Ganapathi Homam — ₹500</option>
                                  <option value="Satyanarayana Pooja" data-price="750">Satyanarayana Pooja — ₹750</option>
                                  <option value="Navagraha Pooja" data-price="1000">Navagraha Pooja — ₹1000</option>
                                  <option value="Abhishekam" data-price="300">Abhishekam — ₹300</option>
                                  <option value="Lakshmi Pooja" data-price="1200">Lakshmi Pooja — ₹1200</option>
                              </select>
                          </div>

                          <!-- Date & Time -->
                          <div class="form-row">
                              <div class="form-col">
                                  <div class="form-group-custom">
                                      <label for="booking_date" class="form-label-custom">Booking Date</label>
                                      <input type="date" class="form-control-custom" id="booking_date" name="booking_date" required onclick="this.showPicker()">
                                  </div>
                              </div>
                              <div class="form-col">
                                  <div class="form-group-custom">
                                      <label for="booking_time" class="form-label-custom">Booking Time</label>
                                      <input type="time" class="form-control-custom" id="booking_time" name="booking_time" required>
                                  </div>
                              </div>
                          </div>

                          <!-- Devotee Name -->
                          <div class="form-group-custom">
                              <label for="devotee_name" class="form-label-custom">Devotee Name</label>
                              <input type="text" class="form-control-custom" id="devotee_name" name="devotee_name" placeholder="Enter devotee full name" required>
                          </div>

                          <!-- Gotra & Nakshatra -->
                          <div class="form-row">
                              <div class="form-col">
                                  <div class="form-group-custom">
                                      <label for="gotra" class="form-label-custom">Gotra</label>
                                      <input type="text" class="form-control-custom" id="gotra" name="gotra" placeholder="Eg: Bharadwaj">
                                  </div>
                              </div>
                              <div class="form-col">
                                  <div class="form-group-custom">
                                      <label for="nakshatra" class="form-label-custom">Nakshatra</label>
                                      <select class="form-select-custom" id="nakshatra" name="nakshatra">
                                          <option value="">Choose Nakshatra</option>
                                          <option>Ashwini</option>
                                          <option>Bharani</option>
                                          <option>Krittika</option>
                                          <option>Rohini</option>
                                          <option>Mrigashirsha</option>
                                          <option>Ardra</option>
                                          <option>Punarvasu</option>
                                          <option>Pushya</option>
                                          <option>Ashlesha</option>
                                          <option>Magha</option>
                                          <option>Purva Phalguni</option>
                                          <option>Uttara Phalguni</option>
                                          <option>Hasta</option>
                                          <option>Chitra</option>
                                          <option>Swati</option>
                                          <option>Vishakha</option>
                                          <option>Anuradha</option>
                                          <option>Jyeshtha</option>
                                          <option>Mula</option>
                                          <option>Purva Ashadha</option>
                                          <option>Uttara Ashadha</option>
                                          <option>Shravana</option>
                                          <option>Dhanishta</option>
                                          <option>Shatabhisha</option>
                                          <option>Purva Bhadrapada</option>
                                          <option>Uttara Bhadrapada</option>
                                          <option>Revati</option>
                                      </select>
                                  </div>
                              </div>
                          </div>

                          <!-- Special Instructions -->
                          <div class="form-group-custom">
                              <label for="special_instructions" class="form-label-custom">Special Instructions</label>
                              <textarea class="form-control-custom" id="special_instructions" name="special_instructions" rows="3" placeholder="Flowers, preferred timings, sankalpam details..."></textarea>
                          </div>

                          <!-- Amount -->
                          <div class="form-group-custom">
                              <label for="amount" class="form-label-custom">Pooja Amount</label>
                              <div class="amount-wrapper">
                                  <span class="amount-symbol">₹</span>
                                  <input type="number" class="form-control-custom amount-input" id="amount" name="amount" required readonly placeholder="0">
                              </div>
                          </div>

                          <!-- Buttons -->
                          <button type="submit" class="btn-submit-custom" id="submitBtn">
                              Proceed To Payment <span style="margin-left: 5px;">→</span>
                          </button>

                          <button type="button" class="btn btn-link text-muted w-100 mt-2" data-bs-dismiss="modal" style="text-decoration: none;">Cancel</button>
                      </form>
                  </div>
              </div>
          </div>
      </div>

      <%- include('../../partials/footer') %>

        <script>

          let bookingIdToCancel = null;
          let bookingElementToRemove = null;

          function cancelPoojaBooking(id, btn) {
            bookingIdToCancel = id;
            bookingElementToRemove = btn.closest(".pooja-card").parentElement; // Get the col wrapper to remove entire grid item
            const modal = bootstrap.Modal.getOrCreateInstance(document.getElementById('cancelPoojaModal'));
            modal.show();
          }

          document.getElementById('confirmCancelPoojaBtn').addEventListener('click', function () {
            if (!bookingIdToCancel) return;

            const btn = document.getElementById('confirmCancelPoojaBtn');
            const originalText = btn.innerHTML;
            btn.innerHTML = 'Cancelling...';
            btn.disabled = true;

            fetch(`/bookings/pooja/cancel/${bookingIdToCancel}`, {
              method: "DELETE",
              headers: { "Content-Type": "application/json" }
            })
              .then(res => res.json())
              .then(data => {
                const modalEl = document.getElementById('cancelPoojaModal');
                const modal = bootstrap.Modal.getInstance(modalEl);

                if (data.success) {
                  if (bookingElementToRemove) bookingElementToRemove.remove();
                  modal.hide();

                  // Optional: Show success toast/alert if needed, or just let the removal be the feedback
                } else {
                  alert(data.message || "Failed to cancel booking");
                }
              })
              .catch(err => {
                console.error(err);
                alert("Server error");
              })
              .finally(() => {
                btn.innerHTML = originalText;
                btn.disabled = false;
                bookingIdToCancel = null;
                bookingElementToRemove = null;
              });
          });

          // Pooja Booking Form Logic
          function setAmount() {
            const select = document.getElementById("pooja_name");
            const option = select.options[select.selectedIndex];
            const price = option.getAttribute("data-price");
            document.getElementById("amount").value = price || "";
          }

          function setMinPoojaDate() {
            const dateInput = document.getElementById('booking_date');
            if (!dateInput) return;

            const now = new Date();
            now.setDate(now.getDate() + 3);

            const year = now.getFullYear();
            const month = String(now.getMonth() + 1).padStart(2, '0');
            const day = String(now.getDate()).padStart(2, '0');
            const minDate = `${year}-${month}-${day}`;

            dateInput.setAttribute("min", minDate);
          }

          setMinPoojaDate();

          document.getElementById('poojaBookingForm').addEventListener('submit', async function (e) {
            e.preventDefault();

            const submitBtn = document.getElementById('submitBtn');
            const originalText = submitBtn.innerHTML;
            submitBtn.disabled = true;
            submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Processing...';

            const formData = {
              pooja_name: document.getElementById('pooja_name').value,
              booking_date: document.getElementById('booking_date').value,
              booking_time: document.getElementById('booking_time').value,
              devotee_name: document.getElementById('devotee_name').value,
              gotra: document.getElementById('gotra').value,
              nakshatra: document.getElementById('nakshatra').value,
              special_instructions: document.getElementById('special_instructions').value,
              amount: document.getElementById('amount').value
            };

            try {
              if (typeof initiatePayment !== 'function') {
                throw new Error('Payment function not loaded. Please contact support.');
              }

              await initiatePayment('pooja-booking', formData, {
                onSuccess: () => {
                  showAlert('success', 'Booking Confirmed', 'Your pooja booking has been confirmed!');
                  setTimeout(() => {
                    window.location.reload();
                  }, 1500);
                },
                onCancel: () => {
                  setTimeout(() => {
                    window.location.reload();
                  }, 500);
                },
                onFailure: (error) => {
                  showAlert('error', 'Payment Failed', error.message || 'Payment failed.');
                  submitBtn.disabled = false;
                  submitBtn.innerHTML = originalText;
                }
              });
            } catch (error) {
              showAlert('error', 'Error', error.message || 'An error occurred.');
              submitBtn.disabled = false;
              submitBtn.innerHTML = originalText;
            }
          });

        </script>
