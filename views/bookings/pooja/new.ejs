<%- include('../../partials/header') %>

  <style>
        /* ===== Global Reset ===== */
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    /* ===== Allow FULL WINDOW SCROLL ===== */

    body {
      overflow-y: auto;
    }

    /* ===== Overlay ===== */

    .modal-overlay {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, .65);
      backdrop-filter: blur(4px);

      display: flex;
      justify-content: center;
      align-items: flex-start;

      padding: 40px 15px;
      overflow-y: auto;

      z-index: 9999;
    }

    /* ===== Modal Box ===== */

    .booking-modal {
      width: 100%;
      max-width: 650px;

      background: #fffaf3;
      padding: 35px 40px;

      border-radius: 22px;
      box-shadow: 0 30px 60px rgba(0, 0, 0, .5);

      position: relative;
      animation: popup .3s ease;
    }

    @keyframes popup {
      from {
        transform: translateY(20px) scale(.95);
        opacity: 0;
      }

      to {
        transform: translateY(0) scale(1);
        opacity: 1;
      }
    }

    /* ===== Close Button ===== */

    .close-btn {
      position: absolute;
      right: 18px;
      top: 15px;
      font-size: 22px;
      cursor: pointer;
      color: #999;
    }

    .close-btn:hover {
      color: #000;
    }

    /* ===== Header ===== */

    .booking-title {
      text-align: center;
      font-family: 'Playfair Display', serif;
      font-size: 30px;
      font-weight: 700;
    }

    .booking-subtitle {
      text-align: center;
      font-size: 14px;
      color: #8c7b65;
      margin-bottom: 25px;
    }

    /* ===== Form ===== */

    .form-group {
      margin-bottom: 18px;
    }

    .form-label {
      font-size: 13px;
      font-weight: 600;
      color: #5d5145;
      margin-bottom: 7px;
      display: block;
    }

    .form-input {
      width: 100%;
      padding: 13px 14px;
      border-radius: 12px;
      border: 1px solid #ddd;
      font-size: 14px;
    }

    .form-input::placeholder {
      color: #aaa;
    }

    .form-input:focus {
      outline: none;
      border-color: #bfa15f;
      box-shadow: 0 0 0 4px rgba(191, 161, 95, .15);
    }



    /* ===== Two Column Layout ===== */

    .row-2 {
      display: flex;
      gap: 16px;
    }

    .col-2 {
      flex: 1;
    }

    /* ===== Amount Field ===== */

    .amount-box {
      position: relative;
    }

    .amount-symbol {
      position: absolute;
      left: 13px;
      top: 50%;
      transform: translateY(-50%);
      font-weight: bold;
      color: #bfa15f;
    }

    .amount-input {
      padding-left: 32px;
      font-weight: 600;
      color: #bfa15f;
    }

    /* Hide spinner specifically for amount input */
    .amount-input::-webkit-inner-spin-button,
    .amount-input::-webkit-outer-spin-button {
      -webkit-appearance: none;
      margin: 0;
    }

    .amount-input {
      -moz-appearance: textfield;
      appearance: textfield;
    }

    /* ===== Buttons ===== */

    .btn-book {
      width: 100%;
      padding: 14px;
      border-radius: 12px;
      border: none;

      background: linear-gradient(135deg, #bfa15f, #a88b4d);
      color: white;

      font-size: 15px;
      font-weight: 600;
      margin-top: 10px;

      cursor: pointer;
    }

    .btn-book:hover {
      transform: translateY(-2px);
      box-shadow: 0 10px 20px rgba(168, 139, 77, .35);
    }

    .btn-book:disabled {
      background: #dcdcdc;
      cursor: not-allowed;
      transform: none;
    }

    /* ===== Cancel Link ===== */

    .cancel-link {
      display: block;
      text-align: center;
      margin-top: 14px;
      font-size: 14px;
      color: #777;
      cursor: pointer;
      text-decoration: none;
    }

    .cancel-link:hover {
      color: #bfa15f;
      text-decoration: underline;
    }

    /* ===== Mobile ===== */

    @media (max-width:600px) {

      .modal-overlay {
        padding: 20px 10px;
        align-items: flex-start;
      }

      .row-2 {
        flex-direction: column;
      }

      .booking-modal {
        padding: 25px 20px;
        border-radius: 16px;
        margin-bottom: 20px;
      }
    }

    .swal2-container {
      z-index: 20000 !important;
    }
  </style>

  <style>
    :root {
      --card-fill: #FFFFFF;
      --text-main: #1E1E24;
      --text-muted: #71717A;
      --accent: #f72f42;
      --accent-dark: #d92234;
      --border-soft: rgba(30, 30, 36, 0.12);
      --shadow-soft: 0 24px 70px rgba(19, 17, 23, 0.14);
      --reference-gradient: linear-gradient(to right, rgb(245, 158, 11), rgb(249, 115, 22), rgb(217, 119, 6));
      --reference-title: rgb(120, 53, 15);
      --reference-divider: rgb(229, 231, 235);
    }

    .modal-overlay {
      position: relative;
      min-height: calc(100vh - 70px);
      background:
        linear-gradient(180deg, rgba(255, 250, 243, 0.30), rgba(255, 247, 238, 0.38)),
        url('/Image/Background_Theme_1.jpg') center center / cover no-repeat fixed;
      padding: 36px 16px 42px;
    }

    .booking-modal {
      max-width: 760px;
      background: rgba(255, 255, 255, 0.94);
      backdrop-filter: blur(10px);
      padding: 34px 34px 30px;
      border-radius: 28px;
      border: 1px solid rgba(255, 255, 255, 0.64);
      box-shadow: var(--shadow-soft);
    }

    .close-btn {
      width: 38px;
      height: 38px;
      border-radius: 50%;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 16px;
      color: var(--text-muted);
      background: rgba(113, 113, 122, 0.08);
      transition: all .2s ease;
    }

    .close-btn:hover {
      color: var(--text-main);
      background: rgba(247, 47, 66, 0.12);
    }

    .booking-title {
      color: var(--reference-title);
      font-size: 2rem;
      letter-spacing: .2px;
    }

    .booking-subtitle {
      color: var(--text-muted);
      max-width: 34rem;
      margin: 8px auto 28px;
    }

    .form-label {
      color: var(--text-main);
      font-size: .84rem;
      font-weight: 700;
      letter-spacing: .02em;
    }

    .form-input {
      border: 1px solid var(--border-soft);
      border-radius: 14px;
      color: var(--text-main);
      background: var(--card-fill);
      transition: border-color .2s ease, box-shadow .2s ease, transform .2s ease;
    }

    .form-input::placeholder {
      color: #a1a1aa;
    }

    .form-input:focus {
      border-color: rgba(217, 119, 6, 0.52);
      box-shadow: 0 0 0 4px rgba(217, 119, 6, 0.12);
    }

    .amount-symbol {
      color: var(--reference-title);
      font-weight: 700;
    }

    .amount-input {
      color: var(--reference-title);
      background: linear-gradient(180deg, rgba(245, 158, 11, 0.05), rgba(245, 158, 11, 0.01));
    }

    .btn-book {
      border: 1px solid transparent;
      background-image: var(--reference-gradient);
      background-color: transparent;
      box-shadow: 0 14px 28px rgba(217, 119, 6, 0.24);
      font-size: .98rem;
      font-weight: 700;
      border-radius: 14px;
      transition: all .2s ease;
    }

    .btn-book:hover {
      transform: translateY(-1px);
      background-image: none;
      background-color: #fff;
      color: var(--reference-title);
      border-color: var(--reference-divider);
      box-shadow: none;
    }

    .btn-book:focus-visible,
    .btn-book:active {
      outline: none;
      background-image: none;
      background-color: #fff;
      color: var(--reference-title);
      border-color: var(--reference-divider);
      box-shadow: 0 0 0 4px rgba(217, 119, 6, 0.14);
    }

    .btn-book:disabled {
      background: #e4e4e7;
      border-color: #e4e4e7;
      color: #a1a1aa;
    }

    .cancel-link {
      color: var(--text-muted);
      font-size: .95rem;
    }

    .cancel-link:hover {
      color: var(--reference-title);
    }

    .btn-accent {
      background-image: var(--reference-gradient);
      background-color: transparent;
      border-color: transparent;
      color: #fff;
      border-width: 2px;
    }

    .btn-accent:hover {
      color: var(--reference-title);
      background-image: none;
      background-color: #fff;
      border-color: var(--reference-divider);
    }

    .btn-accent:focus-visible,
    .btn-accent:active {
      outline: none;
      color: var(--reference-title);
      background-image: none;
      background-color: #fff;
      border-color: var(--reference-divider);
      box-shadow: 0 0 0 4px rgba(217, 119, 6, 0.14);
    }

    .row-2 {
      gap: 16px;
    }

    @media (max-width: 768px) {
      .modal-overlay {
        padding: 18px 12px 28px;
      }

      .booking-modal {
        padding: 26px 18px 22px;
        border-radius: 22px;
      }

      .booking-title {
        font-size: 1.65rem;
      }

      .row-2 {
        flex-direction: column;
      }
    }
  </style>

  <%- include('../../partials/navbar', { user: typeof user !=='undefined' ? user : null }) %>

    <!-- ===== POPUP ===== -->

    <div class="modal-overlay">

      <div class="booking-modal">

        <!-- Close Button -->
        <div class="close-btn" onclick="closeModal()">✖</div>

        <!-- Header -->
        <h2 class="booking-title">Book a Pooja</h2>
        <p class="booking-subtitle">
          Choose a sacred service, share the details, and continue to payment.
        </p>

        <!-- Form -->

        <form id="poojaBookingForm">

          <!-- Select Pooja -->

          <div class="form-group">
            <label class="form-label">Select Pooja</label>
            <% const selectedPooja = typeof booking !== 'undefined' && booking ? booking.pooja_name : ''; %>
            <select id="pooja_name" class="form-input" onchange="setAmount()" required>

              <option value="">Choose Pooja</option>
              <option value="Ganapathi Homam" data-price="500" <%= selectedPooja === 'Ganapathi Homam' ? 'selected' : '' %>>Ganapathi Homam — ₹500</option>
              <option value="Satyanarayana Pooja" data-price="750" <%= selectedPooja === 'Satyanarayana Pooja' ? 'selected' : '' %>>Satyanarayana Pooja — ₹750</option>
              <option value="Navagraha Pooja" data-price="1000" <%= selectedPooja === 'Navagraha Pooja' ? 'selected' : '' %>>Navagraha Pooja — ₹1000</option>
              <option value="Abhishekam" data-price="300" <%= selectedPooja === 'Abhishekam' ? 'selected' : '' %>>Abhishekam — ₹300</option>
              <option value="Lakshmi Pooja" data-price="1200" <%= selectedPooja === 'Lakshmi Pooja' ? 'selected' : '' %>>Lakshmi Pooja — ₹1200</option>

            </select>
          </div>

          <!-- Booking Date & Time -->

          <div class="row-2">

            <div class="col-2 form-group">
              <label class="form-label">Booking Date</label>
              <% 
                  let dateVal = '';
                  if (typeof booking !== 'undefined' && booking && booking.booking_date) {
                      const d = new Date(booking.booking_date);
                      if (!isNaN(d)) {
                          const year = d.getFullYear();
                          const month = String(d.getMonth() + 1).padStart(2, '0');
                          const day = String(d.getDate()).padStart(2, '0');
                          dateVal = `${year}-${month}-${day}`;
                      } else {
                          dateVal = booking.booking_date;
                      }
                  }
              %>
              <input type="date" id="booking_date" name="booking_date" class="form-input" value="<%= dateVal %>" required>
            </div>

            <div class="col-2 form-group">
              <label class="form-label">Booking Time</label>
              <input type="time" id="booking_time" name="booking_time" class="form-input" value="<%= typeof booking !== 'undefined' && booking ? booking.booking_time : '' %>" required>
            </div>

          </div>

          <!-- Devotee Name -->

          <div class="form-group">
            <label class="form-label">Devotee Name</label>
            <input type="text" id="devotee_name" name="devotee_name" class="form-input" placeholder="Enter devotee full name" value="<%= typeof booking !== 'undefined' && booking ? booking.devotee_name : '' %>" required>
          </div>

          <!-- Gotra & Nakshatra -->

          <div class="row-2">

            <div class="col-2 form-group">
              <label class="form-label">Gotra</label>
              <input type="text" id="gotra" name="gotra" class="form-input" placeholder="Eg: Bharadwaj" value="<%= typeof booking !== 'undefined' && booking ? booking.gotra : '' %>">
            </div>

            <div class="col-2 form-group">
              <label class="form-label">Nakshatra</label>
              <% const selectedNakshatra = typeof booking !== 'undefined' && booking ? booking.nakshatra : ''; %>
              <select id="nakshatra" name="nakshatra" class="form-input">
                <option value="">Choose Nakshatra</option>
                <option <%= selectedNakshatra === 'Ashwini' ? 'selected' : '' %>>Ashwini</option>
                <option <%= selectedNakshatra === 'Bharani' ? 'selected' : '' %>>Bharani</option>
                <option <%= selectedNakshatra === 'Krittika' ? 'selected' : '' %>>Krittika</option>
                <option <%= selectedNakshatra === 'Rohini' ? 'selected' : '' %>>Rohini</option>
                <option <%= selectedNakshatra === 'Mrigashirsha' ? 'selected' : '' %>>Mrigashirsha</option>
                <option <%= selectedNakshatra === 'Ardra' ? 'selected' : '' %>>Ardra</option>
                <option <%= selectedNakshatra === 'Punarvasu' ? 'selected' : '' %>>Punarvasu</option>
                <option <%= selectedNakshatra === 'Pushya' ? 'selected' : '' %>>Pushya</option>
                <option <%= selectedNakshatra === 'Ashlesha' ? 'selected' : '' %>>Ashlesha</option>
                <option <%= selectedNakshatra === 'Magha' ? 'selected' : '' %>>Magha</option>
                <option <%= selectedNakshatra === 'Purva Phalguni' ? 'selected' : '' %>>Purva Phalguni</option>
                <option <%= selectedNakshatra === 'Uttara Phalguni' ? 'selected' : '' %>>Uttara Phalguni</option>
                <option <%= selectedNakshatra === 'Hasta' ? 'selected' : '' %>>Hasta</option>
                <option <%= selectedNakshatra === 'Chitra' ? 'selected' : '' %>>Chitra</option>
                <option <%= selectedNakshatra === 'Swati' ? 'selected' : '' %>>Swati</option>
                <option <%= selectedNakshatra === 'Vishakha' ? 'selected' : '' %>>Vishakha</option>
                <option <%= selectedNakshatra === 'Anuradha' ? 'selected' : '' %>>Anuradha</option>
                <option <%= selectedNakshatra === 'Jyeshtha' ? 'selected' : '' %>>Jyeshtha</option>
                <option <%= selectedNakshatra === 'Mula' ? 'selected' : '' %>>Mula</option>
                <option <%= selectedNakshatra === 'Purva Ashadha' ? 'selected' : '' %>>Purva Ashadha</option>
                <option <%= selectedNakshatra === 'Uttara Ashadha' ? 'selected' : '' %>>Uttara Ashadha</option>
                <option <%= selectedNakshatra === 'Shravana' ? 'selected' : '' %>>Shravana</option>
                <option <%= selectedNakshatra === 'Dhanishta' ? 'selected' : '' %>>Dhanishta</option>
                <option <%= selectedNakshatra === 'Shatabhisha' ? 'selected' : '' %>>Shatabhisha</option>
                <option <%= selectedNakshatra === 'Purva Bhadrapada' ? 'selected' : '' %>>Purva Bhadrapada</option>
                <option <%= selectedNakshatra === 'Uttara Bhadrapada' ? 'selected' : '' %>>Uttara Bhadrapada</option>
                <option <%= selectedNakshatra === 'Revati' ? 'selected' : '' %>>Revati</option>
              </select>

            </div>

          </div>

          <!-- Special Instructions -->

          <div class="form-group">
            <label class="form-label">Special Instructions</label>

            <textarea id="special_instructions" name="special_instructions" rows="3" class="form-input"
              placeholder="Flowers, preferred timings, sankalpam details..."><%= typeof booking !== 'undefined' && booking ? booking.special_instructions : '' %></textarea>
          </div>

          <!-- Amount -->

          <div class="form-group">
            <label class="form-label">Pooja Amount</label>

            <div class="amount-box">
              <span class="amount-symbol">₹</span>
              <input type="number" id="amount" class="form-input amount-input"
                placeholder="Auto filled from pooja selection" required readonly value="<%= typeof booking !== 'undefined' && booking ? booking.amount : '' %>">
            </div>

          </div>

          <!-- Buttons -->

          <button type="submit" class="btn-book" id="submitBtn">
            Proceed To Payment →
          </button>

          <a class="cancel-link" onclick="closeModal()">Cancel Booking</a>

        </form>

      </div>
    </div>

    <script>
      if (typeof window.showAlert !== 'function') {
        window.showAlert = function (type, title, message) {
          if (window.Swal) {
            const icons = {
              success: 'success',
              error: 'error',
              warning: 'warning',
              info: 'info'
            };

            Swal.fire({
              icon: icons[type] || 'info',
              title: title || 'Notice',
              html: `<p style="font-size:15px;">${message || ''}</p>`,
              confirmButtonText: 'Okay',
              confirmButtonColor: '#bfa15f'
            });
          } else {
            alert(message || title || 'Notice');
          }
        };
      }
      function closeModal() {
        window.location.href = "/bookings/pooja";
      }

      function setAmount() {
        const select = document.getElementById("pooja_name");
        const option = select.options[select.selectedIndex];
        const price = option.getAttribute("data-price");
        document.getElementById("amount").value = price || "";
      }

      function setMinDate() {
        const dateInput = document.querySelector('[name="booking_date"]');
        if (!dateInput) return;

        const now = new Date();
        now.setDate(now.getDate() + 3); // Lock today + 2 days -> start from 3rd day

        const year = now.getFullYear();
        const month = String(now.getMonth() + 1).padStart(2, '0');
        const day = String(now.getDate()).padStart(2, '0');
        const minDate = `${year}-${month}-${day}`;

        dateInput.setAttribute("min", minDate);
      }

      // Initialize min date
      setMinDate();

      document.getElementById("poojaBookingForm").addEventListener("submit", async function (e) {

        e.preventDefault();

        const submitBtn = document.getElementById("submitBtn");
        const originalText = submitBtn.innerHTML;
        const existingBookingId = "<%= typeof booking !== 'undefined' && booking ? booking.id : '' %>";
        let redirected = false;

        submitBtn.disabled = true;
        submitBtn.innerHTML = "⏳ Processing...";

        const formData = {
          pooja_name: document.getElementById("pooja_name").value,
          booking_date: document.getElementById("booking_date").value,
          booking_time: document.getElementById("booking_time").value,
          devotee_name: document.getElementById("devotee_name").value,
          gotra: document.getElementById("gotra").value,
          nakshatra: document.getElementById("nakshatra").value,
          special_instructions: document.getElementById("special_instructions").value,
          amount: document.getElementById("amount").value
        };

        try {
          if (existingBookingId) {
             // Resume existing booking payment
                        fetch(`/bookings/pooja/continue/${existingBookingId}`, {
                            method: "GET",
                            headers: { "Content-Type": "application/json" },
                            credentials: "include"
                        })
                        .then(async (res) => {
                            const data = await res.json();
                            if (!res.ok || !data.success) {
                                throw new Error(data.message || "Failed to resume payment");
                            }
                            return data;
                        })
                        .then((data) => {
                            if (typeof RazorpayPayment !== "function") {
                                throw new Error("Payment function not loaded. Please contact support.");
                            }

                            const razorpayPayment = new RazorpayPayment({
                                key: data.key,
                                onSuccess: (result) => {
                                    redirected = true;
                                    showAlert(
                                        'success',
                                        'Booking Confirmed',
                                        'Your pooja booking has been confirmed!'
                                    );
                                    setTimeout(() => {
                                        window.location.href = "/bookings/pooja";
                                    }, 1500);
                                },
                                onFailure: (error) => {
                                    showAlert('error', 'Payment Failed', error.message || "Unknown error");
                                    submitBtn.disabled = false;
                                    submitBtn.innerHTML = originalText;
                                }
                            });

                            return razorpayPayment.initCheckout({
                                order_id: data.order_id,
                                amount: data.amount,
                                description: data.description || "Pooja booking payment",
                                payment_type: "pooja-booking"
                            });
                        })
                        .catch((err) => {
                             showAlert('error', 'Error', err.message);
                             submitBtn.disabled = false;
                             submitBtn.innerHTML = originalText;
                        });
          } else {
              await initiatePayment("pooja-booking", formData, {
                onSuccess: () => {
                  redirected = true;
                  showAlert(
                    'success',
                    'Booking Confirmed',
                    'Your pooja booking has been confirmed!'
                  );
                  setTimeout(() => {
                    window.location.href = "/bookings/pooja";
                  }, 1500);
                },
                onCancel: () => {
                  showAlert('warning', 'Payment Cancelled', 'Your booking is pending.');
                  setTimeout(() => {
                    window.location.href = "/bookings/pooja";
                  }, 500);
                },
                onFailure: (error) => {
                  showAlert('error', 'Payment Failed', error?.message || 'Payment failed.');
                  submitBtn.disabled = false;
                  submitBtn.innerHTML = originalText;
                }
              });
          }

          } catch (error) {
            submitBtn.disabled = false;
            submitBtn.innerHTML = originalText;
            showAlert('warning', 'Payment Cancelled', 'Your booking is pending.');
        } finally {

          setTimeout(() => {
            if (!redirected && !existingBookingId) { // only reset if not existing booking (async fetch handles its own reset)
              // This is a bit tricky with the async fetch inside the synchronous block for existingBookingId, better to let the catch block handle enabling button
            }
             if (!redirected && !existingBookingId) {
                 submitBtn.disabled = false;
                 submitBtn.innerHTML = originalText;
             }
          }, 2000);

        }

      });

    </script>

    <%- include('../../partials/footer') %>