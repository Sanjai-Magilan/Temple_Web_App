<% if (!Array.isArray(bookings)) { bookings=bookings ? [bookings] : []; } %>
  <%- include('../../partials/header') %>

    <style>
      /* ===== GLOBAL RESET AND SCROLL ===== */
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        overflow: hidden;
        background: linear-gradient(180deg, #7a7a7a, #5f5f5f);
      }

      /* ===== NAVBAR COLOR SAME AS HALL BOOKING ===== */
      .navbar {
        background: linear-gradient(90deg, #2c241b, #8c7b65) !important;
        border-bottom: 1px solid rgba(191, 161, 95, 0.3);
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
      }

      .navbar-brand,
      .navbar .nav-link {
        color: #f5f5f5 !important;
        font-weight: 500;
      }

      .navbar .nav-link:hover {
        color: #bfa15f !important;
      }

      .navbar .dropdown-toggle {
        color: #ffffff !important;
      }

      .navbar-toggler {
        border-color: rgba(191, 161, 95, 0.6);
      }

      .navbar-toggler-icon {
        filter: invert(1) sepia(1) saturate(4) hue-rotate(10deg);
      }

      /* ===== PAGE TITLE ===== */
      .page-title {
        font-family: 'Playfair Display', serif;
        color: #ffffff;
        font-weight: 700;
        text-shadow: 0 2px 4px rgba(0, 0, 0, .4);
      }

      /* ===== CARD ===== */
      .pooja-card {
        background: #fffaf2;
        border-radius: 15px;
        overflow: hidden;
        border: none;
        box-shadow: 0 12px 22px rgba(0, 0, 0, .30);
        transition: .3s ease;
      }

      .pooja-card:hover {
        transform: translateY(-6px);
        box-shadow: 0 18px 35px rgba(0, 0, 0, .45);
      }

      .pooja-header {
        background: linear-gradient(90deg, #c6a75d, #b1934e);
        padding: 10px 16px;
        font-size: 13px;
        font-weight: 600;
        color: #2c241b;
      }

      .card-body {
        padding: 16px 18px;
      }

      .card-title {
        font-family: 'Playfair Display', serif;
        font-size: 18px;
        font-weight: 600;
        margin-bottom: 12px;
        color: #2c241b;
      }

      .info-line {
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 13px;
        margin-bottom: 7px;
        color: #444;
      }

      .badge-pending {
        background: #ffc107;
        color: #000;
        border-radius: 6px;
        padding: 4px 10px;
        font-size: 12px;
        font-weight: 600;
      }

      .badge-confirmed {
        background: #28a745;
        color: #fff;
        border-radius: 6px;
        padding: 4px 10px;
        font-size: 12px;
        font-weight: 600;
      }

      .badge-cancelled {
        background: #dc3545;
        color: #fff;
        border-radius: 6px;
        padding: 4px 10px;
        font-size: 12px;
        font-weight: 600;
      }

          <div class="form-group">
            <label class="form-label">Select Pooja</label>
            <% const selectedPooja = typeof booking !== 'undefined' && booking ? booking.pooja_name : ''; %>
            <select id="pooja_name" class="form-input" onchange="setAmount()" required>

              <option value="">Choose Pooja</option>
              <option value="Ganapathi Homam" data-price="500" <%= selectedPooja === 'Ganapathi Homam' ? 'selected' : '' %>>Ganapathi Homam — ₹500</option>
              <option value="Satyanarayana Pooja" data-price="750" <%= selectedPooja === 'Satyanarayana Pooja' ? 'selected' : '' %>>Satyanarayana Pooja — ₹750</option>
              <option value="Navagraha Pooja" data-price="1000" <%= selectedPooja === 'Navagraha Pooja' ? 'selected' : '' %>>Navagraha Pooja — ₹1000</option>
              <option value="Abhishekam" data-price="300" <%= selectedPooja === 'Abhishekam' ? 'selected' : '' %>>Abhishekam — ₹300</option>
              <option value="Lakshmi Pooja" data-price="1200" <%= selectedPooja === 'Lakshmi Pooja' ? 'selected' : '' %>>Lakshmi Pooja — ₹1200</option>

      .btn-gold:hover {
        background: linear-gradient(90deg, #b1934e, #9f823e);
      }

      /* ===== Overlay ===== */
      .modal-overlay {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, .65);
        display: flex;
        justify-content: center;
        align-items: flex-start;
        padding: 40px 15px;
        overflow-y: auto;
        z-index: 9999;
      }

      /* ===== Modal Box (Using Hall Booking Styles) ===== */
      .booking-modal {
        background: #FFFBF5;
        border-radius: 20px;
        box-shadow: 0 30px 60px rgba(0, 0, 0, .5);
        width: 100%;
        max-width: 600px;
        border: 1px solid rgba(212, 175, 55, 0.2);
        overflow: hidden;
        position: relative;
        animation: popup .3s ease;
      }

            <div class="col-2 form-group">
              <label class="form-label">Booking Date</label>
              <% 
                  let dateVal = '';
                  if (typeof booking !== 'undefined' && booking && booking.booking_date) {
                      const d = new Date(booking.booking_date);
                      if (!isNaN(d)) {
                          const year = d.getFullYear();
                          const month = String(d.getMonth() + 1).padStart(2, '0');
                          const day = String(d.getDate()).padStart(2, '0');
                          dateVal = `${year}-${month}-${day}`;
                      } else {
                          dateVal = booking.booking_date;
                      }
                  }
              %>
              <input type="date" id="booking_date" name="booking_date" class="form-input" value="<%= dateVal %>" required>
            </div>

            <div class="col-2 form-group">
              <label class="form-label">Booking Time</label>
              <input type="time" id="booking_time" name="booking_time" class="form-input" value="<%= typeof booking !== 'undefined' && booking ? booking.booking_time : '' %>" required>
            </div>

      /* Decorative top bar removed as per request */

      .card-header-custom {
        text-align: center;
        padding: 2.5rem 2rem 1.5rem;
        background: transparent;
        position: relative;
      }

          <div class="form-group">
            <label class="form-label">Devotee Name</label>
            <input type="text" id="devotee_name" name="devotee_name" class="form-input" placeholder="Enter devotee full name" value="<%= typeof booking !== 'undefined' && booking ? booking.devotee_name : '' %>" required>
          </div>

      .header-icon {
        font-size: 1.8rem;
        color: #bfa15f;
      }

      /* Close Button */
      .close-btn {
        position: absolute;
        right: 18px;
        top: 15px;
        font-size: 22px;
        cursor: pointer;
        color: #999;
        z-index: 10;
      }

            <div class="col-2 form-group">
              <label class="form-label">Gotra</label>
              <input type="text" id="gotra" name="gotra" class="form-input" placeholder="Eg: Bharadwaj" value="<%= typeof booking !== 'undefined' && booking ? booking.gotra : '' %>">
            </div>

            <div class="col-2 form-group">
              <label class="form-label">Nakshatra</label>
              <% const selectedNakshatra = typeof booking !== 'undefined' && booking ? booking.nakshatra : ''; %>
              <select id="nakshatra" name="nakshatra" class="form-input">
                <option value="">Choose Nakshatra</option>
                <option <%= selectedNakshatra === 'Ashwini' ? 'selected' : '' %>>Ashwini</option>
                <option <%= selectedNakshatra === 'Bharani' ? 'selected' : '' %>>Bharani</option>
                <option <%= selectedNakshatra === 'Krittika' ? 'selected' : '' %>>Krittika</option>
                <option <%= selectedNakshatra === 'Rohini' ? 'selected' : '' %>>Rohini</option>
                <option <%= selectedNakshatra === 'Mrigashirsha' ? 'selected' : '' %>>Mrigashirsha</option>
                <option <%= selectedNakshatra === 'Ardra' ? 'selected' : '' %>>Ardra</option>
                <option <%= selectedNakshatra === 'Punarvasu' ? 'selected' : '' %>>Punarvasu</option>
                <option <%= selectedNakshatra === 'Pushya' ? 'selected' : '' %>>Pushya</option>
                <option <%= selectedNakshatra === 'Ashlesha' ? 'selected' : '' %>>Ashlesha</option>
                <option <%= selectedNakshatra === 'Magha' ? 'selected' : '' %>>Magha</option>
                <option <%= selectedNakshatra === 'Purva Phalguni' ? 'selected' : '' %>>Purva Phalguni</option>
                <option <%= selectedNakshatra === 'Uttara Phalguni' ? 'selected' : '' %>>Uttara Phalguni</option>
                <option <%= selectedNakshatra === 'Hasta' ? 'selected' : '' %>>Hasta</option>
                <option <%= selectedNakshatra === 'Chitra' ? 'selected' : '' %>>Chitra</option>
                <option <%= selectedNakshatra === 'Swati' ? 'selected' : '' %>>Swati</option>
                <option <%= selectedNakshatra === 'Vishakha' ? 'selected' : '' %>>Vishakha</option>
                <option <%= selectedNakshatra === 'Anuradha' ? 'selected' : '' %>>Anuradha</option>
                <option <%= selectedNakshatra === 'Jyeshtha' ? 'selected' : '' %>>Jyeshtha</option>
                <option <%= selectedNakshatra === 'Mula' ? 'selected' : '' %>>Mula</option>
                <option <%= selectedNakshatra === 'Purva Ashadha' ? 'selected' : '' %>>Purva Ashadha</option>
                <option <%= selectedNakshatra === 'Uttara Ashadha' ? 'selected' : '' %>>Uttara Ashadha</option>
                <option <%= selectedNakshatra === 'Shravana' ? 'selected' : '' %>>Shravana</option>
                <option <%= selectedNakshatra === 'Dhanishta' ? 'selected' : '' %>>Dhanishta</option>
                <option <%= selectedNakshatra === 'Shatabhisha' ? 'selected' : '' %>>Shatabhisha</option>
                <option <%= selectedNakshatra === 'Purva Bhadrapada' ? 'selected' : '' %>>Purva Bhadrapada</option>
                <option <%= selectedNakshatra === 'Uttara Bhadrapada' ? 'selected' : '' %>>Uttara Bhadrapada</option>
                <option <%= selectedNakshatra === 'Revati' ? 'selected' : '' %>>Revati</option>
              </select>

      .booking-subtitle {
        color: #8c7b65;
        font-family: 'Inter', sans-serif;
        font-size: 0.95rem;
        line-height: 1.5;
      }

      /* Form Styles */
      .card-body-custom {
        padding: 0 2.5rem 3rem;
      }

      .form-group-custom {
        margin-bottom: 1.5rem;
      }

      .form-label-custom {
        display: block;
        font-weight: 500;
        color: #5d5145;
        font-size: 0.85rem;
        margin-bottom: 0.5rem;
        letter-spacing: 0.5px;
        text-transform: uppercase;
      }

            <textarea id="special_instructions" name="special_instructions" rows="3" class="form-input"
              placeholder="Flowers, preferred timings, sankalpam details..."><%= typeof booking !== 'undefined' && booking ? booking.special_instructions : '' %></textarea>
          </div>

      .form-control-custom:focus,
      .form-select-custom:focus {
        border-color: #bfa15f;
        outline: 0;
        box-shadow: 0 0 0 4px rgba(191, 161, 95, 0.1);
      }

      .form-control-custom::placeholder {
        color: #b0a69a;
      }

            <div class="amount-box">
              <span class="amount-symbol">₹</span>
              <input type="number" id="amount" class="form-input amount-input"
                placeholder="Auto filled from pooja selection" required readonly value="<%= typeof booking !== 'undefined' && booking ? booking.amount : '' %>">
            </div>

      .form-col {
        flex: 1;
      }

      .form-col .form-group-custom {
        margin-bottom: 0;
      }

      /* Amount Input specifically */
      .amount-wrapper {
        position: relative;
      }

      .amount-symbol {
        position: absolute;
        left: 1rem;
        top: 50%;
        transform: translateY(-50%);
        color: #5d5145;
        font-weight: 600;
      }

      .amount-input {
        padding-left: 2rem;
        font-family: 'Playfair Display', serif;
        font-weight: 700;
        color: #bfa15f;
        font-size: 1.2rem;
      }

      .amount-input::-webkit-inner-spin-button,
      .amount-input::-webkit-outer-spin-button {
        -webkit-appearance: none;
        margin: 0;
      }

      .amount-input {
        -moz-appearance: textfield;
        appearance: textfield;
      }

      /* Buttons */
      .btn-submit-custom {
        display: block;
        width: 100%;
        padding: 1rem;
        font-size: 1rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: #fff;
        background-color: #bfa15f;
        border: none;
        border-radius: 10px;
        cursor: pointer;
        transition: all 0.3s ease;
        margin-top: 1rem;
        font-family: 'Inter', sans-serif;
      }

      .btn-submit-custom:hover {
        background-color: #a88b4d;
        transform: translateY(-2px);
        box-shadow: 0 10px 20px rgba(168, 139, 77, 0.2);
      }

      .btn-submit-custom:disabled {
        background-color: #dcdcdc;
        cursor: not-allowed;
        transform: none;
      }

      .btn-cancel-custom {
        display: block;
        width: 100%;
        text-align: center;
        margin-top: 1rem;
        color: #8c7b65;
        text-decoration: none;
        font-size: 0.9rem;
        font-weight: 500;
        transition: color 0.2s;
        cursor: pointer;
      }

      .btn-cancel-custom:hover {
        color: #5d5145;
      }

      /* Mobile Responsiveness */
      @media (max-width: 768px) {
        .card-header-custom {
          padding: 2rem 1.5rem 1rem;
        }

        .card-body-custom {
          padding: 0 1.5rem 2.5rem;
        }

        .form-row {
          flex-direction: column;
          gap: 1.5rem;
        }

        const submitBtn = document.getElementById("submitBtn");
        const originalText = submitBtn.innerHTML;
        const existingBookingId = "<%= typeof booking !== 'undefined' && booking ? booking.id : '' %>";
        let redirected = false;

    <%- include('../../partials/navbar', { user: typeof user !=='undefined' ? user : null }) %>

        const formData = {
          pooja_name: document.getElementById("pooja_name").value,
          booking_date: document.getElementById("booking_date").value,
          booking_time: document.getElementById("booking_time").value,
          devotee_name: document.getElementById("devotee_name").value,
          gotra: document.getElementById("gotra").value,
          nakshatra: document.getElementById("nakshatra").value,
          special_instructions: document.getElementById("special_instructions").value,
          amount: document.getElementById("amount").value
        };

        try {
          if (existingBookingId) {
             // Resume existing booking payment
                        fetch(`/bookings/pooja/continue/${existingBookingId}`, {
                            method: "GET",
                            headers: { "Content-Type": "application/json" },
                            credentials: "include"
                        })
                        .then(async (res) => {
                            const data = await res.json();
                            if (!res.ok || !data.success) {
                                throw new Error(data.message || "Failed to resume payment");
                            }
                            return data;
                        })
                        .then((data) => {
                            if (typeof RazorpayPayment !== "function") {
                                throw new Error("Payment function not loaded. Please contact support.");
                            }

                            const razorpayPayment = new RazorpayPayment({
                                key: data.key,
                                onSuccess: (result) => {
                                    redirected = true;
                                    showAlert(
                                        'success',
                                        'Booking Confirmed',
                                        'Your pooja booking has been confirmed!'
                                    );
                                    setTimeout(() => {
                                        window.location.href = "/bookings/pooja";
                                    }, 1500);
                                },
                                onFailure: (error) => {
                                    showAlert('error', 'Payment Failed', error.message || "Unknown error");
                                    submitBtn.disabled = false;
                                    submitBtn.innerHTML = originalText;
                                }
                            });

                            return razorpayPayment.initCheckout({
                                order_id: data.order_id,
                                amount: data.amount,
                                description: data.description || "Pooja booking payment",
                                payment_type: "pooja-booking"
                            });
                        })
                        .catch((err) => {
                             showAlert('error', 'Error', err.message);
                             submitBtn.disabled = false;
                             submitBtn.innerHTML = originalText;
                        });
          } else {
              await initiatePayment("pooja-booking", formData, {
                onSuccess: () => {
                  redirected = true;
                  showAlert(
                    'success',
                    'Booking Confirmed',
                    'Your pooja booking has been confirmed!'
                  );
                  setTimeout(() => {
                    window.location.href = "/bookings/pooja";
                  }, 1500);
                },
                onCancel: () => {
                  showAlert('warning', 'Payment Cancelled', 'Your booking is pending.');
                  setTimeout(() => {
                    window.location.href = "/bookings/pooja";
                  }, 500);
                },
                onFailure: (error) => {
                  showAlert('error', 'Payment Failed', error?.message || 'Payment failed.');
                  submitBtn.disabled = false;
                  submitBtn.innerHTML = originalText;
                }
              });
          }

          } catch (error) {
            submitBtn.disabled = false;
            submitBtn.innerHTML = originalText;
            showAlert('warning', 'Payment Cancelled', 'Your booking is pending.');
        } finally {

          setTimeout(() => {
            if (!redirected && !existingBookingId) { // only reset if not existing booking (async fetch handles its own reset)
              // This is a bit tricky with the async fetch inside the synchronous block for existingBookingId, better to let the catch block handle enabling button
            }
             if (!redirected && !existingBookingId) {
                 submitBtn.disabled = false;
                 submitBtn.innerHTML = originalText;
             }
          }, 2000);

        function closeModal() {
          window.location.href = "/bookings/pooja";
        }

        function setAmount() {
          const select = document.getElementById("pooja_name");
          const option = select.options[select.selectedIndex];
          const price = option ? option.getAttribute("data-price") : "";
          document.getElementById("amount").value = price || "";
        }

        function setMinDate() {
          const dateInput = document.querySelector('[name="booking_date"]');
          if (!dateInput) return;
          const now = new Date();
          now.setDate(now.getDate() + 3);
          const year = now.getFullYear();
          const month = String(now.getMonth() + 1).padStart(2, '0');
          const day = String(now.getDate()).padStart(2, '0');
          dateInput.setAttribute("min", `${year}-${month}-${day}`);
        }

        setMinDate();

        document.getElementById("poojaBookingForm").addEventListener("submit", async function (e) {
          e.preventDefault();
          const submitBtn = document.getElementById("submitBtn");
          const originalText = submitBtn.innerHTML;
          let redirected = false;

          submitBtn.disabled = true;
          submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Processing...';

          const formData = {
            pooja_name: document.getElementById("pooja_name").value,
            booking_date: document.querySelector('[name="booking_date"]').value,
            booking_time: document.querySelector('[name="booking_time"]').value,
            devotee_name: document.querySelector('[name="devotee_name"]').value,
            gotra: document.querySelector('[name="gotra"]').value,
            nakshatra: document.querySelector('[name="nakshatra"]').value,
            special_instructions: document.querySelector('[name="special_instructions"]').value,
            amount: document.getElementById("amount").value
          };

          try {
            if (typeof initiatePayment === 'function') {
              await initiatePayment("pooja-booking", formData, {
                onSuccess: () => {
                  redirected = true;
                  showAlert('success', 'Booking Confirmed', 'Your pooja booking has been confirmed!');
                  setTimeout(() => { window.location.href = "/bookings/pooja"; }, 1500);
                },
                onCancel: () => {
                  showAlert('warning', 'Payment Cancelled', 'Your booking is pending.');
                  setTimeout(() => { window.location.href = "/bookings/pooja"; }, 500);
                },
                onFailure: (error) => {
                  showAlert('error', 'Payment Failed', error?.message || 'Payment failed.');
                  submitBtn.disabled = false;
                  submitBtn.innerHTML = originalText;
                }
              });
            } else {
              console.warn("initiatePayment is not defined yet.");
              setTimeout(() => {
                submitBtn.disabled = false;
                submitBtn.innerHTML = originalText;
              }, 2000);
            }
          } catch (error) {
            submitBtn.disabled = false;
            submitBtn.innerHTML = originalText;
            showAlert('warning', 'Payment Cancelled', 'Your booking is pending.');
          } finally {
            setTimeout(() => {
              if (!redirected) {
                submitBtn.disabled = false;
                submitBtn.innerHTML = originalText;
              }
            }, 2000);
          }
        });
      </script>

      <%- include('../../partials/footer') %>