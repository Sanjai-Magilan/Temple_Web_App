<%- include('../../partials/header') %>

<style>
@import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=Poppins:wght@400;500;600&display=swap');

/* Overlay */

.modal-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,.65);
  backdrop-filter: blur(4px);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
}

/* Modal */

.booking-modal {
  width: 95%;
  max-width: 640px;
  background: #fffaf3;
  padding: 35px 40px;
  border-radius: 22px;
  box-shadow: 0 30px 60px rgba(0,0,0,.5);
  position: relative;
  animation: popup .3s ease;
}

@keyframes popup {
  from { transform: scale(.9); opacity:0; }
  to { transform: scale(1); opacity:1; }
}

/* Close Button */

.close-btn {
  position: absolute;
  right: 18px;
  top: 15px;
  font-size: 22px;
  cursor: pointer;
  color: #999;
}

.close-btn:hover {
  color: #333;
}

/* Header */

.booking-title {
  text-align: center;
  font-family: 'Playfair Display', serif;
  font-size: 30px;
  font-weight: 700;
}

.booking-subtitle {
  text-align: center;
  font-size: 14px;
  color: #8c7b65;
  margin-bottom: 25px;
}

/* Form */

.form-group {
  margin-bottom: 18px;
}

.form-label {
  font-size: 13px;
  font-weight: 600;
  color: #5d5145;
  margin-bottom: 7px;
  display: block;
}

.form-input {
  width: 100%;
  padding: 13px 14px;
  border-radius: 12px;
  border: 1px solid #ddd;
  font-size: 14px;
}

.form-input:focus {
  outline: none;
  border-color: #bfa15f;
  box-shadow: 0 0 0 4px rgba(191,161,95,.15);
}

/* Two Column */

.row-2 {
  display: flex;
  gap: 16px;
}

.col-2 {
  flex: 1;
}

/* Amount */

.amount-box {
  position: relative;
}

.amount-symbol {
  position: absolute;
  left: 13px;
  top: 50%;
  transform: translateY(-50%);
  font-weight: bold;
  color: #bfa15f;
}

.amount-input {
  padding-left: 32px;
  font-weight: 600;
  color: #bfa15f;
}

/* Payment Button */

.btn-book {
  width: 100%;
  padding: 14px;
  border-radius: 12px;
  border: none;
  background: linear-gradient(135deg,#bfa15f,#a88b4d);
  color: white;
  font-size: 15px;
  font-weight: 600;
  margin-top: 10px;
  cursor: pointer;
}

.btn-book:hover {
  transform: translateY(-2px);
  box-shadow: 0 10px 20px rgba(168,139,77,.35);
}

/* Cancel Link */

.cancel-link {
  display: block;
  text-align: center;
  margin-top: 14px;
  font-size: 14px;
  font-weight: 500;
  color: #888;
  cursor: pointer;
  text-decoration: none;
}

.cancel-link:hover {
  color: #bfa15f;
  text-decoration: underline;
}

/* Mobile */

@media(max-width:600px) {
  .row-2 {
    flex-direction: column;
  }

  .booking-modal {
    padding: 25px 20px;
  }
}
</style>

<%- include('../../partials/navbar', { user: typeof user !== 'undefined' ? user : null }) %>

<!-- POPUP -->

<div class="modal-overlay">

<div class="booking-modal">

<div class="close-btn" onclick="closeModal()">✖</div>

<h2 class="booking-title">Book a Pooja</h2>
<p class="booking-subtitle">A Guide to Daily Rituals and Divine Connection</p>

<form method="POST" action="/bookings/pooja/new">

<!-- Pooja -->

<div class="form-group">
<label class="form-label">Select Pooja</label>

<select id="pooja_name" name="pooja_name" class="form-input" onchange="setAmount()" required>
<option value="">Choose Pooja</option>
<option value="Ganapathi Homam" data-price="500">Ganapathi Homam — ₹500</option>
<option value="Satyanarayana Pooja" data-price="750">Satyanarayana Pooja — ₹750</option>
<option value="Navagraha Pooja" data-price="1000">Navagraha Pooja — ₹1000</option>
<option value="Abhishekam" data-price="300">Abhishekam — ₹300</option>
<option value="Lakshmi Pooja" data-price="1200">Lakshmi Pooja — ₹1200</option>
</select>
</div>

<!-- Date & Time -->

<div class="row-2">

<div class="col-2 form-group">
<label class="form-label">Booking Date</label>
<input type="date" name="booking_date" class="form-input" required>
</div>

<div class="col-2 form-group">
<label class="form-label">Booking Time</label>
<input type="time" name="booking_time" class="form-input" required>
</div>

</div>

<!-- Devotee -->

<div class="form-group">
<label class="form-label">Devotee Name</label>
<input type="text" name="devotee_name" class="form-input"
placeholder="Enter devotee full name" required>
</div>

<!-- Gotra + Nakshatra -->

<div class="row-2">

<div class="col-2 form-group">
<label class="form-label">Gotra</label>
<input type="text" name="gotra" class="form-input"
placeholder="Eg: Bharadwaj">
</div>

<div class="col-2 form-group">
<label class="form-label">Nakshatra</label>

<select name="nakshatra" class="form-input">

<option value="">Choose Nakshatra</option>

<option>Ashwini</option>
<option>Bharani</option>
<option>Krittika</option>
<option>Rohini</option>
<option>Mrigashirsha</option>
<option>Ardra</option>
<option>Punarvasu</option>
<option>Pushya</option>
<option>Ashlesha</option>
<option>Magha</option>
<option>Purva Phalguni</option>
<option>Uttara Phalguni</option>
<option>Hasta</option>
<option>Chitra</option>
<option>Swati</option>
<option>Vishakha</option>
<option>Anuradha</option>
<option>Jyeshtha</option>
<option>Mula</option>
<option>Purva Ashadha</option>
<option>Uttara Ashadha</option>
<option>Shravana</option>
<option>Dhanishta</option>
<option>Shatabhisha</option>
<option>Purva Bhadrapada</option>
<option>Uttara Bhadrapada</option>
<option>Revati</option>

</select>
</div>

</div>

<!-- Instructions -->

<div class="form-group">
<label class="form-label">Special Instructions</label>

<textarea name="special_instructions"
rows="3"
class="form-input"
placeholder="Flowers, timings, sankalpam etc"></textarea>
</div>

<!-- Amount -->

<div class="form-group">
<label class="form-label">Pooja Amount</label>

<div class="amount-box">
<span class="amount-symbol">₹</span>
<input type="number"
id="amount"
name="amount"
class="form-input amount-input"
placeholder="0.00"
required>
</div>

</div>

<!-- Buttons -->

<button type="submit" class="btn-book">
Proceed To Payment →
</button>

<a class="cancel-link" onclick="closeModal()">
Cancel Booking
</a>

</form>

</div>
</div>

<script>

function closeModal(){
  window.location.href="/bookings/pooja";
}

function setAmount() {
  const select = document.getElementById("pooja_name");
  const option = select.options[select.selectedIndex];
  const price = option.getAttribute("data-price");
  document.getElementById("amount").value = price || "";
}

</script>

<%- include('../../partials/footer') %>
