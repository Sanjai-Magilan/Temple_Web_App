<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard | Temple Management</title>
    <link rel="stylesheet" href="/css/dashboard.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>

<body>

    <%- include('../partials/header') %>
        <%- include('../partials/navbar', { user: typeof user !=='undefined' ? user : null }) %>

            <main class="container">
                <h1 class="welcome-text">Welcome <%= user && user.first_name ? user.first_name : '' %>
                </h1>

                <!-- Stats Grid -->
                <div class="stats-grid admin-stats">
                    <div class="stat-card">
                        <div class="stat-label">Total Users</div>
                        <div class="stat-value">
                            <%= typeof totalUsers !=='undefined' ? totalUsers : 0 %>
                        </div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-label">Total Donations</div>
                        <div class="stat-value">
                            <%= typeof totalDonations !=='undefined' ? totalDonations : 0 %>
                        </div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-label">Total Bookings</div>
                        <div class="stat-value">
                            <%= typeof totalBookings !=='undefined' ? totalBookings : 0 %>
                        </div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-label">Total Revenue</div>
                        <div class="stat-value">
                            ₹<%= typeof totalRevenue !=='undefined' ? totalRevenue.toLocaleString('en-IN') : '0' %>
                        </div>
                    </div>
                </div>

                <hr class="dashboard-divider">

                <h3 class="section-title">Quick Actions</h3>
                <div class="quick-actions-grid">
                    <a href="/admin/users" style="text-decoration: none; color: inherit; display: block;">
                        <div class="quick-action-card">
                            <i class="fas fa-users"></i>
                            <div class="quick-action-label">Manage Users</div>
                        </div>
                    </a>
                    <a href="/admin/bookings" style="text-decoration: none; color: inherit; display: block;">
                        <div class="quick-action-card">
                            <i class="fas fa-calendar-check"></i>
                            <div class="quick-action-label">Manage Bookings</div>
                        </div>
                    </a>
                    <a href="/admin/donations" style="text-decoration: none; color: inherit; display: block;">
                        <div class="quick-action-card">
                            <i class="fas fa-hand-holding-heart"></i>
                            <div class="quick-action-label">View Donations</div>
                        </div>
                    </a>
                    <a href="/admin/payments" style="text-decoration: none; color: inherit; display: block;">
                        <div class="quick-action-card">
                            <i class="fas fa-history"></i>
                            <div class="quick-action-label">Payment History</div>
                        </div>
                    </a>
                </div>

                <hr class="dashboard-divider">

                <!-- Details Grid -->
                <div class="details-grid">

                    <!-- Card 3: Post Temple Updates -->
                    <div class="detail-card">
                        <h3>Post Updates / Special Days</h3>
                        <div class="detail-content">
                            <form action="/admin/news/new" method="POST" id="newsForm">
                                <div class="mb-3">
                                    <label for="title" class="form-label text-muted small"
                                        style="display:block; margin-bottom:5px;">Title</label>
                                    <input type="text" class="form-control form-control-sm" id="title" name="title"
                                        required placeholder="e.g. Special Deeparadhana"
                                        style="width:100%; padding:8px; border:1px solid #ddd; border-radius:4px;">
                                </div>
                                <div class="row g-2 mb-3" style="display:flex; gap:10px; margin-top:10px;">
                                    <div class="col-6" style="flex:1;">
                                        <label for="published_date" class="form-label text-muted small"
                                            style="display:block; margin-bottom:5px;">Date</label>
                                        <input type="date" class="form-control form-control-sm" id="published_date"
                                            name="published_date"
                                            style="width:100%; padding:8px; border:1px solid #ddd; border-radius:4px;">
                                    </div>
                                    <div class="col-6" style="flex:1;">
                                        <label for="published_time" class="form-label text-muted small"
                                            style="display:block; margin-bottom:5px;">Time</label>
                                        <input type="time" class="form-control form-control-sm" id="published_time"
                                            name="published_time"
                                            style="width:100%; padding:8px; border:1px solid #ddd; border-radius:4px;">
                                    </div>
                                </div>
                                <div class="mb-3" style="margin-top:10px;">
                                    <label for="content" class="form-label text-muted small"
                                        style="display:block; margin-bottom:5px;">Details</label>
                                    <textarea class="form-control form-control-sm" id="content" name="content" rows="3"
                                        required placeholder="Enter details here..."
                                        style="width:100%; padding:8px; border:1px solid #ddd; border-radius:4px;"></textarea>
                                </div>
                                <button type="submit" class="btn btn-primary btn-sm w-100"
                                    style="margin-top:15px; width:100%; padding:10px; background:#bfa15f; color:white; border:none; border-radius:4px; cursor:pointer;">Post
                                    Update</button>
                            </form>
                        </div>
                    </div>

                    <!-- Card 4: Upcoming Temple Events (Admin View) -->
                    <div class="detail-card">
                        <h3>Upcoming Temple Events</h3>
                        <div class="detail-content">
                            <% if (typeof latestNews !=='undefined' && latestNews.length> 0) { %>
                                <div class="booking-list">
                                    <% latestNews.forEach(news=> { %>
                                        <div class="booking-item">
                                            <div class="booking-info">
                                                <span class="booking-id" style="font-weight:bold; color:#bfa15f;">
                                                    <%= news.title %>
                                                </span>
                                                <span class="booking-date">
                                                    <%= new Date(news.published_at ||
                                                        news.created_at).toLocaleDateString('en-IN', { day: 'numeric' ,
                                                        month: 'short' }) %>
                                                        <% if (news.content) { %> | <%= news.content.substring(0, 30) %>
                                                                ... <% } %>
                                                </span>
                                            </div>
                                            <div class="booking-status" style="display:flex; gap:5px;">
                                                <form action="/admin/news/delete/<%= news.id %>" method="POST"
                                                    onsubmit="return confirm('Are you sure?');">
                                                    <button type="submit"
                                                        style="background:none; border:none; color:red; cursor:pointer;">
                                                        <i class="fas fa-trash"></i>
                                                    </button>
                                                </form>
                                            </div>
                                        </div>
                                        <% }); %>
                                </div>
                                <% } else { %>
                                    <div class="detail-content"
                                        style="display: flex; align-items: center; justify-content: center;">
                                        <p style="color: #777;">No events posted yet.</p>
                                    </div>
                                    <% } %>
                        </div>
                        <div class="detail-footer">
                            <span class="footer-text">These appear on User Dashboard</span>
                        </div>
                    </div>

                </div>
            </main>

            <%- include('../partials/footer') %>

</body>

</html>