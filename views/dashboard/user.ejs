<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard | Temple Management</title>
    <link rel="stylesheet" href="/css/dashboard.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>

<body>

    <%- include('../partials/header') %>
        <%- include('../partials/navbar', { user: typeof user !=='undefined' ? user : null }) %>

            <main class="container">
                <h1 class="welcome-text">Welcome, <%= user && user.first_name ? user.first_name : 'Devotee' %>
                </h1>

                <div class="stats-grid">

                    <div class="stat-card">
                        <div class="stat-label">Upcoming Pooja</div>
                        <div class="stat-value">
                            <%= upcomingPooja ? upcomingPooja.pooja_name : "None" %>
                        </div>
                    </div>

                    <div class="stat-card">
                        <div class="stat-label">Upcoming Event</div>
                        <div class="stat-value">
                            <%= upcomingHall ? upcomingHall.hall_name : '-' %>
                        </div>
                    </div>


                    <div class="stat-card">
                        <div class="stat-label">Total Donation</div>
                        <div class="stat-value">
                            ₹<%= totalDonation.toLocaleString('en-IN') %>
                        </div>
                    </div>

                    <div class="stat-card">
                        <div class="stat-label">Family Members</div>
                        <div class="stat-value">
                            <%= familyCount %> Members
                        </div>
                    </div>
                </div>

                <div class="details-grid">

                    <div class="detail-card">
                        <h3>Upcoming Pooja Details</h3>

                        <% if (upcomingPooja) { %>
                            <div class="detail-content">
                                <div class="detail-row">
                                    <span class="detail-label">Pooja Name</span>
                                    <span class="detail-value">
                                        <%= upcomingPooja.pooja_name %>
                                    </span>
                                </div>
                                <div class="detail-row">
                                    <span class="detail-label">Date</span>
                                    <span class="detail-value">
                                        <%= new Date(upcomingPooja.booking_date).toLocaleDateString('en-IN', {
                                            weekday: 'long' , day: 'numeric' , month: 'long' }) %>
                                    </span>
                                </div>
                                <div class="detail-row">
                                    <span class="detail-label">Time</span>
                                    <span class="detail-value">
                                        <%= upcomingPooja.booking_time || '6:00 AM' %>
                                    </span>
                                </div>
                            </div>
                            <div class="detail-note">Please arrive 15 minutes before the scheduled time. Dress code
                                applies.</div>
                            <% } else { %>
                                <div class="detail-content"
                                    style="display: flex; align-items: center; justify-content: center;">
                                    <p style="color: #777;">You have no upcoming poojas scheduled.</p>
                                </div>
                                <div class="detail-note">Visit the booking page to schedule a service.</div>
                                <% } %>

                                    <div class="detail-footer">
                                        <span class="footer-text">Next scheduled service</span>
                                        <a href="/bookings/pooja" class="view-link">View Details</a>
                                    </div>
                    </div>

                    <div class="detail-card">
                        <h3>Upcoming Hall Booking Details</h3>

                        <% if (upcomingHall) { %>
                            <div class="detail-content">
                                <div class="detail-row">
                                    <span class="detail-label">Hall Name</span>
                                    <span class="detail-value">
                                        <%= upcomingHall.hall_name %>
                                    </span>
                                </div>
                                <div class="detail-row">
                                    <span class="detail-label">Date</span>
                                    <span class="detail-value">
                                        <%= new Date(upcomingHall.booking_date).toLocaleDateString('en-IN', {
                                            weekday: 'long' , day: 'numeric' , month: 'long' }) %>
                                    </span>
                                </div>
                                <div class="detail-row">
                                    <span class="detail-label">Time</span>
                                    <span class="detail-value">
                                        <%= upcomingHall.start_time %> - <%= upcomingHall.end_time %>
                                    </span>
                                </div>
                            </div>
                            <div class="detail-note">Please contact administration for any changes.</div>
                            <% } else { %>
                                <div class="detail-content"
                                    style="display: flex; align-items: center; justify-content: center;">
                                    <p style="color: #777;">You have no upcoming hall bookings.</p>
                                </div>
                                <div class="detail-note">Check availability to book a hall.</div>
                                <% } %>

                                    <div class="detail-footer">
                                        <span class="footer-text">Next scheduled event</span>
                                        <a href="/bookings/hall" class="view-link">View Details</a>
                                    </div>
                    </div>

                    <div class="detail-card">
                        <h3>My Family</h3>

                        <% if (familySummary && familySummary.family) { %>
                            <div class="detail-content">
                                <div class="detail-row">
                                    <span class="detail-label">Family ID</span>
                                    <span class="detail-value"><%= familySummary.family.family_uid || '-' %></span>
                                </div>
                                <div class="detail-row">
                                    <span class="detail-label">Family Name</span>
                                    <span class="detail-value"><%= familySummary.family.family_name %></span>
                                </div>
                                <div class="detail-row">
                                    <span class="detail-label">Members</span>
                                    <span class="detail-value"><%= familySummary.member_count %></span>
                                </div>
                                <% if (familySummary.my_view && familySummary.my_view.spouse) { %>
                                    <div class="detail-row">
                                        <span class="detail-label">Spouse</span>
                                        <span class="detail-value"><%= familySummary.my_view.spouse.member_name %></span>
                                    </div>
                                <% } %>
                                <div class="detail-row">
                                    <span class="detail-label">Children</span>
                                    <span class="detail-value"><%= familySummary.my_view ? familySummary.my_view.children.length : 0 %></span>
                                </div>
                            </div>
                            <div class="detail-footer">
                                <span class="footer-text">View complete family details</span>
                                <a href="/family" class="view-link">Open Family</a>
                            </div>
                        <% } else { %>
                            <div class="detail-content" style="display: flex; align-items: center; justify-content: center;">
                                <p style="color: #777;">No family details available.</p>
                            </div>
                            <div class="detail-footer">
                                <a href="/family/setup" class="view-link">Setup Family</a>
                            </div>
                        <% } %>
                    </div>

                </div>
                
            </main>

            <%- include('../partials/footer') %>

</body>

</html>