<%- include('../partials/header') %>
<%- include('../partials/navbar', { user: typeof user !== 'undefined' ? user : null }) %>

<div class="container mt-4 mb-5">
    <div class="row">
        <div class="col-12">
            <h2 class="mb-4">
                <i class="bi bi-speedometer2"></i> Dashboard
                <% if (typeof user !== 'undefined' && user) { %>
                    <small class="text-muted">Welcome, <%= user.first_name %>!</small>
                <% } %>
            </h2>
        </div>
    </div>

    <!-- Stats Cards -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="card text-center border-primary">
                <div class="card-body">
                    <i class="bi bi-heart-fill text-danger fs-1"></i>
                    <h5 class="card-title mt-2"><%= typeof donationsCount !== 'undefined' ? donationsCount : 0 %></h5>
                    <p class="card-text text-muted small">Donations</p>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card text-center border-success">
                <div class="card-body">
                    <i class="bi bi-calendar-check-fill text-success fs-1"></i>
                    <h5 class="card-title mt-2"><%= typeof hallBookingsCount !== 'undefined' ? hallBookingsCount : 0 %></h5>
                    <p class="card-text text-muted small">Hall Bookings</p>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card text-center border-warning">
                <div class="card-body">
                    <i class="bi bi-stars text-warning fs-1"></i>
                    <h5 class="card-title mt-2"><%= typeof poojaBookingsCount !== 'undefined' ? poojaBookingsCount : 0 %></h5>
                    <p class="card-text text-muted small">Pooja Bookings</p>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card text-center border-info">
                <div class="card-body">
                    <i class="bi bi-wallet2 text-info fs-1"></i>
                    <h5 class="card-title mt-2">₹<%= typeof totalSpent !== 'undefined' ? totalSpent.toLocaleString() : '0' %></h5>
                    <p class="card-text text-muted small">Total Spent</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="bi bi-lightning-charge"></i> Quick Actions</h5>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-6 col-md-3">
                            <a href="/donations/new" class="btn btn-outline-danger w-100">
                                <i class="bi bi-heart"></i><br>
                                <small>Make Donation</small>
                            </a>
                        </div>
                        <div class="col-6 col-md-3">
                            <a href="/bookings/hall/new" class="btn btn-outline-success w-100">
                                <i class="bi bi-calendar-plus"></i><br>
                                <small>Book Hall</small>
                            </a>
                        </div>
                        <div class="col-6 col-md-3">
                            <a href="/bookings/pooja/new" class="btn btn-outline-warning w-100">
                                <i class="bi bi-star"></i><br>
                                <small>Book Pooja</small>
                            </a>
                        </div>
                        <div class="col-6 col-md-3">
                            <a href="/profile" class="btn btn-outline-info w-100">
                                <i class="bi bi-person"></i><br>
                                <small>My Profile</small>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Activity -->
    <div class="row">
        <div class="col-12 col-lg-6 mb-3 mb-lg-0">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0"><i class="bi bi-clock-history"></i> Recent Donations</h5>
                </div>
                <div class="card-body">
                    <% if (typeof recentDonations !== 'undefined' && recentDonations.length > 0) { %>
                        <div class="list-group list-group-flush">
                            <% recentDonations.forEach(donation => { %>
                                <div class="list-group-item px-0">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div>
                                            <h6 class="mb-1">₹<%= donation.amount.toLocaleString() %></h6>
                                            <small class="text-muted"><%= donation.donation_type %> - <%= new Date(donation.created_at).toLocaleDateString() %></small>
                                        </div>
                                        <span class="badge bg-<%= donation.payment_status === 'completed' ? 'success' : 'warning' %>">
                                            <%= donation.payment_status || 'pending' %>
                                        </span>
                                    </div>
                                </div>
                            <% }); %>
                        </div>
                        <a href="/donations" class="btn btn-sm btn-outline-primary mt-3 w-100">View All</a>
                    <% } else { %>
                        <p class="text-muted text-center mb-0">No donations yet</p>
                        <a href="/donations/new" class="btn btn-sm btn-primary mt-3 w-100">Make Your First Donation</a>
                    <% } %>
                </div>
            </div>
        </div>
        <div class="col-12 col-lg-6">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0"><i class="bi bi-calendar-event"></i> Recent Bookings</h5>
                </div>
                <div class="card-body">
                    <% if (typeof recentBookings !== 'undefined' && recentBookings.length > 0) { %>
                        <div class="list-group list-group-flush">
                            <% recentBookings.forEach(booking => { %>
                                <div class="list-group-item px-0">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div>
                                            <h6 class="mb-1"><%= booking.booking_number || booking.pooja_name || booking.hall_name %></h6>
                                            <small class="text-muted"><%= new Date(booking.booking_date).toLocaleDateString() %></small>
                                        </div>
                                        <span class="badge bg-<%= booking.status === 'confirmed' ? 'success' : booking.status === 'pending' ? 'warning' : 'secondary' %>">
                                            <%= booking.status %>
                                        </span>
                                    </div>
                                </div>
                            <% }); %>
                        </div>
                        <div class="mt-3">
                            <a href="/bookings/hall" class="btn btn-sm btn-outline-success me-2">Hall Bookings</a>
                            <a href="/bookings/pooja" class="btn btn-sm btn-outline-warning">Pooja Bookings</a>
                        </div>
                    <% } else { %>
                        <p class="text-muted text-center mb-0">No bookings yet</p>
                        <div class="mt-3">
                            <a href="/bookings/hall/new" class="btn btn-sm btn-success me-2">Book Hall</a>
                            <a href="/bookings/pooja/new" class="btn btn-sm btn-warning">Book Pooja</a>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>



