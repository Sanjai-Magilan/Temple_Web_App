<%- include('../partials/header') %>
    <%- include('../partials/navbar', { user: typeof user !=='undefined' ? user : null }) %>

        <!-- Standard Admin Layout to Match Other Pages -->
        <div class="container mt-4 mb-5">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-center mb-4">
                <div>
                    <h2><i class="bi bi-shield-lock me-2"></i>Admin Donation View</h2>
                    <p class="text-muted">Manage and view all temple donations</p>
                </div>
                <a href="/admin" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i> Back to Dashboard
                </a>
            </div>

            <!-- Search Section -->
            <div class="card mb-4 shadow-sm border-0">
                <div class="card-body bg-light rounded">
                    <div class="row">
                        <div class="col-md-8 mx-auto">
                            <form action="/admin/donations" method="GET" class="d-flex gap-2">
                                <div class="input-group">
                                    <span class="input-group-text bg-white border-end-0"><i
                                            class="bi bi-search text-muted"></i></span>
                                    <input type="text" class="form-control form-control-lg border-start-0 ps-0"
                                        name="search" placeholder="Search by receipt number, donor name, or email..."
                                        value="<%= search || '' %>">
                                </div>
                                <button type="submit" class="btn btn-primary btn-lg">Search</button>
                                <% if (search) { %>
                                    <a href="/admin/donations" class="btn btn-outline-secondary btn-lg">Clear</a>
                                    <% } %>
                            </form>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Donations Table -->
            <div class="card shadow-sm border-0">
                <div class="card-body p-0">
                    <% if (typeof donations !=='undefined' && donations.length> 0) { %>
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="bg-light">
                                    <tr>
                                        <th class="ps-4">Receipt</th>
                                        <th>Donor</th>
                                        <th>Amount</th>
                                        <th>Type</th>
                                        <th>Status</th>
                                        <th>Date</th>
                                        <th class="pe-4">Payment Method</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% donations.forEach(donation=> { %>
                                        <tr>
                                            <td class="ps-4">
                                                <span class="font-monospace text-primary">
                                                    <%= donation.receipt_number || 'N/A' %>
                                                </span>
                                            </td>
                                            <td>
                                                <% if (donation.first_name) { %>
                                                    <div class="d-flex flex-column">
                                                        <span class="fw-bold text-dark">
                                                            <%= donation.first_name %>
                                                                <%= donation.last_name %>
                                                        </span>
                                                        <small class="text-muted">
                                                            <%= donation.email %>
                                                        </small>
                                                    </div>
                                                    <% } else { %>
                                                        <span class="text-muted fst-italic">Anonymous/Guest</span>
                                                        <% } %>
                                            </td>
                                            <td class="fw-bold">₹<%= donation.amount.toLocaleString() %>
                                            </td>
                                            <td>
                                                <span class="badge rounded-pill bg-light text-dark border">
                                                    <%= donation.donation_type.charAt(0).toUpperCase() +
                                                        donation.donation_type.slice(1) %>
                                                </span>
                                            </td>
                                            <td>
                                                <% let badgeClass='bg-secondary' ; if
                                                    (donation.payment_status==='completed' ) badgeClass='bg-success' ;
                                                    else if (donation.payment_status==='pending' )
                                                    badgeClass='bg-warning text-dark' ; else if
                                                    (donation.payment_status==='failed' ) badgeClass='bg-danger' ; %>
                                                    <span class="badge <%= badgeClass %>">
                                                        <%= (donation.payment_status || 'Pending' ).toUpperCase() %>
                                                    </span>
                                            </td>
                                            <td>
                                                <small class="text-muted">
                                                    <%= new Date(donation.created_at).toLocaleDateString() %>
                                                </small>
                                            </td>
                                            <td class="pe-4">
                                                <small class="text-muted">
                                                    <%= donation.payment_method || '-' %>
                                                </small>
                                            </td>
                                        </tr>
                                        <% }); %>
                                </tbody>
                            </table>
                        </div>

                        <!-- Pagination -->
                        <% if (totalPages> 1) { %>
                            <div class="p-3 border-top">
                                <nav aria-label="Donation navigation">
                                    <ul class="pagination justify-content-center mb-0">
                                        <li class="page-item <%= currentPage === 1 ? 'disabled' : '' %>">
                                            <a class="page-link"
                                                href="/admin/donations?page=<%= currentPage - 1 %>&search=<%= search || '' %>">Previous</a>
                                        </li>
                                        <% for(let i=1; i <=totalPages; i++) { %>
                                            <li class="page-item <%= currentPage === i ? 'active' : '' %>">
                                                <a class="page-link"
                                                    href="/admin/donations?page=<%= i %>&search=<%= search || '' %>">
                                                    <%= i %>
                                                </a>
                                            </li>
                                            <% } %>
                                                <li
                                                    class="page-item <%= currentPage === totalPages ? 'disabled' : '' %>">
                                                    <a class="page-link"
                                                        href="/admin/donations?page=<%= currentPage + 1 %>&search=<%= search || '' %>">Next</a>
                                                </li>
                                    </ul>
                                </nav>
                            </div>
                            <% } %>

                                <% } else { %>
                                    <div class="text-center py-5">
                                        <div class="mb-3">
                                            <i class="bi bi-inbox text-muted" style="font-size: 3rem;"></i>
                                        </div>
                                        <h4>No donations found</h4>
                                        <p class="text-muted">Try adjusting your search criteria or come back later.</p>
                                        <% if (search) { %>
                                            <a href="/admin/donations" class="btn btn-primary mt-2">View All
                                                Donations</a>
                                            <% } %>
                                    </div>
                                    <% } %>
                </div>
            </div>
        </div>

        <%- include('../partials/footer') %>