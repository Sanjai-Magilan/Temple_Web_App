<%- include('../partials/header') %>
    <%- include('../partials/navbar', { user: typeof user !=='undefined' ? user : null }) %>

        <style>
            body {
                background: linear-gradient(rgba(0, 0, 0, 0.6), rgba(0, 0, 0, 0.6)), url('https://images.unsplash.com/photo-1596627706352-78d91c12d4d8?q=80&w=2070&auto=format&fit=crop') no-repeat center center fixed;
                background-size: cover !important;
                min-height: 100vh;
            }

            .nav-pills .nav-link.active {
                background-image: linear-gradient(to right, rgb(245, 158, 11), rgb(249, 115, 22), rgb(217, 119, 6));
                background-color: transparent;
                border: 1px solid transparent;
            }

            .nav-pills .nav-link {
                color: #5d5145;
            }

            .booking-card {
                transition: all 0.3s;
                border-left: 4px solid transparent;
            }

            .booking-card:hover {
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
            }

            .rounded-end-custom {
                border-top-right-radius: 10px !important;
                border-bottom-right-radius: 10px !important;
            }

            .cursor-pointer {
                cursor: pointer;
            }

            /* Pagination Styling to match */
            .page-link {
                color: rgb(120, 53, 15);
                border: 1px solid rgb(229, 231, 235);
                margin: 0 5px;
                border-radius: 5px;
                font-weight: 500;
            }

            .page-link:hover {
                background-color: #f8f9fa;
                color: rgb(120, 53, 15);
            }

            .page-item.active .page-link {
                background-image: linear-gradient(to right, rgb(245, 158, 11), rgb(249, 115, 22), rgb(217, 119, 6));
                background-color: transparent;
                border-color: rgb(229, 231, 235);
                color: white;
            }

            .page-item.disabled .page-link {
                color: #6c757d;
            }

            .donation-search-btn {
                transition: all 0.2s ease;
            }

            .donation-search-btn:hover,
            .donation-search-btn:focus-visible {
                background-image: none !important;
                background-color: #fff !important;
                border-color: rgb(229, 231, 235) !important;
                color: rgb(120, 53, 15) !important;
                box-shadow: none !important;
            }
        </style>

        <div class="container py-5">

            <!-- PAGE TITLE -->
            <div class="mb-4 d-flex align-items-center gap-3">

                <!-- Back Arrow -->
                <a href="/admin"
                class="btn btn-light border shadow-sm d-flex align-items-center justify-content-center"
                style="width:40px;height:40px;">

                    <i class="bi bi-arrow-left"></i>

                </a>

                <!-- Title -->
                <h2 class="mb-0" 
                    style="font-family: 'Playfair Display', serif; color: rgb(120, 53, 15);">
                    View Donations
                </h2>

            </div>

            <!-- Search Section -->
            <div class="card shadow-sm border-0 mb-4" style="border-radius: 15px;">
                <div class="card-body p-4 bg-white">
                    <form id="donation-search-form" class="row g-3 align-items-center" onsubmit="return false;">
                        <input type="hidden" name="type" id="donationTypeInput"
                            value="<%= typeof donationType !== 'undefined' ? donationType : '' %>">

                        <div class="col-md-10">
                            <div class="input-group input-group-lg">
                                <span class="input-group-text bg-transparent border-end-0"
                                    style="border-top-left-radius: 10px; border-bottom-left-radius: 10px;">
                                    <i class="bi bi-search text-muted"></i>
                                </span>
                                <input type="text" name="search" id="donationSearchInput"
                                    class="form-control border-start-0 border-end-0 shadow-none"
                                    style="border-right: none !important;"
                                    placeholder="Search by Receipt, Donor Name, or Email..." value="<%= search || '' %>"
                                    onkeydown="handleEnter(event)">

                                <!-- Filter Dropdown -->
                                <div id="donationFilterContainer"
                                    class="input-group-text bg-transparent border-start-0 <%= (search) ? 'border-end-0' : 'rounded-end-custom' %> p-0"
                                    style="border-left: none !important;">
                                    <div class="dropdown">
                                        <button class="btn btn-link text-decoration-none text-muted p-2" type="button"
                                            data-bs-toggle="dropdown" aria-expanded="false">
                                            <i class="bi bi-funnel<%= donationType ? '-fill text-primary' : '' %>"></i>
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end">
                                            <li><button class="dropdown-item <%= !donationType ? 'active' : '' %>"
                                                    type="button" onclick="applyFilter('')">All Types</button></li>
                                            <li><button
                                                    class="dropdown-item <%= donationType === 'general' ? 'active' : '' %>"
                                                    type="button" onclick="applyFilter('general')">General
                                                    Donation</button></li>
                                            <li><button
                                                    class="dropdown-item <%= donationType === 'construction' ? 'active' : '' %>"
                                                    type="button" onclick="applyFilter('construction')">Construction
                                                    Fund</button></li>
                                            <li><button
                                                    class="dropdown-item <%= donationType === 'maintenance' ? 'active' : '' %>"
                                                    type="button"
                                                    onclick="applyFilter('maintenance')">Maintenance</button></li>
                                            <li><button
                                                    class="dropdown-item <%= donationType === 'festival' ? 'active' : '' %>"
                                                    type="button" onclick="applyFilter('festival')">Festival
                                                    Fund</button></li>
                                            <li><button
                                                    class="dropdown-item <%= donationType === 'specific_pooja' ? 'active' : '' %>"
                                                    type="button" onclick="applyFilter('specific_pooja')">Specific
                                                    Pooja</button></li>
                                            <li><button
                                                    class="dropdown-item <%= donationType === 'other' ? 'active' : '' %>"
                                                    type="button" onclick="applyFilter('other')">Other</button></li>
                                        </ul>
                                    </div>
                                </div>

                                <a href="#" onclick="return clearSearch(event)" id="donationClearSearch"
                                    class="input-group-text bg-transparent border-start-0 text-decoration-none rounded-end-custom cursor-pointer <%= search ? '' : 'd-none' %>">
                                    <i class="bi bi-x-circle-fill text-danger"></i>
                                </a>
                            </div>
                        </div>
                        <div class="col-md-2">
                            <button type="button" onclick="submitSearch(event)" class="btn btn-primary w-100 btn-lg donation-search-btn"
                                style="background-image: linear-gradient(to right, rgb(245, 158, 11), rgb(249, 115, 22), rgb(217, 119, 6)); background-color: transparent; border: 1px solid transparent; border-radius: 10px; color: white;">
                                Search
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Donations List -->
            <% if (typeof donations !=='undefined' && donations.length> 0) { %>
                <div class="table-responsive bg-white rounded shadow-sm p-3">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">Receipt</th>
                                <th>Donor Details</th>
                                <th>Amount</th>
                                <th>Type</th>
                                <th>Status</th>
                                <th>Date</th>
                                <th class="pe-4">Method</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% donations.forEach(donation=> { %>
                                <tr>
                                    <td class="ps-4">
                                        <span class="font-monospace text-primary fw-bold">
                                            <%= donation.receipt_number || 'N/A' %>
                                        </span>
                                    </td>
                                    <td>
                                        <% if (donation.first_name) { %>
                                            <div class="fw-bold text-dark">
                                                <%= donation.first_name %>
                                                    <%= donation.last_name %>
                                            </div>
                                            <div class="small text-muted">
                                                <%= donation.email %>
                                            </div>
                                            <% } else { %>
                                                <span class="text-muted fst-italic">Anonymous Guest</span>
                                                <% } %>
                                    </td>
                                    <td>
                                        <div class="fw-bold text-dark">₹<%= donation.amount.toLocaleString() %>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge rounded-pill bg-light text-dark border">
                                            <%= donation.donation_type ? (donation.donation_type.charAt(0).toUpperCase()
                                                + donation.donation_type.slice(1).replace('_', ' ' )) : 'General' %>
                                        </span>
                                    </td>
                                    <td>
                                        <% let badgeClass='bg-secondary' ; if (donation.payment_status==='completed' )
                                            badgeClass='bg-success' ; else if (donation.payment_status==='pending' )
                                            badgeClass='bg-warning text-dark' ; else if
                                            (donation.payment_status==='failed' ) badgeClass='bg-danger' ; %>
                                            <span class="badge <%= badgeClass %> rounded-pill">
                                                <%= (donation.payment_status || 'Pending' ).toUpperCase() %>
                                            </span>
                                    </td>
                                    <td>
                                        <div class="small text-muted">
                                            <i class="bi bi-calendar3 me-1"></i>
                                            <%= new Date(donation.created_at).toLocaleDateString() %>
                                        </div>
                                    </td>
                                    <td class="pe-4">
                                        <small class="text-muted">
                                            <%= donation.payment_method || '-' %>
                                        </small>
                                    </td>
                                </tr>
                                <% }); %>
                        </tbody>
                    </table>
                </div>

                <!-- Pagination -->
                <% if (totalPages> 1) { %>
                    <nav aria-label="Donation navigation" class="mt-4">
                        <ul class="pagination justify-content-center">
                            <li class="page-item <%= currentPage === 1 ? 'disabled' : '' %>">
                                <a class="page-link"
                                    href="/admin/donations?page=<%= currentPage - 1 %>&search=<%= search || '' %>&type=<%= typeof donationType !== 'undefined' ? donationType : '' %>"
                                    aria-label="Previous">
                                    <span aria-hidden="true">&laquo;</span>
                                </a>
                            </li>
                            <% for(let i=1; i <=totalPages; i++) { %>
                                <li class="page-item <%= currentPage === i ? 'active' : '' %>">
                                    <a class="page-link"
                                        href="/admin/donations?page=<%= i %>&search=<%= search || '' %>&type=<%= typeof donationType !== 'undefined' ? donationType : '' %>">
                                        <%= i %>
                                    </a>
                                </li>
                                <% } %>
                                    <li class="page-item <%= currentPage === totalPages ? 'disabled' : '' %>">
                                        <a class="page-link"
                                            href="/admin/donations?page=<%= currentPage + 1 %>&search=<%= search || '' %>&type=<%= typeof donationType !== 'undefined' ? donationType : '' %>"
                                            aria-label="Next">
                                            <span aria-hidden="true">&raquo;</span>
                                        </a>
                                    </li>
                        </ul>
                    </nav>
                    <% } %>

                        <% } else { %>
                            <div class="text-center py-5">
                                <div class="mb-3">
                                    <i class="bi bi-inbox text-muted" style="font-size: 3rem;"></i>
                                </div>
                                <h4 class="text-muted" style="font-family: 'Playfair Display', serif;">No donations
                                    found</h4>
                                <p class="text-muted">Try adjusting your search criteria.</p>
                                <% if (search || (typeof donationType !=='undefined' && donationType)) { %>
                                    <a href="/admin/donations" class="btn btn-primary mt-2"
                                        style="background-color: #bfa15f; border-color: #bfa15f;">
                                        Clear Search & Filters
                                    </a>
                                    <% } %>
                            </div>
                            <% } %>
        </div>

        <%- include('../partials/footer') %>

            <script>
                function applyFilter(type) {
                    const urlParams = new URLSearchParams(window.location.search);
                    if (type) {
                        urlParams.set('type', type);
                    } else {
                        urlParams.delete('type');
                    }
                    urlParams.set('page', 1);
                    window.location.href = `/admin/donations?${urlParams.toString()}`;
                }

                function submitSearch(event) {
                    if (event) event.preventDefault();
                    const searchVal = document.getElementById('donationSearchInput').value;
                    const urlParams = new URLSearchParams(window.location.search);

                    if (searchVal) {
                        urlParams.set('search', searchVal);
                    } else {
                        urlParams.delete('search');
                    }
                    urlParams.set('page', 1);
                    window.location.href = `/admin/donations?${urlParams.toString()}`;
                }

                function clearSearch(event) {
                    if (event) event.preventDefault();
                    document.getElementById('donationSearchInput').value = '';
                    const urlParams = new URLSearchParams(window.location.search);
                    urlParams.delete('search');
                    urlParams.set('page', 1);
                    window.location.href = `/admin/donations?${urlParams.toString()}`;
                }

                function handleEnter(event) {
                    if (event.key === 'Enter') {
                        event.preventDefault();
                        submitSearch(event);
                    }
                }
            </script>