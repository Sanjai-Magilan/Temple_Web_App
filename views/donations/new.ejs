@<%- include('../partials/header') %>
<%- include('../partials/navbar', { user: typeof user !== 'undefined' ? user : null }) %>

<div class="container mt-4 mb-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0"><i class="bi bi-heart"></i> Make a Donation</h4>
                </div>
                <div class="card-body p-4">
                    <% if (typeof error !== 'undefined' && error) { %>
                        <div class="alert alert-danger" role="alert">
                            <%= error %>
                        </div>
                    <% } %>

                    <form id="donationForm">
                        <div class="mb-3">
                            <label for="amount" class="form-label">Donation Amount (₹) *</label>
                            <input type="number" class="form-control" id="amount" name="amount" 
                                   min="1" step="1" required>
                            <small class="form-text text-muted">Minimum amount: ₹1</small>
                        </div>

                        <div class="mb-3">
                            <label for="donation_type" class="form-label">Donation Type *</label>
                            <select class="form-select" id="donation_type" name="donation_type" required>
                                <option value="">Select type</option>
                                <option value="general">General Donation</option>
                                <option value="construction">Construction Fund</option>
                                <option value="maintenance">Maintenance</option>
                                <option value="festival">Festival Fund</option>
                                <option value="specific_pooja">Specific Pooja</option>
                                <option value="other">Other</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label for="purpose" class="form-label">Purpose/Note (Optional)</label>
                            <textarea class="form-control" id="purpose" name="purpose" rows="3" 
                                      placeholder="Any specific purpose or note for your donation..."></textarea>
                        </div>

                        <div class="mb-3 form-check">
                            <input type="checkbox" class="form-check-input" id="is_anonymous" name="is_anonymous">
                            <label class="form-check-label" for="is_anonymous">
                                Make this donation anonymous
                            </label>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary btn-lg" id="submitBtn">
                                <i class="bi bi-credit-card"></i> Proceed to Payment
                            </button>
                            <a href="/donations" class="btn btn-outline-secondary">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
document.getElementById('donationForm').addEventListener('submit', async function(e) {
    e.preventDefault();
    
    const submitBtn = document.getElementById('submitBtn');
    const originalText = submitBtn.innerHTML;
    submitBtn.disabled = true;
    submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Processing...';
    
    const formData = {
        amount: document.getElementById('amount').value,
        donation_type: document.getElementById('donation_type').value,
        purpose: document.getElementById('purpose').value,
        is_anonymous: document.getElementById('is_anonymous').checked
    };
    
    try {
        await initiatePayment('donation', formData, {
            onSuccess: (result) => {
                window.location.href = '/payment/success?payment_id=' + result.payment_id;
            },
            onFailure: (error) => {
                alert('Payment failed: ' + error.message);
                submitBtn.disabled = false;
                submitBtn.innerHTML = originalText;
            }
        });
    } catch (error) {
        alert('Error: ' + error.message);
        submitBtn.disabled = false;
        submitBtn.innerHTML = originalText;
    }
});
</script>

<%- include('../partials/footer') %>



