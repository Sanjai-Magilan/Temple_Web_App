<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' ? title : 'Server Error' %></title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;700&family=Playfair+Display:wght@400;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <style>
        :root {
            --bg-base: #f9f8f6;
            --surface-primary: #f3eee9;
            --surface-secondary: #e3dbd2;
            --accent: #c9b59c;
            --text-main: #5e5a55;
            --heading-dark: #4b463f;
        }

        * {
            box-sizing: border-box;
        }

        html,
        body {
            margin: 0;
            min-height: 100%;
        }

        body {
            font-family: 'Outfit', sans-serif;
            background:
                radial-gradient(circle at top, rgba(201, 181, 156, 0.24), transparent 32%),
                linear-gradient(180deg, var(--bg-base) 0%, var(--surface-primary) 100%);
            color: var(--text-main);
        }

        .error-page {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 3rem 1rem;
        }

        .error-card {
            width: 100%;
            max-width: 760px;
            border: 1px solid rgba(201, 181, 156, 0.45);
            border-radius: 1.5rem;
            background: rgba(255, 255, 255, 0.86);
            backdrop-filter: blur(10px);
            box-shadow: 0 24px 60px rgba(75, 70, 63, 0.12);
        }

        .error-badge {
            width: 88px;
            height: 88px;
            border-radius: 50%;
            margin: 0 auto 1.25rem;
            display: grid;
            place-items: center;
            background: linear-gradient(135deg, #e9dfd1, #d7c4ad);
            color: var(--heading-dark);
            font-size: 2rem;
        }

        .error-code {
            font-family: 'Playfair Display', serif;
            font-size: clamp(4rem, 12vw, 7rem);
            line-height: 1;
            color: var(--heading-dark);
            margin-bottom: 0.75rem;
        }

        .error-title {
            font-family: 'Playfair Display', serif;
            color: var(--heading-dark);
        }

        .error-text {
            color: var(--text-main);
            max-width: 32rem;
            margin: 0 auto;
        }

        .btn-temple {
            background: var(--heading-dark);
            color: #fff;
            border: 1px solid var(--heading-dark);
            border-radius: 999px;
            padding: 0.8rem 1.4rem;
            font-weight: 600;
            transition: all 0.25s ease;
        }

        .btn-temple:hover {
            background: #ffffff;
            color: var(--heading-dark);
            transform: translateY(-1px);
        }

        .btn-soft {
            background: transparent;
            color: var(--heading-dark);
            border: 1px solid rgba(75, 70, 63, 0.18);
            border-radius: 999px;
            padding: 0.8rem 1.4rem;
            font-weight: 600;
        }

        .btn-soft:hover {
            background: rgba(75, 70, 63, 0.06);
            color: var(--heading-dark);
        }
    </style>
</head>

<body>
    <% const pageTitle = typeof title !== 'undefined' ? title : 'Server Error'; %>
    <% const pageMessage = typeof message !== 'undefined' ? message : 'Something went wrong on the server. Please try again later.'; %>

    <main class="error-page">
        <div class="container">
            <div class="error-card p-4 p-md-5 text-center mx-auto">
                <div class="error-badge">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                </div>

                <div class="error-code">500</div>
                <h1 class="error-title h3 mb-3"><%= pageTitle %></h1>
                <p class="error-text lead mb-4"><%= pageMessage %></p>

                <div class="d-flex flex-column flex-sm-row gap-3 justify-content-center">
                    <a href="/" class="btn btn-temple btn-lg">Go to Home</a>
                    <a href="/dashboard" class="btn btn-soft btn-lg">Go to Dashboard</a>
                </div>
            </div>
        </div>
    </main>
</body>

</html>

