<%- include('../partials/header') %>
<%- include('../partials/navbar', { user: typeof user !== 'undefined' ? user : null }) %>
<%- include('./partials/theme') %>
<div class="family-theme">
    <div class="container mt-4 mb-5">
        <div class="row justify-content-center">
            <div class="col-12 col-md-10 col-lg-8">
                <div class="card shadow">
                    <div class="card-header bg-primary text-white">
                        <h4 class="mb-0"><i class="bi bi-person-plus"></i> Add Family Member</h4>
                    </div>
                    <div class="card-body p-4">
                        <% if (typeof error !== 'undefined' && error) { %>
                            <div class="alert alert-danger" role="alert">
                                <i class="bi bi-exclamation-triangle"></i> <%= error %>
                            </div>
                        <% } %>

                    <form action="/family/member/add" method="POST" id="addMemberForm">
                        <div class="row">
                            <div class="col-12 col-md-8 mb-3">
                                <label for="member_name" class="form-label">Full Name *</label>
                                <input type="text" class="form-control" id="member_name" name="member_name" 
                                       value="<%= typeof formData !== 'undefined' && formData.member_name ? formData.member_name : '' %>" 
                                       required placeholder="Enter full name">
                        </div>
                                <div class="col-12 col-md-4 mb-3">
                                <label for="relationship" class="form-label">Relationship *</label>
                                <select class="form-select" id="relationship" name="relationship" required>
                                    <option value="">Select relationship</option>
                                    <option value="spouse" <%= typeof formData !== 'undefined' && formData.relationship === 'spouse' ? 'selected' : '' %>>Spouse</option>
                                    <option value="child" <%= typeof formData !== 'undefined' && formData.relationship === 'child' ? 'selected' : '' %>>Child</option>
                                    <option value="parent" <%= typeof formData !== 'undefined' && formData.relationship === 'parent' ? 'selected' : '' %>>Parent</option>
                                    <option value="sibling" <%= typeof formData !== 'undefined' && formData.relationship === 'sibling' ? 'selected' : '' %>>Sibling</option>
                                    <option value="grandparent" <%= typeof formData !== 'undefined' && formData.relationship === 'grandparent' ? 'selected' : '' %>>Grandparent</option>
                                    <option value="grandchild" <%= typeof formData !== 'undefined' && formData.relationship === 'grandchild' ? 'selected' : '' %>>Grandchild</option>
                                    <option value="other" <%= typeof formData !== 'undefined' && formData.relationship === 'other' ? 'selected' : '' %>>Other</option>
                                </select>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-12 col-md-6 mb-3">
                                <label for="email" class="form-label">Email</label>
                                <input type="email" class="form-control" id="email" name="email" 
                                       value="<%= typeof formData !== 'undefined' && formData.email ? formData.email : '' %>" 
                                       placeholder="email@example.com">
                            </div>
                            <div class="col-12 col-md-6 mb-3">
                                <label for="mobile" class="form-label">Mobile Number</label>
                                <input type="tel" class="form-control" id="mobile" name="mobile" 
                                       value="<%= typeof formData !== 'undefined' && formData.mobile ? formData.mobile : '' %>" 
                                       pattern="[6-9]\d{9}" maxlength="10" placeholder="10-digit mobile number">
                                <small class="form-text text-muted">10-digit Indian mobile number</small>
                            </div>
                        </div>

                            <div class="mb-3">
                                <label for="address" class="form-label">Address</label>
                                <textarea class="form-control" id="address" name="address" rows="2" 
                                          placeholder="Enter address"><%= typeof formData !== 'undefined' && formData.address ? formData.address : '' %></textarea>
                            </div>

                            <div class="row">
                                <div class="col-12 col-md-6 mb-3">
                                    <label for="occupation" class="form-label">Occupation</label>
                                    <input type="text" class="form-control" id="occupation" name="occupation" 
                                           value="<%= typeof formData !== 'undefined' && formData.occupation ? formData.occupation : '' %>" 
                                           placeholder="e.g., Student, Engineer, Homemaker">
                                </div>
                                <div class="col-12 col-md-3 mb-3">
                                    <label for="age" class="form-label">Age</label>
                                    <input type="number" class="form-control" id="age" name="age" 
                                           value="<%= typeof formData !== 'undefined' && formData.age ? formData.age : '' %>" 
                                           min="0" max="150" placeholder="Age">
                                </div>
                                <div class="col-12 col-md-3 mb-3">
                                    <label for="date_of_birth" class="form-label">Date of Birth</label>
                                    <input type="date" class="form-control" id="date_of_birth" name="date_of_birth" 
                                           value="<%= typeof formData !== 'undefined' && formData.date_of_birth ? formData.date_of_birth : '' %>">
                                </div>
                            </div>

                            <hr class="my-4">

                            <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                                <a href="/family" class="btn btn-outline-secondary me-md-2">
                                    <i class="bi bi-x-lg"></i> Cancel
                                </a>
                                <button type="submit" class="btn btn-primary">
                                    <i class="bi bi-person-plus"></i> Add Member
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>


 include('../partials/footer') 

