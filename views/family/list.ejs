<%- include('../partials/header') %>
<%- include('../partials/navbar', { user: typeof user !== 'undefined' ? user : null }) %>

<style>
  :root {
    --donation-gold: #bfa15f;
    --donation-gold-dark: #a88b4d;
    --donation-ink: #2c241b;
    --donation-muted: #8c7b65;
    --donation-card: #fffaf5;
  }

  body {
    background: linear-gradient(rgba(0, 0, 0, 0.6), rgba(0, 0, 0, 0.6)),
      url('https://images.unsplash.com/photo-1596627706352-78d91c12d4d8?q=80&w=2070&auto=format&fit=crop') no-repeat center center fixed;
    background-size: cover !important;
    min-height: 100vh;
  }

  .family-page-shell {
    max-width: 1120px;
    margin: 0 auto;
  }

  .family-page-title {
    font-family: 'Playfair Display', serif;
    font-weight: 700;
    color: #f8f9fa;
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.5);
  }

  .btn-gold {
    background: var(--donation-gold);
    border-color: var(--donation-gold);
    color: #fff;
    font-weight: 600;
    border-radius: 8px;
    padding: 0.6rem 1.2rem;
    transition: all 0.3s ease;
  }

  .btn-gold:hover {
    color: #fff;
    background: var(--donation-gold-dark);
    border-color: var(--donation-gold-dark);
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(168, 139, 77, 0.3);
  }

  .card {
    background: var(--donation-card);
    border: none;
    border-radius: 15px;
    overflow: hidden;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
  }

  .card:hover {
    transform: translateY(-8px);
    box-shadow: 0 15px 30px rgba(0, 0, 0, 0.3) !important;
    z-index: 10;
  }

  .card-header {
    background: linear-gradient(90deg, #bfa15f, #a88b4d) !important;
    color: #fff !important;
    border-bottom: none;
  }

  .card-header .text-muted {
    color: rgba(255, 255, 255, 0.86) !important;
  }

  .setup-empty-card {
    background: var(--donation-card);
    border: 1px solid rgba(191, 161, 95, 0.22);
    border-radius: 22px;
    box-shadow: 0 20px 38px rgba(44, 36, 27, 0.14);
    width: 100%;
    max-width: 560px;
    min-height: 313px;
    margin: 0 auto;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .setup-empty-header {
    background: linear-gradient(135deg,  );
    color: #fff;
    text-align: center;
    padding: 1.4rem 1.2rem;
  }

  .setup-empty-title {
    margin: 0;
    font-family: 'Playfair Display', serif;
    font-size: 1.55rem;
  }

  .setup-empty-body {
    text-align: center;
    padding: 2rem 2rem 2.2rem;
  }

  .setup-empty-subtitle {
    color: #6b5b4d;
    margin: 0.85rem auto 1.4rem;
    max-width: 420px;
  }

  .setup-empty-icon {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(191, 161, 95, 0.16);
    color: var(--donation-gold-dark);
    font-size: 1.5rem;
  }

  .family-members-compact .card-header {
    padding: 0.6rem 0.85rem;
    font-size: 0.92rem;
  }

  .family-members-compact .card-body {
    padding: 0.75rem 0.85rem;
    font-size: 0.92rem;
    line-height: 1.45;
  }

  .members-table-compact th,
  .members-table-compact td {
    padding: 0.5rem 0.6rem;
    font-size: 0.9rem;
    vertical-align: middle;
    border-bottom-color: rgba(191, 161, 95, 0.2);
  }

  .members-table-compact thead th {
    background: rgba(191, 161, 95, 0.1);
    color: #4b4135;
  }

  .members-table-compact .badge {
    font-size: 0.74rem;
    padding: 0.35em 0.55em;
  }

  .members-table-compact .btn-group-sm > .btn,
  .members-table-compact .btn-sm {
    padding: 0.25rem 0.4rem;
    font-size: 0.78rem;
  }

  .alert {
    border: none;
    border-radius: 12px;
  }

  .alert-info {
    background: #f7f0e2;
    color: #3f352b;
  }

  .alert-success {
    background: #e8f5e9;
    color: #214f31;
  }

  .alert-danger {
    background: #fdeaea;
    color: #842029;
  }

  .modal-content {
    background: var(--donation-card);
    border-radius: 20px;
    border: 1px solid rgba(212, 175, 55, 0.2);
  }

  .modal-header {
    border-bottom: none;
  }

  .modal-footer {
    border-top: 1px solid rgba(191, 161, 95, 0.2);
  }

  @media (max-width: 767.98px) {
    .family-members-compact .card-body,
    .family-members-compact .card-header,
    .members-table-compact th,
    .members-table-compact td {
      font-size: 0.86rem;
    }
  }
</style>

<div class="container mt-4 mb-5">
  <div class="row family-page-shell">
    <div class="col-12">
      <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
        <h2 class="mb-0 family-page-title"><i class="bi bi-people"></i> Family</h2>
        <div class="d-flex gap-2">
          <a href="/family/setup" class="btn btn-gold shadow-sm">
           Setup / Update Family
          </a>
        </div>
      </div>

      <% if (typeof message !== 'undefined' && message) { %>
        <div class="alert alert-info" role="alert">
          <i class="bi bi-info-circle"></i> <%= message %>
        </div>
      <% } %>

      <% if (success && success.length) { %>
        <div class="alert alert-success" role="alert">
          <i class="bi bi-check-circle"></i> <%= success[0] %>
        </div>
      <% } %>

      <% if (error && error.length) { %>
        <div class="alert alert-danger" role="alert">
          <i class="bi bi-exclamation-triangle"></i> <%= error[0] %>
        </div>
      <% } %>

      <% if (family) { %>
        <%
          const memberNameById = {};
          members.forEach((m) => { memberNameById[m.id] = m.member_name; });

          function relationBadge(relationship) {
            if (relationship === "head") return "primary";
            if (relationship === "spouse") return "success";
            if (relationship === "child") return "info";
            if (relationship === "parent") return "warning";
            return "secondary";
          }

          function nameById(id) {
            if (!id) return "-";
            return memberNameById[id] || ("#" + id);
          }
        %>

        <div class="card mb-4">
          <div class="card-header bg-primary text-white">
            <h5 class="mb-0">
              <i class="bi bi-house-heart"></i> <%= family.family_name %>
            </h5>
          </div>
          <div class="card-body">
            <div class="row g-3">
              <div class="col-md-4">
                <p class="mb-1"><strong>Family ID:</strong> <%= family.family_uid || "-" %></p>
                <p class="mb-1"><strong>City:</strong> <%= family.city || "Not provided" %></p>
              </div>
              <div class="col-md-4">
                <p class="mb-1"><strong>State:</strong> <%= family.state || "Not provided" %></p>
                <p class="mb-1"><strong>Pincode:</strong> <%= family.pincode || "Not provided" %></p>
              </div>
              <div class="col-md-4">
                <p class="mb-1"><strong>Address:</strong> <%= family.address || "Not provided" %></p>
              </div>
            </div>
          </div>
        </div>

        <% if (myFamilyView) { %>
          <div class="row g-2 mb-4 family-members-compact">
            <div class="col-md-3">
              <div class="card h-100">
                <div class="card-header">Parents</div>
                <div class="card-body">
                  <div><strong>Father:</strong> <%= myFamilyView.parents && myFamilyView.parents.father ? myFamilyView.parents.father.member_name : "-" %></div>
                  <div><strong>Mother:</strong> <%= myFamilyView.parents && myFamilyView.parents.mother ? myFamilyView.parents.mother.member_name : "-" %></div>
                </div>
              </div>
            </div>
            <div class="col-md-3">
              <div class="card h-100">
                <div class="card-header">Siblings</div>
                <div class="card-body">
                  <% if (!myFamilyView.siblings || myFamilyView.siblings.length === 0) { %>
                    <span>-</span>
                  <% } else { %>
                    <% myFamilyView.siblings.forEach((s) => { %>
                      <div><%= s.member_name %></div>
                    <% }) %>
                  <% } %>
                </div>
              </div>
            </div>
            <div class="col-md-3">
              <div class="card h-100">
                <div class="card-header">Spouse</div>
                <div class="card-body">
                  <%= myFamilyView.spouse ? myFamilyView.spouse.member_name : "-" %>
                </div>
              </div>
            </div>
            <div class="col-md-3">
              <div class="card h-100">
                <div class="card-header">Children</div>
                <div class="card-body">
                  <% if (!myFamilyView.children || myFamilyView.children.length === 0) { %>
                    <span>-</span>
                  <% } else { %>
                    <% myFamilyView.children.forEach((c) => { %>
                      <div><%= c.member_name %></div>
                    <% }) %>
                  <% } %>
                </div>
              </div>
            </div>
          </div>
        <% } %>

        <div class="card">
          <div class="card-header">
            <h5 class="mb-0"><i class="bi bi-person-lines-fill"></i> Members (<%= members.length %>)</h5>
          </div>
          <div class="card-body p-0">
            <% if (members.length > 0) { %>
              <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle members-table-compact">
                  <thead class="table-light">
                    <tr>
                      <th>Name</th>
                      <th>Relationship</th>
                      <th>Gender</th>
                      <th>Parents</th>
                      <th>Spouse</th>
                      <th>Mobile</th>
                      <th class="text-center">Actions</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% members.forEach((member) => { %>
                      <tr>
                        <td>
                          <strong><%= member.member_name %></strong>
                          <% if (member.relationship === "head") { %>
                            <span class="badge bg-primary ms-1">Head</span>
                          <% } %>
                        </td>
                        <td>
                          <span class="badge bg-<%= relationBadge(member.relationship) %>">
                            <%= member.relationship ? member.relationship.charAt(0).toUpperCase() + member.relationship.slice(1) : "-" %>
                          </span>
                        </td>
                        <td><%= member.gender || "-" %></td>
                        <td>
                          <div><small>F: <%= nameById(member.father_member_id) %></small></div>
                          <div><small>M: <%= nameById(member.mother_member_id) %></small></div>
                        </td>
                        <td><%= nameById(member.spouse_member_id) %></td>
                        <td><%= member.mobile || "-" %></td>
                        <td class="text-center">
                          <div class="btn-group btn-group-sm">
                            <a href="/family?memberId=<%= member.id %>" class="btn btn-outline-secondary" title="Center Tree">
                              <i class="bi bi-bullseye"></i>
                            </a>
                            <a href="/family/member/<%= member.id %>" class="btn btn-outline-info" title="View">
                              <i class="bi bi-eye"></i>
                            </a>
                            <% if (isHead) { %>
                              <a href="/family/member/<%= member.id %>/edit" class="btn btn-outline-primary" title="Edit">
                                <i class="bi bi-pencil"></i>
                              </a>
                              <% if (member.relationship !== "head") { %>
                                <button
                                  type="button"
                                  class="btn btn-outline-danger delete-member-btn"
                                  title="Delete"
                                  data-id="<%= member.id %>"
                                  data-name="<%= member.member_name %>"
                                >
                                  <i class="bi bi-trash"></i>
                                </button>
                              <% } %>
                            <% } %>
                          </div>
                        </td>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>
            <% } else { %>
              <div class="text-center py-5">
                <i class="bi bi-people text-muted" style="font-size: 3rem;"></i>
                <p class="text-muted mt-3">No family members found.</p>
              </div>
            <% } %>
          </div>
        </div>
      <% } else { %>
        <div class="setup-empty-card">
          <div class="setup-empty-header">
            
          </div>
          
          <div class="setup-empty-body">
            <div class="setup-empty-icon"><i class="bi bi-house-heart"></i></div>
            <h5 class="mt-2 mb-1">No Family Found</h5>
            <p class="setup-empty-subtitle">Please complete family setup </p>
            <a href="/family/setup" class="btn btn-gold mt-1">
              Setup Family
            </a>
          </div>
        </div>
      <% } %>
    </div>
  </div>
</div>

<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Confirm Delete</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <p>Are you sure you want to remove <strong id="deleteMemberName"></strong> from the family?</p>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-danger" id="confirmDeleteBtn">Delete</button>
      </div>
    </div>
  </div>
</div>

<script>
  const treeContainer = document.getElementById("treeContainer");
  const initialTreeData = treeContainer && treeContainer.dataset.initialTree
    ? JSON.parse(treeContainer.dataset.initialTree)
    : null;
  let memberIdToDelete = null;

  function createTreeNode(member, label, tone) {
    if (!member) {
      return '<span class="badge text-bg-light border me-2 mb-2">-</span>';
    }

    const badgeClass = tone || "primary";
    return (
      '<button type="button" class="btn btn-sm btn-outline-' + badgeClass + ' me-2 mb-2 tree-node" data-member-id="' + member.id + '">' +
      member.member_name + " (" + label + ")" +
      "</button>"
    );
  }

  function renderTree(tree) {
    const container = document.getElementById("treeContainer");

    if (!tree) {
      container.innerHTML = '<div class="text-muted">No tree data available.</div>';
      return;
    }

    const html =
      '<div class="mb-3">' +
        '<div class="fw-semibold mb-2">Level 1: Parents</div>' +
        createTreeNode(tree.parents ? tree.parents.father : null, "Father", "warning") +
        createTreeNode(tree.parents ? tree.parents.mother : null, "Mother", "warning") +
      '</div>' +
      '<div class="mb-3">' +
        '<div class="fw-semibold mb-2">Level 2: Selected Person + Spouse</div>' +
        createTreeNode(tree.selected, "Selected", "primary") +
        createTreeNode(tree.spouse, "Spouse", "success") +
      '</div>' +
      '<div>' +
        '<div class="fw-semibold mb-2">Level 3: Children</div>' +
        (
          tree.children && tree.children.length
            ? tree.children.map(function (child) {
                return createTreeNode(child, "Child", "info");
              }).join("")
            : '<span class="text-muted">No children</span>'
        ) +
      '</div>';

    container.innerHTML = html;

    document.querySelectorAll(".tree-node").forEach(function (btn) {
      btn.addEventListener("click", function () {
        const memberId = this.getAttribute("data-member-id");
        fetch("/family/tree/" + memberId, {
          headers: { "X-Requested-With": "XMLHttpRequest" }
        })
          .then(function (res) { return res.json(); })
          .then(function (data) {
            if (data && data.success) {
              renderTree(data.tree);
            } else {
              alert(data.message || "Unable to load tree.");
            }
          })
          .catch(function () {
            alert("Failed to load tree.");
          });
      });
    });
  }

  document.querySelectorAll(".delete-member-btn").forEach(function (btn) {
    btn.addEventListener("click", function () {
      memberIdToDelete = this.getAttribute("data-id");
      document.getElementById("deleteMemberName").textContent = this.getAttribute("data-name");
      const modal = new bootstrap.Modal(document.getElementById("deleteModal"));
      modal.show();
    });
  });

  document.getElementById("confirmDeleteBtn").addEventListener("click", async function () {
    if (!memberIdToDelete) return;

    try {
      const response = await fetch("/family/member/" + memberIdToDelete, {
        method: "DELETE",
        headers: { "Content-Type": "application/json" }
      });

      const result = await response.json();

      if (result.success) {
        window.location.reload();
      } else {
        alert("Error: " + (result.message || "Failed to delete member."));
      }
    } catch (error) {
      alert("Failed to delete member. Please try again.");
    }

    bootstrap.Modal.getInstance(document.getElementById("deleteModal")).hide();
  });

  renderTree(initialTreeData);
</script>

<%- include('../partials/footer') %>

