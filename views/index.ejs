<%- include('partials/header') %>
<%- include('partials/navbar', { user: typeof user !== 'undefined' ? user : null }) %>

<div class="container mt-4 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-body text-center">
                    <h1 class="card-title mb-4"><%= title %></h1>
                    <p class="lead"><%= message %></p>
                    <% if (typeof user !== 'undefined' && user) { %>
                        <div class="alert alert-success mt-4">
                            <h5>Welcome, <%= user.first_name %>!</h5>
                            <p class="mb-0">You are logged in as <strong><%= user.role %></strong></p>
                            <div class="mt-3">
                                <a href="/dashboard" class="btn btn-primary me-2">Go to Dashboard</a>
                                <% if (user.role === 'admin') { %>
                                    <a href="/admin" class="btn btn-outline-primary">Admin Panel</a>
                                <% } %>
                            </div>
                        </div>
                    <% } else { %>
                        <p class="text-muted mt-4">Please <a href="/login">login</a> or <a href="/register">register</a> to continue.</p>
                        <div class="mt-4">
                            <a href="/login" class="btn btn-primary me-2">Login</a>
                            <a href="/register" class="btn btn-outline-primary">Register</a>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include('partials/footer') %>

