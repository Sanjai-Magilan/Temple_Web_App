<%- include('partials/header') %>
    <%- include('partials/navbar', { user: typeof user !=='undefined' ? user : null }) %>

        <div class="container mt-5 mb-5">
            <div class="row justify-content-center align-items-center" style="min-height: 60vh;">
                <div class="col-md-8 col-lg-6">
                    <div class="card shadow-lg border-0" style="border-radius: 1rem; overflow: hidden;">
                        <div class="card-body text-center p-5" style="background-color: #fff;">
                            <div class="mb-4">
                                <h1 class="display-5 fw-bold mb-3">Temple Management System</h1>
                                <p class="lead text-muted">
                                    Welcome to Temple Management System
                                </p>
                            </div>

                            <% if (typeof user !=='undefined' && user) { %>
                                <div class="alert alert-success mt-4 p-4"
                                    style="background-color: #d1e7dd; border-color: #badbcc; color: #0f5132;">
                                    <h4 class="alert-heading mb-3">Welcome, <%= user.first_name %>!</h4>
                                    <p class="mb-3">You are logged in as <strong>
                                            <%= user.role %>
                                        </strong></p>
                                    <div class="d-grid gap-2 d-sm-flex justify-content-sm-center">
                                        <a href="/dashboard" class="btn btn-primary btn-lg px-4 gap-3">Go to
                                            Dashboard</a>
                                        <% if (user.role==='admin' ) { %>
                                            <a href="/admin" class="btn btn-outline-primary btn-lg px-4">Admin Panel</a>
                                            <% } %>
                                    </div>
                                    <div class="mt-3">
                                        <small class="text-muted">Not you? <a href="/logout"
                                                class="text-decoration-none">Logout</a></small>
                                    </div>
                                </div>
                                <% } else { %>
                                    <div class="d-grid gap-3 col-md-10 mx-auto mt-5">
                                        <a href="/login" class="btn btn-primary btn-lg py-3 shadow-sm">
                                            <i class="bi bi-box-arrow-in-right me-2"></i> Login
                                        </a>
                                        <a href="/register" class="btn btn-outline-primary btn-lg py-3 shadow-sm">
                                            <i class="bi bi-person-plus me-2"></i> Create Account
                                        </a>
                                    </div>
                                    <p class="text-muted mt-4 mb-0 small">
                                        By continuing, you agree to our <a href="#" class="text-decoration-none">Terms
                                            of Service</a> and <a href="#" class="text-decoration-none">Privacy
                                            Policy</a>.
                                    </p>
                                    <% } %>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <%- include('partials/footer') %>