<% const year = new Date().getFullYear(); %>

<footer class="bg-light mt-5 py-4 border-top shadow-sm">
  <div class="container">
    <div class="row align-items-center">
      <div class="col-md-6 text-center text-md-start">
        <p class="mb-0 text-muted small">
          &copy; <%= year %> Temple Management System. All rights reserved.
        </p>
      </div>

      <div class="col-md-6 text-center text-md-end mt-2 mt-md-0">
        <a href="/" class="text-decoration-none text-muted me-2">Home</a>
        <span class="text-muted">|</span>
        <a
          href="#"
          class="text-decoration-none text-muted ms-2"
          data-bs-toggle="modal"
          data-bs-target="#contactModal"
        >
          Contact
        </a>
      </div>
    </div>
  </div>
</footer>

<div class="modal fade" id="contactModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered modal-md">
    <div class="modal-content rounded-4 shadow">
      <div class="modal-header flex-column align-items-center border-0 pb-0">
        <h5 class="fw-bold fs-4 mb-0">Contact Us</h5>
        <hr class="w-100 mt-3 mb-0 opacity-10">
      </div>

      <div class="modal-body px-5 py-4">
        <div
          class="d-flex justify-content-between align-items-center py-3 hover-bg"
        >
          <div class="d-flex align-items-center gap-3">
            <i class="bi bi-envelope-fill text-primary"></i>
            <strong class="text-muted">Email</strong>
          </div>

          <a
            href="https://mail.google.com/mail/?view=cm&fs=1&to=vdeepikaa24@gmail.com"
            target="_blank"
            class="text-primary text-decoration-none"
          >
            vdeepikaa24@gmail.com
          </a>
        </div>

        <div
          class="d-flex justify-content-between align-items-center py-3 hover-bg mt-2"
        >
          <div class="d-flex align-items-center gap-3">
            <i class="bi bi-telephone-fill text-primary"></i>
            <strong class="text-muted">Phone</strong>
          </div>

          <a href="tel:+919876543210" class="text-primary text-decoration-none">
            +91 98765 43210
          </a>
        </div>
      </div>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

<script src="https://checkout.razorpay.com/v1/checkout.js"></script>
<script src="/js/razorpay.js"></script>

