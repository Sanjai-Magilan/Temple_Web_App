<%- include('../partials/header') %>
<%- include('../partials/navbar', { user: user }) %>

<div class="container mt-5">
  <div class="row justify-content-center">
    <div class="col-md-6">

      <style>
        .profile-action-btn {
          background: linear-gradient(to right, rgb(245, 158, 11), rgb(249, 115, 22), rgb(217, 119, 6));
          color: #fff;
          border: 1px solid transparent;
          border-radius: 14px;
          box-shadow: 0 14px 28px rgba(217, 119, 6, 0.18);
          transition: all 0.2s ease-in-out;
        }

        .profile-action-btn:hover,
        .profile-action-btn:focus-visible,
        .profile-action-btn:active {
          color: #fff !important;
          border-color: rgb(123, 53, 15) !important;
          box-shadow: 0 14px 28px rgba(217, 119, 6, 0.22);
          transform: translateY(-1px);
          outline: none;
        }

        .profile-action-btn.btn-sm {
          padding: 0.35rem 0.8rem;
        }
      </style>

      <div class="card shadow rounded-3 overflow-hidden">

        <!-- Header -->
        <div 
          class="card-header text-white d-flex justify-content-between align-items-center"
          style="background:  linear-gradient(to right, rgb(245, 158, 11), rgb(249, 115, 22), rgb(217, 119, 6));"
        >
          <h5 class="mb-0">
            <i class="bi bi-person-circle"></i> My Profile
          </h5>

          <button 
            id="editBtn" 
            class="btn btn-light btn-sm"
            style="transition: all 0.2s ease-in-out;"
            onmouseover="this.style.color='#d1b570'"
            onmouseout="this.style.color=''"
          >
            <i class="bi bi-pencil"></i> Edit
          </button>
        </div>

        <!-- Body -->
        <div class="card-body">
          <form action="/profile/update" method="POST" id="profileForm">

            <div class="mb-3">
              <label class="form-label">First Name</label>
              <input type="text" 
                     class="form-control editable"
                     name="first_name" 
                     value="<%= user.first_name %>" 
                     readonly
                     style="background-color:#f8f9fa; cursor:not-allowed;">
            </div>

            <div class="mb-3">
              <label class="form-label">Last Name</label>
              <input type="text" 
                     class="form-control editable"
                     name="last_name" 
                     value="<%= user.last_name %>" 
                     readonly
                     style="background-color:#f8f9fa; cursor:not-allowed;">
            </div>

            <div class="mb-3">
              <label class="form-label">Email</label>
              <input type="email" 
                     class="form-control"
                     value="<%= user.email %>" 
                     readonly
                     style="background-color:#f8f9fa; cursor:not-allowed;">
            </div>

            <div class="mb-3">
              <label class="form-label">Phone</label>
              <input type="text" 
                     class="form-control editable"
                     name="phone" 
                     value="<%= user.phone %>" 
                     readonly
                     style="background-color:#f8f9fa; cursor:not-allowed;">
            </div>

            <!-- Save Section -->
            <div class="text-end d-none" id="saveSection">
              <button type="submit" 
                      class="btn text-white px-4 profile-action-btn">
                <i class="bi bi-save"></i> Save Changes
              </button>
            </div>

          </form>
        </div>

      </div>

    </div>
  </div>
</div>

<script>
  const editBtn = document.getElementById('editBtn');
  const editableFields = document.querySelectorAll('.editable');
  const saveSection = document.getElementById('saveSection');

  editBtn.addEventListener('click', () => {
    editableFields.forEach(field => {
      field.removeAttribute('readonly');
      field.style.backgroundColor = '#ffffff';
      field.style.cursor = 'text';
    });

    saveSection.classList.remove('d-none');
    editBtn.classList.add('d-none');
  });
</script>

<%- include('../partials/footer') %>
